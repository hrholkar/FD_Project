<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('includes/head') %>
  <title>Admin - Student Scores | LearnSmart</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    .legacy-scores-wrap {
      max-width: 1400px;
      margin: 0 auto;
      padding: 1.75rem 2rem 3.5rem 2rem;
    }
  </style>
</head>
<body>

  <%- include('includes/navbar', { currentPage: 'admin' }) %>

  <main class="legacy-scores-wrap">
    <header class="ls-hero-banner ls-yellow-grid" style="margin-bottom: 2rem;">
      <div class="ls-hero-banner-content">
        <div class="ls-sticker orange" style="font-size: 0.75rem; margin-bottom: 8px;">ADMINISTRATIVE LOGS</div>
        <h1 style="font-family: var(--font-heading); font-size: 2.4rem; font-weight: 900; color: var(--ls-black); margin-bottom: 4px;">
          Student Performance Records
        </h1>
        <p style="font-size: 1.05rem; font-weight: 600; color: #2B2B2B;">
          Detailed records of topic assessments across all student profiles.
        </p>
      </div>
      <div>
        <a href="/admin/dashboard" class="btn btn-purple">
          <i class="fas fa-table-cells-large"></i> Admin Hub
        </a>
      </div>
    </header>

    <div class="ls-card" style="margin-bottom: 2rem;">
      <div class="ls-card-header">
        <h3 class="ls-card-title"><i class="fas fa-filter" style="color: var(--ls-purple);"></i> Filter Scores</h3>
      </div>
      <form method="GET" action="/admin/scores">
        <div style="display: flex; gap: 14px; flex-wrap: wrap; align-items: flex-end;">
          <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 200px;">
            <label class="form-label">Subject</label>
            <input type="text" name="topic" class="form-control" placeholder="Filter topic..." value="<%= typeof topic !== 'undefined' ? topic : '' %>" />
          </div>
          <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 200px;">
            <label class="form-label">Student</label>
            <input type="text" name="student" class="form-control" placeholder="Filter username..." value="<%= typeof student !== 'undefined' ? student : '' %>" />
          </div>
          <button type="submit" class="btn btn-purple">Apply</button>
        </div>
      </form>
    </div>

    <div class="ls-card">
      <div class="table-responsive">
        <table class="ls-table">
          <thead>
            <tr>
              <th>Student</th>
              <th>Topic</th>
              <th>Average Score</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (scores && scores.length > 0) { %>
              <% scores.forEach(s => { %>
                <tr>
                  <td style="font-weight: 800;"><%= s.username %></td>
                  <td><%= s.topic %></td>
                  <td><span class="badge badge-purple"><%= s.avgScore %>%</span></td>
                  <td>
                    <a href="/admin/students" class="btn btn-outline btn-sm">Manage</a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" style="text-align: center; color: var(--ls-muted); padding: 2rem;">
                  No score records found.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <%- include('includes/footer') %>

</body>
</html>
