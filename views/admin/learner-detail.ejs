<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../includes/head') %>
    <title><%= learner.username %> | Learner Diagnostics | LearnSmart Admin</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        .admin-learner-wrap {
            max-width: 1400px;
            margin: 0 auto;
            padding: 1.75rem 2rem 3.5rem 2rem;
        }

        @media (max-width: 850px) {
            .admin-learner-wrap {
                padding: 1.25rem 1rem 2.5rem 1rem;
            }
        }

        .learner-grid-2col {
            display: grid;
            grid-template-columns: 1.25fr 1fr;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        @media (max-width: 1050px) {
            .learner-grid-2col {
                grid-template-columns: 1fr;
            }
        }

        .meta-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #FFFFFF;
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-sm);
            padding: 4px 10px;
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--ls-black);
        }

        .recommendation-card {
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-md);
            padding: 1.25rem;
            background: #FFFFFF;
            margin-bottom: 1rem;
            display: flex;
            gap: 14px;
            align-items: flex-start;
        }

        .recommendation-card.critical {
            border-left: 6px solid var(--ls-coral);
            background: #FFF8F7;
        }

        .recommendation-card.info {
            border-left: 6px solid var(--ls-purple);
            background: #FAF8FF;
        }

        .recommendation-card.success {
            border-left: 6px solid var(--ls-green);
            background: #F4FAF6;
        }

        .recommendation-card.neutral {
            border-left: 6px solid var(--ls-black);
            background: #FAFAFA;
        }
    </style>
</head>
<body>

    <%- include('../includes/navbar', { currentPage: 'admin' }) %>

    <main class="admin-learner-wrap">
        <!-- Signature Yellow-Grid Hero Banner -->
        <header class="ls-hero-banner ls-yellow-grid" style="margin-bottom: 2rem;">
            <div class="ls-hero-banner-content" style="max-width: 850px;">
                <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 8px; flex-wrap: wrap;">
                    <span class="badge badge-purple" style="font-size: 0.78rem;">INDIVIDUAL LEARNER DIAGNOSTICS</span>
                    <span class="badge <%= analytics.summary.completedQuizzes > 0 ? 'badge-green' : 'badge-outline' %>" style="font-size: 0.78rem;">
                        <i class="fas <%= analytics.summary.completedQuizzes > 0 ? 'fa-check' : 'fa-hourglass' %>"></i>
                        <%= analytics.summary.completedQuizzes > 0 ? 'Active Learner' : 'No Assessments Yet' %>
                    </span>
                    <% if (institutionalStudent) { %>
                        <span class="badge badge-blue" style="font-size: 0.78rem;" title="Enrolled in institutional registry">
                            <i class="fas fa-university"></i> Institutional Student
                        </span>
                    <% } else { %>
                        <span class="badge badge-outline" style="font-size: 0.78rem;">
                            <i class="fas fa-globe"></i> Independent Learner
                        </span>
                    <% } %>
                </div>

                <h1 style="font-family: var(--font-heading); font-size: 2.35rem; font-weight: 900; color: var(--ls-black); margin-bottom: 6px;">
                    <i class="fas fa-circle-user" style="color: var(--ls-purple); margin-right: 8px;"></i>
                    <%= learner.username %>
                </h1>

                <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 1.25rem;">
                    <span class="meta-pill">
                        <i class="fas fa-envelope" style="color: var(--ls-muted);"></i> <%= learner.email || 'No email on record' %>
                    </span>
                    <span class="meta-pill">
                        <i class="fas fa-graduation-cap" style="color: var(--ls-muted);"></i> <%= learner.educationLevel || 'Undergraduate' %>
                    </span>
                    <span class="meta-pill">
                        <i class="fas fa-calendar-check" style="color: var(--ls-muted);"></i> Joined <%= learner.createdAt ? new Date(learner.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Unknown' %>
                    </span>
                    <% if (institutionalStudent && institutionalStudent.course) { %>
                        <span class="meta-pill">
                            <i class="fas fa-book-bookmark" style="color: var(--ls-blue);"></i> Course: <%= institutionalStudent.course %>
                        </span>
                    <% } %>
                </div>

                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <a href="/admin/dashboard" class="btn btn-outline btn-sm">
                        <i class="fas fa-arrow-left"></i> Admin Hub
                    </a>
                    <a href="/admin/learners/<%= learner._id %>/export-csv" class="btn btn-purple btn-sm">
                        <i class="fas fa-file-csv"></i> Export CSV Report
                    </a>
                    <a href="/admin/scores?student=<%= encodeURIComponent(learner.username) %>" class="btn btn-outline btn-sm">
                        <i class="fas fa-chart-line"></i> View Raw Scores
                    </a>
                    <a href="/admin/students" class="btn btn-outline btn-sm">
                        <i class="fas fa-users-gear"></i> Student Portal
                    </a>
                </div>
            </div>

            <!-- Learner Badge Card -->
            <div class="ls-hero-graphic-wrap" style="position: relative;">
                <div style="position: absolute; top: -14px; right: 0; background: var(--ls-orange); color: #FFFFFF; font-family: var(--font-editorial); font-size: 0.8rem; font-weight: 900; text-transform: uppercase; padding: 4px 10px; border: 2px solid var(--ls-black); border-radius: var(--radius-sm); transform: rotate(3deg); z-index: 3;">
                    LEARNER PROFILE
                </div>

                <div style="width: 220px; height: 150px; border: 2px solid var(--ls-black); border-radius: var(--radius-md); overflow: hidden; background: #FFFFFF; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem; text-align: center;">
                    <div style="width: 60px; height: 60px; border-radius: 50%; background: var(--ls-purple-light); border: 2px solid var(--ls-black); display: flex; align-items: center; justify-content: center; font-size: 1.8rem; color: var(--ls-purple); margin-bottom: 8px;">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                    <strong style="color: var(--ls-black); font-size: 1.05rem;"><%= learner.username %></strong>
                    <span style="font-size: 0.78rem; color: var(--ls-muted);"><%= learner.educationLevel || 'Undergraduate' %></span>
                </div>
            </div>
        </header>

        <!-- 4 KPI Performance Metric Cards -->
        <section class="ls-metric-grid" style="grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); margin-bottom: 2rem;">
            <!-- Card 1: Completed Quizzes -->
            <div class="ls-metric-card">
                <div class="ls-metric-icon blue">
                    <i class="fas fa-circle-check"></i>
                </div>
                <div style="flex: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: baseline;">
                        <span class="ls-metric-value"><%= analytics.summary.completedQuizzes %></span>
                        <span class="badge badge-outline" style="font-size: 0.72rem;">Quizzes</span>
                    </div>
                    <div class="ls-metric-label">Assessments Completed</div>
                </div>
            </div>

            <!-- Card 2: Average Score -->
            <div class="ls-metric-card">
                <div class="ls-metric-icon purple">
                    <i class="fas fa-bullseye"></i>
                </div>
                <div style="flex: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: baseline;">
                        <span class="ls-metric-value"><%= analytics.summary.averageScore %>%</span>
                        <span class="badge badge-outline" style="font-size: 0.72rem;">Accuracy</span>
                    </div>
                    <div class="ls-metric-label">Platform Average Score</div>
                </div>
            </div>

            <!-- Card 3: Highest Score -->
            <div class="ls-metric-card">
                <div class="ls-metric-icon green">
                    <i class="fas fa-trophy"></i>
                </div>
                <div style="flex: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: baseline;">
                        <span class="ls-metric-value"><%= analytics.summary.highestScore %>%</span>
                        <span class="badge badge-outline" style="font-size: 0.72rem;">Personal Best</span>
                    </div>
                    <div class="ls-metric-label">Highest Score Achieved</div>
                </div>
            </div>

            <!-- Card 4: Daily Learning Streak -->
            <div class="ls-metric-card">
                <div class="ls-metric-icon orange">
                    <i class="fas fa-fire"></i>
                </div>
                <div style="flex: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: baseline;">
                        <span class="ls-metric-value"><%= analytics.summary.streak %> <span style="font-size: 1rem; font-weight: 700;">Days</span></span>
                        <span class="badge badge-outline" style="font-size: 0.72rem;">Streak</span>
                    </div>
                    <div class="ls-metric-label">Current Active Streak</div>
                </div>
            </div>
        </section>

        <!-- Primary Charts Row (2-Columns) -->
        <div class="learner-grid-2col">
            <!-- Left Chart: Score Progression Over Time -->
            <section class="ls-card">
                <div class="ls-card-header">
                    <h2 class="ls-card-title">
                        <i class="fas fa-chart-line" style="color: var(--ls-purple);"></i> Score Progression Over Time
                    </h2>
                    <span class="badge badge-outline"><%= analytics.performanceOverTime.length %> Attempts</span>
                </div>
                <div style="height: 280px; position: relative;">
                    <% if (analytics.performanceOverTime.length > 0) { %>
                        <canvas id="scoreProgressionChart"></canvas>
                    <% } else { %>
                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--ls-muted); text-align: center;">
                            <i class="fas fa-chart-line" style="font-size: 2rem; margin-bottom: 8px; color: var(--ls-black);"></i>
                            <strong style="color: var(--ls-black);">No assessment attempts recorded</strong>
                            <span style="font-size: 0.85rem;">Progression timeline will populate after the learner completes their first quiz.</span>
                        </div>
                    <% } %>
                </div>
            </section>

            <!-- Right Chart: Topic-Wise Performance -->
            <section class="ls-card">
                <div class="ls-card-header">
                    <h2 class="ls-card-title">
                        <i class="fas fa-bars-progress" style="color: var(--ls-purple);"></i> Topic-Wise Performance
                    </h2>
                    <span class="badge badge-outline"><%= analytics.subjects.length %> Topics</span>
                </div>
                <div style="height: 280px; position: relative;">
                    <% if (analytics.subjects.length > 0) { %>
                        <canvas id="topicPerformanceChart"></canvas>
                    <% } else { %>
                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--ls-muted); text-align: center;">
                            <i class="fas fa-book-open" style="font-size: 2rem; margin-bottom: 8px; color: var(--ls-black);"></i>
                            <strong style="color: var(--ls-black);">No topic records found</strong>
                            <span style="font-size: 0.85rem;">Subject breakdown will appear as quizzes across subjects are completed.</span>
                        </div>
                    <% } %>
                </div>
            </section>
        </div>

        <!-- Secondary Diagnostics Row (Score Distribution & Trajectory Comparison) -->
        <div class="learner-grid-2col">
            <!-- Left: Score Distribution Donut Chart -->
            <section class="ls-card">
                <div class="ls-card-header">
                    <h2 class="ls-card-title">
                        <i class="fas fa-chart-pie" style="color: var(--ls-purple);"></i> Score Distribution Bands
                    </h2>
                    <span class="badge badge-outline"><%= scoreDistribution.totalValidAttempts %> Attempts</span>
                </div>
                <div style="display: flex; align-items: center; justify-content: center; gap: 24px; min-height: 240px; flex-wrap: wrap;">
                    <div style="width: 170px; height: 170px; position: relative; flex-shrink: 0;">
                        <canvas id="distributionDonutChart"></canvas>
                        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;">
                            <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 900; color: var(--ls-black);">
                                <%= scoreDistribution.totalValidAttempts %>
                            </div>
                            <div style="font-size: 0.72rem; color: var(--ls-muted); font-weight: 700;">Quizzes</div>
                        </div>
                    </div>
                    <!-- Legend -->
                    <div style="font-size: 0.85rem; font-weight: 700; display: flex; flex-direction: column; gap: 8px;">
                        <div>
                            <i class="fas fa-circle" style="color: #22A65A; margin-right: 6px;"></i> 80–100% 
                            <span style="color: var(--ls-muted); margin-left: 6px;"><%= scoreDistribution.buckets['80-100%'] %> (<%= scoreDistribution.percentages['80-100%'] %>%)</span>
                        </div>
                        <div>
                            <i class="fas fa-circle" style="color: #2457FF; margin-right: 6px;"></i> 60–79% 
                            <span style="color: var(--ls-muted); margin-left: 6px;"><%= scoreDistribution.buckets['60-79%'] %> (<%= scoreDistribution.percentages['60-79%'] %>%)</span>
                        </div>
                        <div>
                            <i class="fas fa-circle" style="color: #FF7628; margin-right: 6px;"></i> 40–59% 
                            <span style="color: var(--ls-muted); margin-left: 6px;"><%= scoreDistribution.buckets['40-59%'] %> (<%= scoreDistribution.percentages['40-59%'] %>%)</span>
                        </div>
                        <div>
                            <i class="fas fa-circle" style="color: #F45145; margin-right: 6px;"></i> 0–39% 
                            <span style="color: var(--ls-muted); margin-left: 6px;"><%= scoreDistribution.buckets['0-39%'] %> (<%= scoreDistribution.percentages['0-39%'] %>%)</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Right: Recent vs. Earlier Trajectory Comparison -->
            <section class="ls-card">
                <div class="ls-card-header">
                    <h2 class="ls-card-title">
                        <i class="fas fa-arrow-trend-up" style="color: var(--ls-purple);"></i> Performance Trajectory
                    </h2>
                    <% if (recentVsEarlier.hasEnoughData) { %>
                        <span class="badge <%= recentVsEarlier.netDelta > 0 ? 'badge-green' : (recentVsEarlier.netDelta < 0 ? 'badge-coral' : 'badge-purple') %>">
                            <%= recentVsEarlier.netDelta > 0 ? '+' : '' %><%= recentVsEarlier.netDelta %>% Net Shift
                        </span>
                    <% } else { %>
                        <span class="badge badge-outline">Insufficient History</span>
                    <% } %>
                </div>

                <div style="padding: 0.5rem 0;">
                    <% if (recentVsEarlier.hasEnoughData) { %>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 1.25rem;">
                            <!-- Earlier Period Card -->
                            <div style="border: 2px solid var(--ls-black); border-radius: var(--radius-md); padding: 1rem; background: #FAFAFA;">
                                <div style="font-size: 0.75rem; font-weight: 800; color: var(--ls-muted); text-transform: uppercase;">Earlier Half (<%= recentVsEarlier.earlierAttemptsCount %> Quizzes)</div>
                                <div style="font-size: 1.75rem; font-weight: 900; color: var(--ls-black);"><%= recentVsEarlier.earlierAverage %>%</div>
                                <div style="font-size: 0.8rem; color: var(--ls-muted);"><%= recentVsEarlier.earlierPeriod %></div>
                            </div>

                            <!-- Recent Period Card -->
                            <div style="border: 2px solid var(--ls-black); border-radius: var(--radius-md); padding: 1rem; background: #FFFFFF;">
                                <div style="font-size: 0.75rem; font-weight: 800; color: var(--ls-purple); text-transform: uppercase;">Recent Half (<%= recentVsEarlier.recentAttemptsCount %> Quizzes)</div>
                                <div style="font-size: 1.75rem; font-weight: 900; color: <%= recentVsEarlier.netDelta >= 0 ? 'var(--ls-green)' : 'var(--ls-coral)' %>;"><%= recentVsEarlier.recentAverage %>%</div>
                                <div style="font-size: 0.8rem; color: var(--ls-muted);"><%= recentVsEarlier.recentPeriod %></div>
                            </div>
                        </div>

                        <div style="border: 2px solid var(--ls-black); border-radius: var(--radius-sm); padding: 0.85rem 1rem; background: var(--ls-yellow-subtle);">
                            <div style="font-weight: 800; font-size: 0.88rem; color: var(--ls-black); margin-bottom: 4px;">
                                <i class="fas fa-circle-info" style="color: var(--ls-purple); margin-right: 6px;"></i> Trajectory Analysis
                            </div>
                            <div style="font-size: 0.85rem; color: #2B2B2B; line-height: 1.45;">
                                <%= recentVsEarlier.explanation %>
                            </div>
                        </div>
                    <% } else { %>
                        <div style="padding: 1.75rem 1rem; text-align: center; color: var(--ls-muted);">
                            <div style="font-size: 2rem; color: var(--ls-black); margin-bottom: 8px;">
                                <i class="fas fa-hourglass-half"></i>
                            </div>
                            <strong style="color: var(--ls-black); display: block; margin-bottom: 4px;">Insufficient Assessment History</strong>
                            <p style="font-size: 0.88rem; max-width: 420px; margin: 0 auto 12px auto; line-height: 1.45;">
                                At least 4 completed quizzes are required to perform a meaningful earlier-vs-recent trajectory comparison. The student currently has <strong><%= recentVsEarlier.attemptCount %></strong> of 4 required attempts.
                            </p>
                            <span class="badge badge-outline" style="font-size: 0.78rem;">
                                <%= 4 - recentVsEarlier.attemptCount %> more <%= (4 - recentVsEarlier.attemptCount === 1) ? 'attempt' : 'attempts' %> needed
                            </span>
                        </div>
                    <% } %>
                </div>
            </section>
        </div>

        <!-- Learning Recommendations & Weak-Topic Diagnostics -->
        <section class="ls-card" style="margin-bottom: 2rem;">
            <div class="ls-card-header">
                <h2 class="ls-card-title">
                    <i class="fas fa-lightbulb" style="color: var(--ls-purple);"></i> Diagnostic Insights &amp; Learning Recommendations
                </h2>
                <span class="badge badge-outline"><%= recommendations.length %> Diagnostic Points</span>
            </div>

            <div>
                <% recommendations.forEach(rec => { %>
                    <div class="recommendation-card <%= rec.level %>">
                        <div style="width: 38px; height: 38px; border-radius: var(--radius-sm); border: 2px solid var(--ls-black); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; background: <%= rec.level === 'critical' ? 'var(--ls-coral-light)' : (rec.level === 'success' ? 'var(--ls-green-light)' : 'var(--ls-purple-light)') %>; color: <%= rec.level === 'critical' ? 'var(--ls-coral)' : (rec.level === 'success' ? 'var(--ls-green)' : 'var(--ls-purple)') %>;">
                            <i class="fas <%= rec.level === 'critical' ? 'fa-triangle-exclamation' : (rec.level === 'success' ? 'fa-star' : 'fa-info') %>"></i>
                        </div>
                        <div style="flex: 1;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 4px; flex-wrap: wrap;">
                                <strong style="color: var(--ls-black); font-size: 1rem;"><%= rec.title %></strong>
                                <span class="badge <%= rec.level === 'critical' ? 'badge-coral' : (rec.level === 'success' ? 'badge-green' : 'badge-outline') %>" style="font-size: 0.72rem; text-transform: uppercase;">
                                    <%= rec.type.replace('_', ' ') %>
                                </span>
                            </div>
                            <p style="font-size: 0.88rem; color: #2B2B2B; margin-bottom: 6px; line-height: 1.45;">
                                <%= rec.basis %>
                            </p>
                            <div style="font-size: 0.82rem; font-weight: 700; color: var(--ls-purple);">
                                <i class="fas fa-hand-point-right" style="margin-right: 4px;"></i> Recommended Intervention: <%= rec.action %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>

        <!-- Chronological Assessment History Table with Question Review Permalinks -->
        <section class="ls-card" style="margin-bottom: 2rem;">
            <div class="ls-card-header" style="flex-wrap: wrap; gap: 12px;">
                <h2 class="ls-card-title">
                    <i class="fas fa-history" style="color: var(--ls-purple);"></i> Comprehensive Assessment History
                </h2>
                <div style="display: flex; gap: 8px;">
                    <a href="/admin/learners/<%= learner._id %>/export-csv" class="btn btn-outline btn-sm">
                        <i class="fas fa-file-csv"></i> Download CSV
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="ls-table">
                    <thead>
                        <tr>
                            <th>Attempt #</th>
                            <th>Topic</th>
                            <th>Difficulty</th>
                            <th>Date Completed</th>
                            <th>Score</th>
                            <th>Percentage</th>
                            <th>Performance</th>
                            <th>Diagnostics</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (analytics.performanceOverTime.length === 0) { %>
                            <tr>
                                <td colspan="8" style="text-align: center; color: var(--ls-muted); padding: 3rem 1rem;">
                                    <div style="font-size: 1.6rem; margin-bottom: 0.5rem; color: var(--ls-black);">
                                        <i class="fas fa-file-lines"></i>
                                    </div>
                                    <strong style="color: var(--ls-black);">No assessment records found for this learner.</strong><br>
                                    <span style="font-size: 0.85rem;">Completed quiz attempts will accumulate here automatically as the student practices.</span>
                                </td>
                            </tr>
                        <% } else { %>
                            <% analytics.performanceOverTime.forEach((quiz) => { %>
                                <tr>
                                    <td style="font-weight: 800;">#<%= quiz.attemptNumber %></td>
                                    <td style="font-weight: 800; color: var(--ls-black);">
                                        <%= quiz.topic %>
                                    </td>
                                    <td>
                                        <span class="badge badge-outline" style="font-size: 0.72rem; text-transform: capitalize;">
                                            <%= quiz.difficulty %>
                                        </span>
                                    </td>
                                    <td style="color: var(--ls-muted); font-size: 0.85rem;">
                                        <%= quiz.date ? new Date(quiz.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'N/A' %>
                                    </td>
                                    <td style="font-weight: 700;">
                                        <%= quiz.score %> / <%= quiz.totalQuestions %>
                                    </td>
                                    <td style="font-weight: 900; color: <%= quiz.percentage >= 70 ? 'var(--ls-green)' : (quiz.percentage >= 50 ? 'var(--ls-purple)' : 'var(--ls-coral)') %>;">
                                        <%= quiz.percentage %>%
                                    </td>
                                    <td>
                                        <% if (quiz.percentage >= 80) { %>
                                            <span class="badge badge-green">Mastery</span>
                                        <% } else if (quiz.percentage >= 65) { %>
                                            <span class="badge badge-blue">Passing</span>
                                        <% } else { %>
                                            <span class="badge badge-coral">Needs Revision</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <a href="/admin/learners/<%= learner._id %>/review/<%= quiz.attemptId %>" class="btn btn-outline btn-sm" title="View Question-by-Question Diagnostics">
                                            <i class="fas fa-list-check"></i> Review
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <%- include('../includes/footer') %>

    <!-- Chart.js Visualization Logic -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const performanceData = <%- JSON.stringify(analytics.performanceOverTime) %>;
            const subjectsData = <%- JSON.stringify(analytics.subjects) %>;
            const distributionData = <%- JSON.stringify(scoreDistribution.buckets) %>;

            // 1. Score Progression Line Chart
            const progressionCtx = document.getElementById('scoreProgressionChart');
            if (progressionCtx && performanceData.length > 0) {
                new Chart(progressionCtx, {
                    type: 'line',
                    data: {
                        labels: performanceData.map(p => `Attempt #${p.attemptNumber} (${p.topic})`),
                        datasets: [{
                            label: 'Score Percentage (%)',
                            data: performanceData.map(p => p.percentage),
                            borderColor: '#5B20FF',
                            backgroundColor: 'rgba(91, 32, 255, 0.08)',
                            fill: true,
                            borderWidth: 2.5,
                            tension: 0.25,
                            pointRadius: 5,
                            pointBackgroundColor: '#FED439',
                            pointBorderColor: '#111111',
                            pointBorderWidth: 2,
                            pointHoverRadius: 7
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                min: 0,
                                max: 100,
                                ticks: {
                                    stepSize: 20,
                                    callback: v => `${v}%`,
                                    font: { family: "'Space Grotesk', sans-serif", weight: '700' }
                                },
                                grid: { color: 'rgba(0,0,0,0.06)' }
                            },
                            x: {
                                ticks: {
                                    font: { family: "'Space Grotesk', sans-serif", weight: '700' },
                                    maxRotation: 45
                                },
                                grid: { display: false }
                            }
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: ctx => `Score: ${ctx.parsed.y}%`
                                }
                            }
                        }
                    }
                });
            }

            // 2. Topic-Wise Performance Bar Chart
            const topicCtx = document.getElementById('topicPerformanceChart');
            if (topicCtx && subjectsData.length > 0) {
                new Chart(topicCtx, {
                    type: 'bar',
                    data: {
                        labels: subjectsData.map(s => s.subject),
                        datasets: [{
                            label: 'Average Score (%)',
                            data: subjectsData.map(s => s.averageScore),
                            backgroundColor: subjectsData.map(s => 
                                s.averageScore >= 80 ? '#22A65A' : (s.averageScore >= 65 ? '#5B20FF' : '#F45145')
                            ),
                            borderWidth: 2,
                            borderColor: '#111111'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                min: 0,
                                max: 100,
                                ticks: {
                                    stepSize: 20,
                                    callback: v => `${v}%`,
                                    font: { family: "'Space Grotesk', sans-serif", weight: '700' }
                                },
                                grid: { color: 'rgba(0,0,0,0.06)' }
                            },
                            x: {
                                ticks: {
                                    font: { family: "'Space Grotesk', sans-serif", weight: '700' }
                                },
                                grid: { display: false }
                            }
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    afterLabel: ctx => {
                                        const item = subjectsData[ctx.dataIndex];
                                        return `Attempts: ${item.attempts} | Best: ${item.highestScore}%`;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // 3. Score Distribution Donut Chart
            const donutCtx = document.getElementById('distributionDonutChart');
            if (donutCtx) {
                const totalAttempts = (distributionData['80-100%'] || 0) +
                                      (distributionData['60-79%'] || 0) +
                                      (distributionData['40-59%'] || 0) +
                                      (distributionData['0-39%'] || 0);

                new Chart(donutCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['80-100%', '60-79%', '40-59%', '0-39%'],
                        datasets: [{
                            data: [
                                distributionData['80-100%'] || 0,
                                distributionData['60-79%'] || 0,
                                distributionData['40-59%'] || 0,
                                distributionData['0-39%'] || 0
                            ],
                            backgroundColor: ['#22A65A', '#2457FF', '#FF7628', '#F45145'],
                            borderWidth: 2,
                            borderColor: '#111111'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '72%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: ctx => {
                                        const count = ctx.parsed;
                                        const pct = totalAttempts > 0 ? Math.round((count / totalAttempts) * 100) : 0;
                                        return `${ctx.label}: ${count} attempts (${pct}%)`;
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
</body>
</html>

