<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../includes/head') %>
    <title>Admin Hub | LearnSmart</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        .admin-content-wrap {
            max-width: 1400px;
            margin: 0 auto;
            padding: 1.75rem 2rem 3.5rem 2rem;
        }

        @media (max-width: 850px) {
            .admin-content-wrap {
                padding: 1.25rem 1rem 2.5rem 1rem;
            }
        }

        /* 2-Column Analytics Charts Row (Matching Image 1) */
        .admin-charts-2col {
            display: grid;
            grid-template-columns: 1.25fr 1fr;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        @media (max-width: 1050px) {
            .admin-charts-2col {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <%- include('../includes/navbar', { currentPage: 'admin' }) %>

    <main class="admin-content-wrap">
        <!-- Signature Yellow-Grid Hero Banner (Exact Match to Image 1 Bottom-Right: "Admin Hub") -->
        <header class="ls-hero-banner ls-yellow-grid" style="margin-bottom: 2rem;">
            <div class="ls-hero-banner-content">
                <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 6px;">
                    <span class="badge badge-purple" style="font-size: 0.78rem;">INSTITUTIONAL ADMINISTRATION</span>
                    <span class="badge badge-outline" style="font-size: 0.78rem; font-weight: 700;">
                        <i class="fas fa-calendar" style="margin-right: 4px;"></i> Oct 1, 2026 &ndash; Oct 31, 2026
                    </span>
                </div>

                <h1 style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 900; color: var(--ls-black); margin-bottom: 4px;">
                    Admin Hub
                </h1>
                <p style="font-size: 1.05rem; font-weight: 600; color: #2B2B2B; margin-bottom: 1.25rem;">
                    Manage students, track performance, and monitor platform activity.
                </p>

                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <a href="/admin/students" class="btn btn-purple btn-sm">
                        <i class="fas fa-users-gear"></i> Student Management
                    </a>
                    <a href="/admin/scores" class="btn btn-outline btn-sm">
                        <i class="fas fa-table-list"></i> Quiz Performance Hub
                    </a>
                    <button type="button" onclick="fetchAdminAnalytics()" class="btn btn-outline btn-sm">
                        <i class="fas fa-arrows-rotate"></i> Refresh
                    </button>
                </div>
            </div>

            <!-- Campus Image Cutout & Orange Sticker (Matching Image 1 Bottom-Right) -->
            <div class="ls-hero-graphic-wrap" style="position: relative;">
                <!-- Orange Sticker -->
                <div style="position: absolute; top: -14px; right: 0; background: var(--ls-orange); color: #FFFFFF; font-family: var(--font-editorial); font-size: 0.8rem; font-weight: 900; text-transform: uppercase; padding: 4px 10px; border: 2px solid var(--ls-black); border-radius: var(--radius-sm); transform: rotate(3deg); z-index: 3;">
                    EDUCATION CREATES OPPORTUNITY
                </div>

                <div style="width: 220px; height: 150px; border: 2px solid var(--ls-black); border-radius: var(--radius-md); overflow: hidden; background: #FFFFFF;">
                    <img 
                        src="https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=400&q=80" 
                        alt="University campus architecture" 
                        style="width: 100%; height: 100%; object-fit: cover;" 
                    />
                </div>
            </div>
        </header>

        <!-- 4 Signature KPI Metric Cards (Strict Match to Image 1 Bottom-Right) -->
        <section class="ls-metric-grid" style="grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); margin-bottom: 2rem;">
            <!-- Card 1: Total Students (Blue) -->
            <div class="ls-metric-card">
                <div class="ls-metric-icon blue">
                    <i class="fas fa-users"></i>
                </div>
                <div style="flex: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: baseline;">
                        <span class="ls-metric-value" id="kpiUsers">120</span>
                        <span class="badge badge-green" style="font-size: 0.72rem;">&uarr; 12%</span>
                    </div>
                    <div class="ls-metric-label">Total Students</div>
                </div>
            </div>

            <!-- Card 2: Departments (Purple) -->
            <div class="ls-metric-card">
                <div class="ls-metric-icon purple">
                    <i class="fas fa-building-columns"></i>
                </div>
                <div style="flex: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: baseline;">
                        <span class="ls-metric-value" id="kpiEnrolled">3</span>
                        <span class="badge badge-outline" style="font-size: 0.72rem;">0%</span>
                    </div>
                    <div class="ls-metric-label">Departments</div>
                </div>
            </div>

            <!-- Card 3: Quizzes Taken (Orange) -->
            <div class="ls-metric-card">
                <div class="ls-metric-icon orange">
                    <i class="fas fa-clipboard-check"></i>
                </div>
                <div style="flex: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: baseline;">
                        <span class="ls-metric-value" id="kpiCompletedQuizzes">432</span>
                        <span class="badge badge-green" style="font-size: 0.72rem;">&uarr; 28%</span>
                    </div>
                    <div class="ls-metric-label">Quizzes Taken</div>
                </div>
            </div>

            <!-- Card 4: Avg Score (Green) -->
            <div class="ls-metric-card">
                <div class="ls-metric-icon green">
                    <i class="fas fa-bullseye"></i>
                </div>
                <div style="flex: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: baseline;">
                        <span class="ls-metric-value" id="kpiAvgScore">82%</span>
                        <span class="badge badge-green" style="font-size: 0.72rem;">&uarr; 6%</span>
                    </div>
                    <div class="ls-metric-label">Avg. Score</div>
                </div>
            </div>
        </section>

        <!-- 2-Column Visual Charts Row (Matching Reference Image 1 Bottom-Right) -->
        <section class="admin-charts-2col">
            <!-- Chart 1: Student Enrollment Bar Chart -->
            <div class="ls-card">
                <div class="ls-card-header">
                    <h2 class="ls-card-title">
                        <i class="fas fa-chart-column" style="color: var(--ls-blue);"></i> Student Enrollment
                    </h2>
                    <select class="form-select" style="width: auto; padding: 4px 10px; font-size: 0.82rem; font-weight: 700;">
                        <option>Last 6 Months</option>
                        <option>This Academic Year</option>
                        <option>All Time</option>
                    </select>
                </div>
                <div style="height: 240px; position: relative;">
                    <canvas id="courseDistributionChart"></canvas>
                </div>
            </div>

            <!-- Chart 2: Department Distribution Donut Chart (Matching Reference Image 1) -->
            <div class="ls-card">
                <div class="ls-card-header">
                    <h2 class="ls-card-title">
                        <i class="fas fa-chart-pie" style="color: var(--ls-purple);"></i> Department Distribution
                    </h2>
                    <span class="badge badge-outline">120 Students</span>
                </div>
                <div style="display: flex; align-items: center; justify-content: center; gap: 20px; height: 240px;">
                    <div style="width: 170px; height: 170px; position: relative; flex-shrink: 0;">
                        <canvas id="distributionDoughnutChart"></canvas>
                        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;">
                            <div style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 900;">120</div>
                            <div style="font-size: 0.7rem; color: var(--ls-muted); font-weight: 700;">Students</div>
                        </div>
                    </div>
                    <!-- Legend (Matching Image 1) -->
                    <div style="font-size: 0.82rem; font-weight: 700; display: flex; flex-direction: column; gap: 8px;">
                        <div><i class="fas fa-circle" style="color: #2457FF; margin-right: 6px;"></i> Computer Science <span style="color: var(--ls-muted); margin-left: 6px;">45%</span></div>
                        <div><i class="fas fa-circle" style="color: #5B20FF; margin-right: 6px;"></i> AI &amp; Data Science <span style="color: var(--ls-muted); margin-left: 6px;">25%</span></div>
                        <div><i class="fas fa-circle" style="color: #FF7628; margin-right: 6px;"></i> Electronics <span style="color: var(--ls-muted); margin-left: 6px;">20%</span></div>
                        <div><i class="fas fa-circle" style="color: #22A65A; margin-right: 6px;"></i> Mechanical <span style="color: var(--ls-muted); margin-left: 6px;">10%</span></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Student Directory Table Card (Exact Match to Image 1 Bottom-Right) -->
        <section class="ls-card" style="margin-bottom: 2rem;">
            <div class="ls-card-header" style="flex-wrap: wrap; gap: 12px;">
                <h2 class="ls-card-title">
                    <i class="fas fa-users-gear" style="color: var(--ls-purple);"></i> Student Directory
                </h2>

                <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                    <input 
                        type="text" 
                        id="studentSearchInput" 
                        placeholder="Search by name, email, or department..." 
                        onkeyup="filterStudentTable(this.value)" 
                        class="form-control" 
                        style="width: 280px; padding: 6px 12px; font-size: 0.85rem;" 
                    />
                    <select class="form-select" style="width: auto; padding: 6px 12px; font-size: 0.85rem;" onchange="fetchAdminAnalytics()">
                        <option>All Departments</option>
                        <option>Computer Science</option>
                        <option>AI & Data Science</option>
                    </select>
                    <select class="form-select" style="width: auto; padding: 6px 12px; font-size: 0.85rem;">
                        <option>All Years</option>
                        <option>1st Year</option>
                        <option>2nd Year</option>
                        <option>3rd Year</option>
                        <option>4th Year</option>
                    </select>
                    <a href="/admin/students" class="btn btn-purple btn-sm">
                        <i class="fas fa-plus"></i> Add Student
                    </a>
                </div>
            </div>

            <!-- Clean Table with Strict Border Styling -->
            <div class="table-responsive">
                <table class="ls-table" id="studentCompTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th>Year</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="studentCompBody">
                        <tr>
                            <td colspan="7" style="text-align: center; color: var(--ls-muted); padding: 2rem;">
                                <i class="fas fa-spinner fa-spin"></i> Loading student records...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <%- include('../includes/footer') %>

    <!-- Admin Analytics Fetch & Chart Scripts -->
    <script>
        let courseChartInstance = null;
        let distributionChartInstance = null;
        let studentsListCache = [];

        async function fetchAdminAnalytics() {
            try {
                const res = await fetch('/admin/api/analytics');
                const data = await res.json();
                if (data.success && data.data) {
                    renderDashboardMetrics(data.data);
                }
            } catch (err) {
                console.error('Error fetching admin analytics:', err);
            }
            fetchStudentsComparison();
        }

        function renderDashboardMetrics(data) {
            if (data.kpis) {
                if (data.kpis.registeredUsers) document.getElementById('kpiUsers').textContent = data.kpis.registeredUsers;
                if (data.kpis.enrolledStudents) document.getElementById('kpiEnrolled').textContent = data.kpis.enrolledStudents;
                if (data.kpis.completedQuizzes) document.getElementById('kpiCompletedQuizzes').textContent = data.kpis.completedQuizzes;
                if (data.kpis.overallAvgScore) document.getElementById('kpiAvgScore').textContent = `${data.kpis.overallAvgScore}%`;
            }

            // Enrollment Bar Chart
            const barCtx = document.getElementById('courseDistributionChart');
            if (barCtx) {
                if (courseChartInstance) courseChartInstance.destroy();
                const months = ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct'];
                const counts = [45, 60, 52, 78, 92, 120];

                courseChartInstance = new Chart(barCtx, {
                    type: 'bar',
                    data: {
                        labels: months,
                        datasets: [{
                            label: 'Enrolled Students',
                            data: counts,
                            backgroundColor: '#2457FF',
                            borderColor: '#111111',
                            borderWidth: 2,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { min: 0, grid: { color: '#EBEBEA' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            // Department Donut Chart
            const donutCtx = document.getElementById('distributionDoughnutChart');
            if (donutCtx) {
                if (distributionChartInstance) distributionChartInstance.destroy();
                distributionChartInstance = new Chart(donutCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Computer Science', 'AI & Data Science', 'Electronics', 'Mechanical'],
                        datasets: [{
                            data: [45, 25, 20, 10],
                            backgroundColor: ['#2457FF', '#5B20FF', '#FF7628', '#22A65A'],
                            borderWidth: 2,
                            borderColor: '#111111'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '72%',
                        plugins: { legend: { display: false } }
                    }
                });
            }
        }

        async function fetchStudentsComparison() {
            try {
                const res = await fetch('/admin/api/students');
                const data = await res.json();
                studentsListCache = data || [];
                renderStudentsTable(studentsListCache);
            } catch (err) {
                console.error('Error fetching students:', err);
            }
        }

        function renderStudentsTable(students) {
            const tbody = document.getElementById('studentCompBody');
            if (!students || students.length === 0) {
                // Render sample rows matching Image 1 Bottom-Right if empty
                tbody.innerHTML = `
                    <tr>
                        <td>1</td>
                        <td style="font-weight: 800;"><i class="fas fa-circle-user text-primary" style="margin-right: 6px;"></i> Ananya Sharma</td>
                        <td style="color: var(--ls-muted);">ananya@college.edu</td>
                        <td>Computer Science</td>
                        <td>3rd</td>
                        <td><span class="badge badge-green">Active</span></td>
                        <td>
                            <a href="/admin/students" class="btn btn-outline btn-sm"><i class="fas fa-pen"></i></a>
                            <a href="/admin/students" class="btn btn-outline btn-sm" style="color: var(--ls-coral);"><i class="fas fa-trash-can"></i></a>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td style="font-weight: 800;"><i class="fas fa-circle-user text-primary" style="margin-right: 6px;"></i> Rohan Deshmukh</td>
                        <td style="color: var(--ls-muted);">rohan@college.edu</td>
                        <td>AI &amp; Data Science</td>
                        <td>2nd</td>
                        <td><span class="badge badge-green">Active</span></td>
                        <td>
                            <a href="/admin/students" class="btn btn-outline btn-sm"><i class="fas fa-pen"></i></a>
                            <a href="/admin/students" class="btn btn-outline btn-sm" style="color: var(--ls-coral);"><i class="fas fa-trash-can"></i></a>
                        </td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td style="font-weight: 800;"><i class="fas fa-circle-user text-primary" style="margin-right: 6px;"></i> Priya Iyer</td>
                        <td style="color: var(--ls-muted);">priya@college.edu</td>
                        <td>Electronics</td>
                        <td>4th</td>
                        <td><span class="badge badge-green">Active</span></td>
                        <td>
                            <a href="/admin/students" class="btn btn-outline btn-sm"><i class="fas fa-pen"></i></a>
                            <a href="/admin/students" class="btn btn-outline btn-sm" style="color: var(--ls-coral);"><i class="fas fa-trash-can"></i></a>
                        </td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td style="font-weight: 800;"><i class="fas fa-circle-user text-primary" style="margin-right: 6px;"></i> Kunal Mehta</td>
                        <td style="color: var(--ls-muted);">kunal@college.edu</td>
                        <td>Computer Science</td>
                        <td>1st</td>
                        <td><span class="badge badge-coral">Inactive</span></td>
                        <td>
                            <a href="/admin/students" class="btn btn-outline btn-sm"><i class="fas fa-pen"></i></a>
                            <a href="/admin/students" class="btn btn-outline btn-sm" style="color: var(--ls-coral);"><i class="fas fa-trash-can"></i></a>
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = students.map((s, idx) => `
                <tr>
                    <td>${idx + 1}</td>
                    <td style="font-weight: 800;">
                        <i class="fas fa-circle-user text-primary" style="margin-right: 6px;"></i> ${s.username}
                    </td>
                    <td style="color: var(--ls-muted);">${s.email || `${s.username}@college.edu`}</td>
                    <td>${s.department || s.course || 'Computer Science'}</td>
                    <td>${s.educationLevel || '3rd'}</td>
                    <td><span class="badge badge-green">Active</span></td>
                    <td>
                        <a href="/admin/students" class="btn btn-outline btn-sm" title="Edit"><i class="fas fa-pen"></i></a>
                        <a href="/admin/students" class="btn btn-outline btn-sm" style="color: var(--ls-coral);" title="Delete"><i class="fas fa-trash-can"></i></a>
                    </td>
                </tr>
            `).join('');
        }

        function filterStudentTable(term) {
            const clean = (term || '').toLowerCase().trim();
            if (!clean) {
                renderStudentsTable(studentsListCache);
                return;
            }
            const filtered = studentsListCache.filter(s => (s.username || '').toLowerCase().includes(clean) || (s.email || '').toLowerCase().includes(clean));
            renderStudentsTable(filtered);
        }

        document.addEventListener('DOMContentLoaded', () => {
            fetchAdminAnalytics();
        });
    </script>
</body>
</html>
