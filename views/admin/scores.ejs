<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../includes/head') %>
    <title>Student Performance Dashboard | LearnSmart Admin</title>
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        .admin-scores-wrap {
            max-width: 1400px;
            margin: 0 auto;
            padding: 1.75rem 2rem 3.5rem 2rem;
        }

        @media (max-width: 850px) {
            .admin-scores-wrap {
                padding: 1.25rem 1rem 2.5rem 1rem;
            }
        }

        .charts-grid-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        @media (max-width: 1024px) {
            .charts-grid-2col {
                grid-template-columns: 1fr;
            }
        }

        .tags-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            min-height: 44px;
            padding: 8px;
            background: #F8F8F6;
            border: 1.5px solid var(--ls-black);
            border-radius: var(--radius-sm);
            margin-bottom: 12px;
        }

        .tag-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--ls-purple);
            color: #FFFFFF;
            padding: 4px 10px;
            border-radius: var(--radius-full);
            font-size: 0.8rem;
            font-weight: 700;
            border: 1px solid var(--ls-black);
            box-shadow: none;
        }

        .tag-pill.subject-tag {
            background: var(--ls-blue);
        }

        .tag-remove {
            cursor: pointer;
            margin-left: 4px;
        }
    </style>
</head>
<body>

    <%- include('../includes/navbar', { currentPage: 'scores' }) %>

    <main class="admin-scores-wrap" id="dashboard-content">
        <!-- Signature Yellow-Grid Hero Banner -->
        <header class="ls-hero-banner ls-yellow-grid" style="margin-bottom: 2rem;">
            <div class="ls-hero-banner-content">
                <div class="ls-sticker orange" style="font-size: 0.75rem; margin-bottom: 8px;">
                    STUDENT SCORES &bull; PERFORMANCE DIAGNOSTICS
                </div>
                <h1 style="font-family: var(--font-heading); font-size: 2.4rem; font-weight: 900; color: var(--ls-black); margin-bottom: 4px;">
                    Quiz Performance Hub
                </h1>
                <p style="font-size: 1.05rem; font-weight: 600; color: #2B2B2B; margin-bottom: 1.25rem;">
                    Comprehensive institutional overview of individual scores, multi-student benchmarks, and topic distributions.
                </p>
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <button type="button" id="exportBtn" onclick="exportReport()" class="btn btn-purple btn-sm">
                        <i class="fas fa-download"></i> Export PDF Report
                    </button>
                    <button type="button" onclick="refreshData()" class="btn btn-outline btn-sm">
                        <i class="fas fa-arrows-rotate"></i> Refresh Data
                    </button>
                    <a href="/admin/dashboard" class="btn btn-outline btn-sm">
                        <i class="fas fa-table-cells-large"></i> Admin Hub
                    </a>
                </div>
            </div>

            <!-- Campus Graphic Element -->
            <div class="ls-hero-graphic-wrap" style="position: relative;">
                <div style="position: absolute; top: -14px; right: 0; background: var(--ls-purple); color: #FFFFFF; font-family: var(--font-editorial); font-size: 0.8rem; font-weight: 900; text-transform: uppercase; padding: 4px 10px; border: 2px solid var(--ls-black); border-radius: var(--radius-sm); transform: rotate(3deg); z-index: 3;">
                    INSTITUTIONAL METRICS
                </div>

                <div style="width: 220px; height: 150px; border: 2px solid var(--ls-black); border-radius: var(--radius-md); overflow: hidden; background: #FFFFFF;">
                    <img 
                        src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=400&q=80" 
                        alt="Academic exam evaluation" 
                        style="width: 100%; height: 100%; object-fit: cover;" 
                    />
                </div>
            </div>
        </header>

        <% 
            const uniqueStudents = scores.length > 0 ? [...new Set(scores.map(s => s.username))] : [];
            const uniqueTopics = scores.length > 0 ? [...new Set(scores.map(s => s.topic))] : [];
            let totalScore = scores.reduce((sum, score) => sum + parseFloat(score.avgScore), 0);
            const overallAvg = scores.length > 0 ? (totalScore / scores.length).toFixed(1) : '0';
            const maxScore = scores.length > 0 ? Math.max(...scores.map(s => parseFloat(s.avgScore))).toFixed(1) : '0';
        %>

        <% if (scores.length > 0) { %>
            <!-- 4-Metric Balanced KPI Grid -->
            <section class="ls-metric-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 2rem;">
                <div class="ls-metric-card">
                    <div class="ls-metric-icon blue">
                        <i class="fas fa-users"></i>
                    </div>
                    <div>
                        <div class="ls-metric-value"><%= uniqueStudents.length %></div>
                        <div class="ls-metric-label">Total Students</div>
                    </div>
                </div>

                <div class="ls-metric-card">
                    <div class="ls-metric-icon purple">
                        <i class="fas fa-book"></i>
                    </div>
                    <div>
                        <div class="ls-metric-value"><%= uniqueTopics.length %></div>
                        <div class="ls-metric-label">Subjects Tracked</div>
                    </div>
                </div>

                <div class="ls-metric-card">
                    <div class="ls-metric-icon green">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div>
                        <div class="ls-metric-value"><%= overallAvg %>%</div>
                        <div class="ls-metric-label">Average Performance</div>
                    </div>
                </div>

                <div class="ls-metric-card">
                    <div class="ls-metric-icon orange">
                        <i class="fas fa-trophy"></i>
                    </div>
                    <div>
                        <div class="ls-metric-value"><%= maxScore %>%</div>
                        <div class="ls-metric-label">Peak Score Record</div>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- Filter Controls Card -->
        <section class="ls-card" style="margin-bottom: 2rem;">
            <div class="ls-card-header">
                <h3 class="ls-card-title"><i class="fas fa-filter" style="color: var(--ls-purple);"></i> Filter Scores</h3>
                <span class="badge badge-outline">Live Database Filter</span>
            </div>

            <form method="GET" action="/admin/scores">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; align-items: end;">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="form-label" for="topicSelect">Filter by Topic</label>
                        <select name="topic" id="topicSelect" class="form-select">
                            <option value="">All Topics</option>
                            <% uniqueTopics.forEach(t => { %>
                                <option value="<%= t %>" <%= (typeof topic !== 'undefined' && topic === t) ? 'selected' : '' %>><%= t %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="form-label" for="studentSelect">Filter by Student</label>
                        <select name="student" id="studentSelect" class="form-select">
                            <option value="">All Students</option>
                            <% uniqueStudents.forEach(s => { %>
                                <option value="<%= s %>" <%= (typeof student !== 'undefined' && student === s) ? 'selected' : '' %>><%= s %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div style="display: flex; gap: 8px;">
                        <button type="submit" class="btn btn-purple" style="flex: 1;">
                            <i class="fas fa-check"></i> Apply Filter
                        </button>
                        <a href="/admin/scores" class="btn btn-outline">Reset</a>
                    </div>
                </div>
            </form>
        </section>

        <% if (scores.length > 0) { %>
            <!-- 2 Charts Grid -->
            <section class="charts-grid-2col">
                <div class="ls-card">
                    <div class="ls-card-header">
                        <h3 class="ls-card-title"><i class="fas fa-chart-bar" style="color: var(--ls-blue);"></i> Average Scores by Student</h3>
                    </div>
                    <div style="height: 260px; position: relative;">
                        <canvas id="scoreChart"></canvas>
                    </div>
                </div>

                <div class="ls-card">
                    <div class="ls-card-header">
                        <h3 class="ls-card-title"><i class="fas fa-chart-pie" style="color: var(--ls-purple);"></i> Performance by Topic</h3>
                    </div>
                    <div style="height: 260px; position: relative;">
                        <canvas id="topicChart"></canvas>
                    </div>
                </div>
            </section>

            <!-- Multi-Student & Subject Comparison Card -->
            <section class="ls-card" style="margin-bottom: 2rem;">
                <div class="ls-card-header">
                    <h3 class="ls-card-title"><i class="fas fa-compress-alt" style="color: var(--ls-purple);"></i> Compare Performance Across Candidates</h3>
                    <div style="display: flex; gap: 8px;">
                        <button type="button" class="btn btn-purple btn-sm" onclick="updateComparison()">
                            <i class="fas fa-arrows-rotate"></i> Compare
                        </button>
                        <button type="button" class="btn btn-outline btn-sm" onclick="clearAllSelections()">
                            <i class="fas fa-trash-can"></i> Clear All
                        </button>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.25rem;">
                    <div>
                        <label class="form-label">Add Candidate to Compare</label>
                        <select id="studentDropdown" class="form-select" onchange="addStudent()">
                            <option value="">-- Select Candidate --</option>
                            <% uniqueStudents.forEach(s => { %>
                                <option value="<%= s %>"><%= s %></option>
                            <% }) %>
                        </select>
                        <div id="selectedStudents" class="tags-container" style="margin-top: 8px;"></div>
                    </div>

                    <div>
                        <label class="form-label">Add Subject to Compare</label>
                        <select id="subjectDropdown" class="form-select" onchange="addSubject()">
                            <option value="">-- Select Subject --</option>
                            <% uniqueTopics.forEach(t => { %>
                                <option value="<%= t %>"><%= t %></option>
                            <% }) %>
                        </select>
                        <div id="selectedSubjects" class="tags-container" style="margin-top: 8px;"></div>
                    </div>
                </div>

                <div style="height: 300px; position: relative;">
                    <canvas id="comparisonChart"></canvas>
                </div>
            </section>

        <% } else { %>
            <div class="ls-card" style="text-align: center; padding: 4rem 2rem;">
                <div style="width: 60px; height: 60px; border-radius: 50%; border: 2px solid var(--ls-black); background: var(--ls-yellow-light); color: var(--ls-black); display: flex; align-items: center; justify-content: center; font-size: 1.75rem; margin: 0 auto 1rem auto;">
                    <i class="fas fa-inbox"></i>
                </div>
                <h3 style="font-size: 1.4rem; font-weight: 800; color: var(--ls-black); margin-bottom: 0.4rem;">No Scores Found</h3>
                <p style="font-size: 0.95rem; color: var(--ls-muted); max-width: 440px; margin: 0 auto 1.5rem auto;">
                    Try adjusting your topic or student filter, or wait for students to complete practice quizzes.
                </p>
                <a href="/admin/scores" class="btn btn-purple">
                    <i class="fas fa-rotate"></i> Reset Filters
                </a>
            </div>
        <% } %>
    </main>

    <%- include('../includes/footer') %>

    <!-- Preserved Comparison & Export Scripts -->
    <script>
        const scoresData = <%- JSON.stringify(scores || []) %>;
        const uniqueStudents = <%- JSON.stringify(uniqueStudents || []) %>;
        const uniqueTopics = <%- JSON.stringify(uniqueTopics || []) %>;

        let selectedStudentsList = [];
        let selectedSubjectsList = [];
        let scoreChart = null;
        let topicChart = null;
        let comparisonChart = null;

        function refreshData() {
            window.location.reload();
        }

        function exportReport() {
            const element = document.getElementById('dashboard-content');
            html2canvas(element, { scale: 2 }).then(canvas => {
                const imgData = canvas.toDataURL('image/png');
                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('p', 'mm', 'a4');
                const imgWidth = 190;
                const pageHeight = 295;
                const imgHeight = (canvas.height * imgWidth) / canvas.width;
                pdf.addImage(imgData, 'PNG', 10, 10, imgWidth, imgHeight);
                pdf.save('LearnSmart-Performance-Report.pdf');
            });
        }

        function addStudent() {
            const dropdown = document.getElementById('studentDropdown');
            const student = dropdown.value;
            if (student && !selectedStudentsList.includes(student)) {
                selectedStudentsList.push(student);
                renderTags();
                dropdown.value = '';
            }
        }

        function removeStudent(student) {
            selectedStudentsList = selectedStudentsList.filter(s => s !== student);
            renderTags();
        }

        function addSubject() {
            const dropdown = document.getElementById('subjectDropdown');
            const subject = dropdown.value;
            if (subject && !selectedSubjectsList.includes(subject)) {
                selectedSubjectsList.push(subject);
                renderTags();
                dropdown.value = '';
            }
        }

        function removeSubject(subject) {
            selectedSubjectsList = selectedSubjectsList.filter(s => s !== subject);
            renderTags();
        }

        function clearAllSelections() {
            selectedStudentsList = [];
            selectedSubjectsList = [];
            renderTags();
            updateComparison();
        }

        function renderTags() {
            const studentContainer = document.getElementById('selectedStudents');
            if (studentContainer) {
                studentContainer.innerHTML = selectedStudentsList.map(s => `
                    <span class="tag-pill">
                        ${s} <i class="fas fa-times tag-remove" onclick="removeStudent('${s}')"></i>
                    </span>
                `).join('');
            }

            const subjectContainer = document.getElementById('selectedSubjects');
            if (subjectContainer) {
                subjectContainer.innerHTML = selectedSubjectsList.map(sub => `
                    <span class="tag-pill subject-tag">
                        ${sub} <i class="fas fa-times tag-remove" onclick="removeSubject('${sub}')"></i>
                    </span>
                `).join('');
            }
        }

        function updateComparison() {
            if (!comparisonChart) return;

            const studentsToCompare = selectedStudentsList.length > 0 ? selectedStudentsList : uniqueStudents.slice(0, 5);
            const subjectsToCompare = selectedSubjectsList.length > 0 ? selectedSubjectsList : uniqueTopics.slice(0, 5);

            const palette = ['#5B20FF', '#2457FF', '#22A65A', '#FF7628', '#F45145'];

            const datasets = studentsToCompare.map((student, idx) => {
                const studentScores = subjectsToCompare.map(subject => {
                    const match = scoresData.find(s => s.username === student && s.topic === subject);
                    return match ? parseFloat(match.avgScore) : 0;
                });

                return {
                    label: student,
                    data: studentScores,
                    backgroundColor: palette[idx % palette.length],
                    borderColor: '#111111',
                    borderWidth: 2,
                    borderRadius: 4
                };
            });

            comparisonChart.data.labels = subjectsToCompare;
            comparisonChart.data.datasets = datasets;
            comparisonChart.update();
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (scoresData.length > 0) {
                // Score Chart by Student
                const scoreCtx = document.getElementById('scoreChart');
                if (scoreCtx) {
                    const studentMap = {};
                    scoresData.forEach(s => {
                        if (!studentMap[s.username]) studentMap[s.username] = [];
                        studentMap[s.username].push(parseFloat(s.avgScore));
                    });

                    const labels = Object.keys(studentMap);
                    const data = labels.map(u => {
                        const arr = studentMap[u];
                        return (arr.reduce((a, b) => a + b, 0) / arr.length).toFixed(1);
                    });

                    scoreChart = new Chart(scoreCtx, {
                        type: 'bar',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Average Score (%)',
                                data: data,
                                backgroundColor: '#2457FF',
                                borderColor: '#111111',
                                borderWidth: 2,
                                borderRadius: 6
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false } },
                            scales: {
                                y: { min: 0, max: 100, grid: { color: '#EBEBEA' } },
                                x: { grid: { display: false } }
                            }
                        }
                    });
                }

                // Topic Chart
                const topicCtx = document.getElementById('topicChart');
                if (topicCtx) {
                    const topicMap = {};
                    scoresData.forEach(s => {
                        if (!topicMap[s.topic]) topicMap[s.topic] = [];
                        topicMap[s.topic].push(parseFloat(s.avgScore));
                    });

                    const labels = Object.keys(topicMap);
                    const data = labels.map(t => {
                        const arr = topicMap[t];
                        return (arr.reduce((a, b) => a + b, 0) / arr.length).toFixed(1);
                    });

                    topicChart = new Chart(topicCtx, {
                        type: 'doughnut',
                        data: {
                            labels: labels,
                            datasets: [{
                                data: data,
                                backgroundColor: ['#5B20FF', '#2457FF', '#22A65A', '#FF7628', '#F45145'],
                                borderWidth: 2,
                                borderColor: '#111111'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: '70%',
                            plugins: { legend: { position: 'bottom' } }
                        }
                    });
                }

                // Comparison Chart
                const compCtx = document.getElementById('comparisonChart');
                if (compCtx) {
                    comparisonChart = new Chart(compCtx, {
                        type: 'bar',
                        data: { labels: [], datasets: [] },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: { min: 0, max: 100, grid: { color: '#EBEBEA' } },
                                x: { grid: { display: false } }
                            }
                        }
                    });
                    updateComparison();
                }
            }
        });
    </script>
</body>
</html>
