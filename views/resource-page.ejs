<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('includes/head') %>
  <title>Personalized Learning Roadmap: <%= topic %> | LearnSmart</title>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

  <style>
    .resource-content-wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1.5rem 4rem 1.5rem;
    }

    .study-markdown-content {
      font-size: 1rem;
      line-height: 1.75;
      color: var(--ls-black);
    }

    .study-markdown-content h1, 
    .study-markdown-content h2, 
    .study-markdown-content h3 {
      font-family: var(--font-heading);
      margin-top: 1.5rem;
      margin-bottom: 0.75rem;
      color: var(--ls-black);
    }

    .study-markdown-content p {
      margin-bottom: 1.25rem;
      color: #333333;
    }

    .study-markdown-content ul, 
    .study-markdown-content ol {
      margin-left: 1.5rem;
      margin-bottom: 1.25rem;
    }

    .study-markdown-content code {
      font-family: var(--font-mono);
      background-color: #F0F0EE;
      border: 1px solid #D5D5D0;
      padding: 2px 6px;
      border-radius: var(--radius-xs);
      font-size: 0.9em;
      color: var(--ls-purple);
    }

    .study-markdown-content pre {
      background-color: #111318;
      color: #FFFFFF;
      padding: 1.25rem;
      border-radius: var(--radius-md);
      border: 2px solid var(--ls-black);
      overflow-x: auto;
      margin-bottom: 1.5rem;
    }

    .study-markdown-content pre code {
      background: transparent;
      border: none;
      color: #79FFE1;
      padding: 0;
    }

    .resources-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.25rem;
    }

    .resource-box-item {
      background: #FFFFFF;
      border: 2px solid var(--ls-black);
      border-radius: var(--radius-md);
      box-shadow: none;
      padding: 1.35rem 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: var(--transition-fast);
    }

    .resource-box-item:hover {
      border-color: var(--ls-purple);
    }
  </style>
</head>
<body>

  <%- include('includes/navbar', { currentPage: 'quiz' }) %>

  <main class="resource-content-wrap">
    <!-- Signature Yellow-Grid Hero Banner -->
    <header class="ls-hero-banner ls-yellow-grid" style="margin-bottom: 2rem;">
      <div>
        <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 8px; flex-wrap: wrap;">
          <span class="badge badge-purple" style="font-size: 0.82rem;">
            <i class="fas fa-bolt"></i> <%= topic %> Specialization
          </span>
          <% if (percentage >= 80) { %>
            <span class="badge badge-green"><i class="fas fa-check-double"></i> Advanced Track</span>
          <% } else if (percentage >= 50) { %>
            <span class="badge badge-yellow"><i class="fas fa-chart-line"></i> Intermediate Core Track</span>
          <% } else { %>
            <span class="badge badge-coral"><i class="fas fa-bullseye"></i> Foundations Practice</span>
          <% } %>
        </div>

        <h1 style="font-size: 2.25rem; font-weight: 900; color: var(--ls-black); margin-bottom: 6px;">
          Personalized Learning Roadmap
        </h1>
        <p style="font-size: 1.05rem; font-weight: 600; color: #2B2B2B;">
          Diagnostic recommendations and curated resources generated dynamically for <strong><%= topic %></strong>.
        </p>
      </div>

      <div style="text-align: right; flex-shrink: 0;">
        <span class="badge badge-outline" style="font-size: 1.35rem; padding: 10px 18px; border-width: 2px;">
          <%= percentage %>% Mastery
        </span>
      </div>
    </header>

    <!-- Personalized Curriculum Guide -->
    <div class="ls-card" style="margin-bottom: 2.5rem;">
      <div class="ls-card-header">
        <h2 class="ls-card-title">
          <i class="fas fa-compass" style="color: var(--ls-purple);"></i> Curriculum &amp; Remediation Guide
        </h2>
        <span class="badge badge-purple"><i class="fas fa-sparkles"></i> AI Calibrated</span>
      </div>
      <div class="study-markdown-content" id="markdownContainer"></div>
    </div>

    <!-- Recommended Video Masterclasses -->
    <% if (typeof videos !== 'undefined' && videos && videos.length > 0) { %>
      <div class="ls-card" style="margin-bottom: 2.5rem;">
        <div class="ls-card-header">
          <h2 class="ls-card-title">
            <i class="fab fa-youtube" style="color: #EF4444;"></i> Video Masterclasses
          </h2>
          <span class="badge badge-outline"><%= videos.length %> Video Lessons</span>
        </div>

        <div class="resources-grid">
          <% videos.forEach(v => { %>
            <div class="resource-box-item">
              <div>
                <span class="badge badge-coral" style="margin-bottom: 8px; font-size: 0.72rem;">Video Lesson</span>
                <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--ls-black); margin-bottom: 1rem;">
                  <%= v.title %>
                </h3>
              </div>
              <a href="<%= v.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm" style="align-self: flex-start;">
                <span>Watch Tutorial</span>
                <i class="fas fa-arrow-up-right-from-square"></i>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Official Documentation & Reading Guides -->
    <% if (typeof articles !== 'undefined' && articles && articles.length > 0) { %>
      <div class="ls-card" style="margin-bottom: 2.5rem;">
        <div class="ls-card-header">
          <h2 class="ls-card-title">
            <i class="fas fa-book-bookmark" style="color: var(--ls-blue);"></i> Documentation &amp; Standard References
          </h2>
          <span class="badge badge-outline"><%= articles.length %> Reference Guides</span>
        </div>

        <div class="resources-grid">
          <% articles.forEach(a => { %>
            <div class="resource-box-item">
              <div>
                <span class="badge badge-blue" style="margin-bottom: 8px; font-size: 0.72rem;">Documentation</span>
                <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--ls-black); margin-bottom: 1rem;">
                  <%= a.title %>
                </h3>
              </div>
              <a href="<%= a.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm" style="align-self: flex-start;">
                <span>Read Reference</span>
                <i class="fas fa-arrow-up-right-from-square"></i>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Actions / Back to Quiz -->
    <div style="display: flex; gap: 12px; justify-content: space-between; align-items: center; flex-wrap: wrap;">
      <a href="/dashboard" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Return to Dashboard
      </a>
      <a href="/quiz" class="btn btn-purple">
        <i class="fas fa-bolt"></i> Practice Another Quiz
      </a>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const rawMarkdown = <%- JSON.stringify(typeof resourceContent !== 'undefined' && resourceContent ? resourceContent : "") %>;
      const target = document.getElementById('markdownContainer');
      if (target && rawMarkdown) {
        target.innerHTML = marked.parse(rawMarkdown);
      }
    });
  </script>

  <%- include('includes/footer') %>
</body>
</html>
