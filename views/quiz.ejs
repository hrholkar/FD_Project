<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head') %>
    <title>AI Quiz Generator | LearnSmart</title>

    <style>
        .quiz-content-wrap {
            max-width: 1400px;
            margin: 0 auto;
            padding: 1.75rem 2rem 3.5rem 2rem;
        }

        /* 2-Column Quiz Generator Layout (Strict Match to Image 1 Top-Right) */
        .quiz-generator-grid {
            display: grid;
            grid-template-columns: 460px 1fr;
            gap: 2rem;
            align-items: start;
        }

        @media (max-width: 1050px) {
            .quiz-generator-grid {
                grid-template-columns: 1fr;
            }
            .quiz-content-wrap {
                padding: 1.25rem 1rem 2.5rem 1rem;
            }
        }

        /* Difficulty Buttons */
        .difficulty-group {
            display: flex;
            gap: 8px;
            margin-bottom: 1.25rem;
        }

        .diff-btn {
            flex: 1;
            padding: 8px 12px;
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-sm);
            background: #FFFFFF;
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--ls-black);
            cursor: pointer;
            text-align: center;
            box-shadow: none;
            transition: var(--transition-fast);
        }

        .diff-btn:hover {
            border-color: var(--ls-purple);
        }

        .diff-btn.active {
            background: var(--ls-purple);
            color: #FFFFFF;
            border-color: var(--ls-black);
            box-shadow: none;
        }

        /* Question Preview Card (Matching Reference Image 1) */
        .quiz-preview-card {
            background: #FFFFFF;
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-md);
            box-shadow: none;
            padding: 2rem 2.25rem;
            position: relative;
        }

        .preview-option-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 18px;
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-sm);
            background: #FFFFFF;
            margin-bottom: 12px;
            box-shadow: none;
            cursor: pointer;
            transition: var(--transition-fast);
        }

        .preview-option-item:hover {
            border-color: var(--ls-purple);
        }

        .preview-option-item.selected {
            background: var(--ls-purple-light);
            border-color: var(--ls-purple);
            box-shadow: none;
        }

        .preview-letter-badge {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1.5px solid var(--ls-black);
            background: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.88rem;
            flex-shrink: 0;
        }

        .preview-option-item.selected .preview-letter-badge {
            background: var(--ls-purple);
            color: #FFFFFF;
            border-color: var(--ls-purple);
        }
    </style>
</head>
<body>

    <%- include('includes/navbar', { currentPage: 'quiz' }) %>

    <main class="quiz-content-wrap">
        <!-- Signature Yellow-Grid Hero Banner (Exact Match to Image 1 Top-Right) -->
        <header class="ls-hero-banner ls-yellow-grid" style="margin-bottom: 2rem;">
            <div class="ls-hero-banner-content">
                <div style="font-size: 0.82rem; font-weight: 800; color: #444444; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px;">
                    Dashboard &gt; AI Quiz
                </div>
                <h1 style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 900; color: var(--ls-black); line-height: 1.1; margin-bottom: 0.35rem;">
                    AI QUIZ GENERATOR
                </h1>
                <p style="font-size: 1.05rem; font-weight: 600; color: #2B2B2B; margin-bottom: 1rem;">
                    Turn your syllabus into personalized quizzes with AI.
                </p>
                <div class="ls-sticker orange" style="font-size: 0.78rem; padding: 4px 12px;">
                    <i class="fas fa-sparkles"></i> 100% AUTOMATED &bull; MULTI-MODEL FALLBACK
                </div>
            </div>

            <!-- Book Stack Illustration & Doodle (Matching Image 1) -->
            <div class="ls-hero-graphic-wrap" style="position: relative;">
                <div style="position: absolute; top: -16px; right: 0; font-family: var(--font-editorial); font-size: 0.85rem; font-weight: 900; color: var(--ls-black); text-transform: uppercase; letter-spacing: 0.5px; transform: rotate(4deg); background: rgba(255,255,255,0.7); padding: 2px 8px; border: 1.5px solid var(--ls-black); border-radius: var(--radius-sm);">
                    PRACTICE &bull; TEST &bull; IMPROVE
                </div>

                <div style="width: 220px; height: 150px; border: 2px solid var(--ls-black); border-radius: var(--radius-md); overflow: hidden; background: #FFFFFF;">
                    <img 
                        src="https://images.unsplash.com/photo-1497633762265-9d179a990aa6?auto=format&fit=crop&w=400&q=80" 
                        alt="Stack of academic textbooks" 
                        style="width: 100%; height: 100%; object-fit: cover;" 
                    />
                </div>
            </div>
        </header>

        <!-- 2-Column Quiz Generator Layout (Matching Image 1 Top-Right) -->
        <div class="quiz-generator-grid">
            <!-- Left Card: Form Setup -->
            <div class="ls-card">
                <form action="/quizmaker" method="POST" id="quizmakerForm">
                    <!-- Subject Selector -->
                    <div class="form-group">
                        <label class="form-label" for="subjectSelect">
                            Subject
                        </label>
                        <select id="subjectSelect" class="form-select" onchange="syncTopicField()">
                            <option value="Data Structures" selected>Data Structures</option>
                            <option value="Web Development">Web Development</option>
                            <option value="Database Management (DBMS)">Database Management (DBMS)</option>
                            <option value="Operating Systems">Operating Systems</option>
                            <option value="Computer Networks">Computer Networks</option>
                            <option value="Object Oriented Programming with C++">Object Oriented Programming with C++</option>
                            <option value="Python Programming">Python Programming</option>
                            <option value="Artificial Intelligence & ML">Artificial Intelligence & ML</option>
                            <option value="Software Engineering">Software Engineering</option>
                        </select>
                    </div>

                    <!-- Topic (Optional) Input -->
                    <div class="form-group">
                        <label class="form-label" for="topicInput">
                            Topic (Optional)
                        </label>
                        <input 
                            type="text" 
                            id="topicInput" 
                            name="topic" 
                            class="form-control" 
                            value="Arrays" 
                            placeholder="e.g. Arrays, Pointers, Binary Trees, SQL Queries" 
                            required 
                        />
                    </div>

                    <!-- Difficulty Selection -->
                    <div class="form-group">
                        <label class="form-label">Difficulty</label>
                        <div class="difficulty-group" id="difficultyGroup">
                            <button type="button" class="diff-btn" onclick="setDifficulty('Easy', this)">Easy</button>
                            <button type="button" class="diff-btn active" onclick="setDifficulty('Medium', this)">Medium</button>
                            <button type="button" class="diff-btn" onclick="setDifficulty('Hard', this)">Hard</button>
                        </div>
                    </div>

                    <!-- Number of Questions -->
                    <div class="form-group">
                        <label class="form-label" for="numQuestions">Number of Questions</label>
                        <select id="numQuestions" class="form-select">
                            <option value="5">5 Questions</option>
                            <option value="10" selected>10 Questions</option>
                            <option value="15">15 Questions</option>
                        </select>
                    </div>

                    <!-- Primary Action Button -->
                    <button type="submit" class="btn btn-purple" id="generateQuizBtn" style="width: 100%; padding: 12px; font-size: 1.05rem; margin-bottom: 1.5rem;">
                        <i class="fas fa-sparkles"></i>
                        <span>Generate Quiz</span>
                    </button>

                    <!-- Quick Settings & Doodle Arrow (Matching Image 1) -->
                    <div style="border-top: 1.5px solid #EBEBEA; padding-top: 1.25rem; position: relative;">
                        <div style="font-size: 0.88rem; font-weight: 800; color: var(--ls-black); margin-bottom: 10px;">
                            Quick Settings
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 8px; font-size: 0.88rem; color: var(--ls-black); font-weight: 600;">
                            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                <input type="checkbox" checked style="width: 16px; height: 16px; accent-color: var(--ls-purple);" />
                                <span>Multiple Choice</span>
                            </label>
                            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                <input type="checkbox" style="width: 16px; height: 16px; accent-color: var(--ls-purple);" />
                                <span>Short Answer</span>
                            </label>
                            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                <input type="checkbox" style="width: 16px; height: 16px; accent-color: var(--ls-purple);" />
                                <span>Mixed Questions</span>
                            </label>
                        </div>

                        <!-- Handwritten Arrow Doodle (SVG) -->
                        <div style="position: absolute; right: 10px; bottom: 8px; color: var(--ls-black); font-size: 1.8rem; transform: rotate(-25deg); opacity: 0.85;">
                            <i class="fas fa-arrow-turn-up"></i>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Right Card: Interactive Question Interface Preview (Matching Image 1 Top-Right) -->
            <div class="quiz-preview-card">
                <!-- Green Star Doodle on Margin -->
                <div style="position: absolute; right: -18px; top: 40%; color: var(--ls-green); font-size: 2.2rem; transform: rotate(15deg); user-select: none;">
                    ★
                </div>

                <!-- Question Header with Timer Badge -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1.5px solid #EBEBEA;">
                    <div style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 800; color: var(--ls-black);">
                        Question 1 / 10
                    </div>
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span class="badge badge-coral" style="font-size: 0.85rem; padding: 5px 12px;">
                            <i class="fas fa-clock"></i> 09:45
                        </span>
                        <button class="ls-icon-btn" style="width: 32px; height: 32px;" title="Options">
                            <i class="fas fa-ellipsis-vertical" style="font-size: 0.85rem;"></i>
                        </button>
                    </div>
                </div>

                <!-- Question Text -->
                <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--ls-black); line-height: 1.4; margin-bottom: 1.5rem;" id="previewQuestionText">
                    Which of the following is the time complexity of accessing an element in an array by index?
                </h3>

                <!-- Options List (Matching Reference Image 1) -->
                <div id="previewOptionsList">
                    <div class="preview-option-item selected" onclick="selectPreviewOption(this)">
                        <div class="preview-letter-badge">A</div>
                        <span style="font-size: 0.95rem; font-weight: 700;">O(1)</span>
                    </div>

                    <div class="preview-option-item" onclick="selectPreviewOption(this)">
                        <div class="preview-letter-badge">B</div>
                        <span style="font-size: 0.95rem; font-weight: 700;">O(n)</span>
                    </div>

                    <div class="preview-option-item" onclick="selectPreviewOption(this)">
                        <div class="preview-letter-badge">C</div>
                        <span style="font-size: 0.95rem; font-weight: 700;">O(log n)</span>
                    </div>

                    <div class="preview-option-item" onclick="selectPreviewOption(this)">
                        <div class="preview-letter-badge">D</div>
                        <span style="font-size: 0.95rem; font-weight: 700;">O(n log n)</span>
                    </div>
                </div>

                <!-- Navigation Controls (Matching Reference Image 1) -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; padding-top: 1.25rem; border-top: 1.5px solid #EBEBEA;">
                    <button type="button" class="btn btn-outline" onclick="alert('This is Question 1');">
                        <i class="fas fa-arrow-left"></i> Previous
                    </button>
                    <button type="button" class="btn btn-purple" onclick="document.getElementById('quizmakerForm').submit();">
                        <span>Start Active Quiz</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </main>

    <script>
        function setDifficulty(diff, btn) {
            document.querySelectorAll('.diff-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }

        function syncTopicField() {
            const subject = document.getElementById('subjectSelect').value;
            const topicInput = document.getElementById('topicInput');
            topicInput.value = subject;
        }

        function selectPreviewOption(elem) {
            document.querySelectorAll('.preview-option-item').forEach(el => el.classList.remove('selected'));
            elem.classList.add('selected');
        }

        // Handle form submit loading state
        document.getElementById('quizmakerForm').addEventListener('submit', function() {
            const btn = document.getElementById('generateQuizBtn');
            btn.disabled = true;
            btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> <span>Generating AI Questions...</span>`;
        });
    </script>

    <%- include('includes/footer') %>
</body>
</html>
