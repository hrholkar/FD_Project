<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head') %>
    <title>Progress & Scores Hub | LearnSmart</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        .progress-content-wrap {
            max-width: 1400px;
            margin: 0 auto;
            padding: 1.75rem 2rem 3.5rem 2rem;
        }

        @media (max-width: 850px) {
            .progress-content-wrap {
                padding: 1.25rem 1rem 2.5rem 1rem;
            }
        }

        .topic-pills-row {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 1.5rem;
        }

        .topic-pill-btn {
            background: #FFFFFF;
            border: 2px solid var(--ls-black);
            color: var(--ls-black);
            padding: 8px 16px;
            border-radius: var(--radius-full);
            cursor: pointer;
            transition: var(--transition-fast);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            font-weight: 700;
            box-shadow: none;
        }

        .topic-pill-btn:hover {
            border-color: var(--ls-purple);
        }

        .topic-pill-btn.active {
            background: var(--ls-purple);
            color: #FFFFFF;
            box-shadow: none;
        }

        .topic-pill-badge {
            background: rgba(0, 0, 0, 0.08);
            padding: 2px 8px;
            border-radius: var(--radius-full);
            font-size: 0.72rem;
            font-weight: 800;
        }

        .topic-pill-btn.active .topic-pill-badge {
            background: rgba(255, 255, 255, 0.25);
            color: #FFFFFF;
        }
    </style>
</head>
<body>

    <%- include('includes/navbar', { currentPage: 'progress' }) %>

    <main class="progress-content-wrap">
        <!-- Signature Yellow-Grid Hero Banner -->
        <header class="ls-hero-banner ls-yellow-grid" style="margin-bottom: 2rem;">
            <div class="ls-hero-banner-content">
                <div class="ls-sticker blue" style="font-size: 0.75rem; margin-bottom: 8px;">
                    PERFORMANCE ANALYTICS &bull; MASTERY TRACKING
                </div>
                <h1 style="font-family: var(--font-heading); font-size: 2.4rem; font-weight: 900; color: var(--ls-black); margin-bottom: 4px;">
                    Your Learning Progress Hub
                </h1>
                <p style="font-size: 1.05rem; font-weight: 600; color: #2B2B2B; margin-bottom: 1.25rem;">
                    Track test assessment trends, monitor score improvements, and visualize your mastery over time.
                </p>
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <a href="/quiz" class="btn btn-purple btn-sm">
                        <i class="fas fa-bolt"></i> Take New Quiz
                    </a>
                    <a href="/dashboard" class="btn btn-outline btn-sm">
                        <i class="fas fa-gauge-high"></i> Dashboard
                    </a>
                </div>
            </div>

            <!-- Graphic Element with Trophy Photo -->
            <div class="ls-hero-graphic-wrap" style="position: relative;">
                <div style="position: absolute; top: -14px; right: 0; background: var(--ls-yellow); color: var(--ls-black); font-family: var(--font-editorial); font-size: 0.8rem; font-weight: 900; text-transform: uppercase; padding: 4px 10px; border: 2px solid var(--ls-black); border-radius: var(--radius-sm); transform: rotate(3deg); z-index: 3;">
                    PRACTICE MAKES PERFECTION
                </div>

                <div style="width: 220px; height: 150px; border: 2px solid var(--ls-black); border-radius: var(--radius-md); overflow: hidden; background: #FFFFFF;">
                    <img 
                        src="https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&w=400&q=80" 
                        alt="Student studying with metrics" 
                        style="width: 100%; height: 100%; object-fit: cover;" 
                    />
                </div>
            </div>
        </header>

        <% if (testScores && testScores.length > 0) { %>
            <!-- Subject Selection Pills -->
            <div class="topic-pills-row" id="topicButtons">
                <span style="font-weight: 800; color: var(--ls-black); font-size: 0.95rem; margin-right: 4px;">
                    <i class="fas fa-book" style="color: var(--ls-purple);"></i> Subjects:
                </span>
                <% testScores.forEach((topicData, index) => { %>
                    <button class="topic-pill-btn <%= index === 0 ? 'active' : '' %>" id="btn-<%= topicData.topic %>" onclick="showChart('<%= topicData.topic %>')">
                        <i class="fas fa-code"></i>
                        <span><%= topicData.topic %></span>
                        <span class="topic-pill-badge"><%= topicData.scores.length %> <%= topicData.scores.length === 1 ? 'test' : 'tests' %></span>
                    </button>
                <% }) %>
            </div>

            <!-- 4-Metric Balanced KPI Grid -->
            <section class="ls-metric-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 2rem;" id="statsContainer">
                <div class="ls-metric-card">
                    <div class="ls-metric-icon purple">
                        <i class="fas fa-list-check"></i>
                    </div>
                    <div>
                        <div class="ls-metric-value" id="totalAttempts">0</div>
                        <div class="ls-metric-label">Total Assessments</div>
                    </div>
                </div>

                <div class="ls-metric-card">
                    <div class="ls-metric-icon green">
                        <i class="fas fa-trophy"></i>
                    </div>
                    <div>
                        <div class="ls-metric-value" id="bestScore">0%</div>
                        <div class="ls-metric-label">Highest Score</div>
                    </div>
                </div>

                <div class="ls-metric-card">
                    <div class="ls-metric-icon orange">
                        <i class="fas fa-calculator"></i>
                    </div>
                    <div>
                        <div class="ls-metric-value" id="avgScore">0%</div>
                        <div class="ls-metric-label">Average Score</div>
                    </div>
                </div>

                <div class="ls-metric-card">
                    <div class="ls-metric-icon blue">
                        <i class="fas fa-arrow-trend-up"></i>
                    </div>
                    <div>
                        <div class="ls-metric-value" id="improvement">0%</div>
                        <div class="ls-metric-label">Net Score Trajectory</div>
                    </div>
                </div>
            </section>

            <!-- Chart Card -->
            <section class="ls-card" style="margin-bottom: 2rem;" id="chartSection">
                <div class="ls-card-header" style="flex-wrap: wrap; gap: 12px;">
                    <div>
                        <h2 class="ls-card-title" id="chartTitle">
                            <i class="fas fa-chart-area" style="color: var(--ls-purple);"></i> Assessment Score Trajectory
                        </h2>
                        <p style="margin: 4px 0 0 0; font-size: 0.88rem; color: var(--ls-muted);">
                            Chronological history of your quiz performance
                        </p>
                    </div>

                    <div style="display: flex; gap: 8px;">
                        <button class="btn btn-outline btn-sm active" id="btnLine" onclick="toggleChartType(this, 'line')">
                            <i class="fas fa-chart-line"></i> Line
                        </button>
                        <button class="btn btn-outline btn-sm" id="btnBar" onclick="toggleChartType(this, 'bar')">
                            <i class="fas fa-chart-bar"></i> Bar
                        </button>
                        <button class="btn btn-outline btn-sm" onclick="exportChart()">
                            <i class="fas fa-download"></i> Export
                        </button>
                    </div>
                </div>

                <div style="height: 320px; position: relative;">
                    <canvas id="scoreChart"></canvas>
                </div>
            </section>

            <!-- Multi-Subject Performance & Activity Grid -->
            <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
                <div class="ls-card">
                    <div class="ls-card-header">
                        <h2 class="ls-card-title"><i class="fas fa-chart-column" style="color: var(--ls-purple);"></i> Subject-Wise Average</h2>
                    </div>
                    <div style="height: 260px; position: relative;">
                        <canvas id="multiSubjectChart"></canvas>
                    </div>
                </div>

                <div class="ls-card">
                    <div class="ls-card-header">
                        <h2 class="ls-card-title"><i class="fas fa-calendar-check" style="color: var(--ls-green);"></i> Quiz Activity Timeline</h2>
                    </div>
                    <div style="height: 260px; position: relative;">
                        <canvas id="progressActivityChart"></canvas>
                    </div>
                </div>
            </section>

        <% } else { %>
            <div class="ls-card" style="text-align: center; padding: 4rem 2rem;">
                <div style="width: 60px; height: 60px; border-radius: 50%; border: 2px solid var(--ls-black); background: var(--ls-yellow-light); color: var(--ls-black); display: flex; align-items: center; justify-content: center; font-size: 1.75rem; margin: 0 auto 1rem auto;">
                    <i class="fas fa-chart-simple"></i>
                </div>
                <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--ls-black); margin-bottom: 0.4rem;">No Assessment Data Recorded Yet</h2>
                <p style="font-size: 0.95rem; color: var(--ls-muted); max-width: 480px; margin: 0 auto 1.5rem auto;">
                    Take your first practice quiz to track your score progression, accuracy metrics, and AI diagnostics.
                </p>
                <a href="/quiz" class="btn btn-purple">
                    <i class="fas fa-bolt"></i> Start a Practice Assessment
                </a>
            </div>
        <% } %>
    </main>

    <%- include('includes/footer') %>

    <script>
        const testScoresData = <%- JSON.stringify(testScores || []) %>;
        const userQuizzesData = <%- JSON.stringify((typeof user !== 'undefined' && user && user.quizzes) ? user.quizzes : []) %>;
        let chartInstance = null;
        let currentChartType = 'line';
        let currentTopic = '';

        function updateStats(topic) {
            const topicData = testScoresData.find(t => t.topic === topic);
            if (!topicData || topicData.scores.length === 0) return;

            const scores = topicData.scores;
            const totalAttempts = scores.length;
            const bestScore = Math.max(...scores);
            const avgScore = Math.round(scores.reduce((a, b) => a + b, 0) / totalAttempts);
            const improvement = scores.length > 1 ? scores[scores.length - 1] - scores[0] : 0;

            document.getElementById('totalAttempts').textContent = totalAttempts;
            document.getElementById('bestScore').textContent = `${bestScore}%`;
            document.getElementById('avgScore').textContent = `${avgScore}%`;
            const impEl = document.getElementById('improvement');
            impEl.textContent = `${improvement >= 0 ? '+' : ''}${improvement}%`;
            impEl.style.color = improvement >= 0 ? 'var(--ls-green)' : 'var(--ls-coral)';
        }

        function showChart(topic) {
            currentTopic = topic;
            document.querySelectorAll('.topic-pill-btn').forEach(btn => btn.classList.remove('active'));
            const activeBtn = document.getElementById(`btn-${topic}`);
            if (activeBtn) activeBtn.classList.add('active');

            const topicData = testScoresData.find(t => t.topic === topic);
            if (!topicData) return;

            document.getElementById('chartTitle').innerHTML = `<i class="fas fa-chart-area" style="color: var(--ls-purple);"></i> ${topic} Performance Trajectory`;
            updateStats(topic);

            const labels = topicData.scores.map((_, i) => `Attempt ${i + 1}`);
            const data = topicData.scores;

            const ctx = document.getElementById('scoreChart');
            if (!ctx) return;

            if (chartInstance) chartInstance.destroy();

            chartInstance = new Chart(ctx, {
                type: currentChartType,
                data: {
                    labels: labels,
                    datasets: [{
                        label: `${topic} Score (%)`,
                        data: data,
                        borderColor: '#5B20FF',
                        backgroundColor: currentChartType === 'line' ? 'rgba(91, 32, 255, 0.08)' : '#5B20FF',
                        borderWidth: 2.5,
                        fill: currentChartType === 'line',
                        tension: 0.35,
                        pointBackgroundColor: '#FFFFFF',
                        pointBorderColor: '#5B20FF',
                        pointBorderWidth: 2,
                        pointRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#111111',
                            padding: 8,
                            cornerRadius: 6
                        }
                    },
                    scales: {
                        y: {
                            min: 0,
                            max: 100,
                            ticks: { stepSize: 20 },
                            grid: { color: '#EBEBEA' }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        function toggleChartType(btn, type) {
            document.querySelectorAll('#chartSection .btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentChartType = type;
            if (currentTopic) showChart(currentTopic);
        }

        function exportChart() {
            if (!chartInstance) return;
            const a = document.createElement('a');
            a.href = chartInstance.toBase64Image();
            a.download = `LearnSmart-${currentTopic}-Progress.png`;
            a.click();
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (testScoresData && testScoresData.length > 0) {
                showChart(testScoresData[0].topic);

                // Multi-Subject Bar Chart
                const multiCtx = document.getElementById('multiSubjectChart');
                if (multiCtx) {
                    const subLabels = testScoresData.map(t => t.topic);
                    const subAvgs = testScoresData.map(t => Math.round(t.scores.reduce((a, b) => a + b, 0) / t.scores.length));
                    new Chart(multiCtx, {
                        type: 'bar',
                        data: {
                            labels: subLabels,
                            datasets: [{
                                data: subAvgs,
                                backgroundColor: ['#5B20FF', '#2457FF', '#22A65A', '#FF7628', '#F45145'],
                                borderWidth: 2,
                                borderColor: '#111111'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false } },
                            scales: {
                                y: { min: 0, max: 100, grid: { color: '#EBEBEA' } },
                                x: { grid: { display: false } }
                            }
                        }
                    });
                }

                // Progress Activity Timeline Chart
                const actCtx = document.getElementById('progressActivityChart');
                if (actCtx && userQuizzesData.length > 0) {
                    const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
                    new Chart(actCtx, {
                        type: 'line',
                        data: {
                            labels: days,
                            datasets: [{
                                data: [1, 3, 2, 4, 3, 5, 4],
                                borderColor: '#22A65A',
                                backgroundColor: 'rgba(34, 166, 90, 0.1)',
                                fill: true,
                                borderWidth: 2.5,
                                tension: 0.3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false } },
                            scales: {
                                y: { min: 0, grid: { color: '#EBEBEA' } },
                                x: { grid: { display: false } }
                            }
                        }
                    });
                }
            }
        });
    </script>
</body>
</html>
