<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head') %>
    <title>Progress & Scores Hub | LearnSmart</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .topic-pills-row {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 2rem;
        }

        .topic-pill-btn {
            background: white;
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 10px 18px;
            border-radius: var(--radius-full);
            cursor: pointer;
            transition: var(--transition-fast);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.92rem;
            font-weight: 600;
            box-shadow: var(--shadow-xs);
        }

        .topic-pill-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: var(--primary-light);
            transform: translateY(-1px);
        }

        .topic-pill-btn.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
        }

        .topic-pill-badge {
            background: rgba(0, 0, 0, 0.08);
            padding: 2px 8px;
            border-radius: var(--radius-full);
            font-size: 0.75rem;
            font-weight: 700;
        }

        .topic-pill-btn.active .topic-pill-badge {
            background: rgba(255, 255, 255, 0.25);
            color: white;
        }

        .stats-grid-4 {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.25rem;
            margin-bottom: 2rem;
        }

        @media (max-width: 1024px) {
            .stats-grid-4 {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {
            .stats-grid-4 {
                grid-template-columns: 1fr;
            }
        }

        .stat-card-kpi {
            background: white;
            border-radius: var(--radius-md);
            padding: 1.5rem;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: center;
            gap: 1.25rem;
            transition: var(--transition-fast);
        }

        .stat-card-kpi:hover {
            box-shadow: var(--shadow-md);
            border-color: #cbd5e1;
        }

        .stat-icon-wrap {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .stat-icon-wrap.primary { background: var(--primary-light); color: var(--primary); }
        .stat-icon-wrap.success { background: var(--success-light); color: var(--success); }
        .stat-icon-wrap.warning { background: var(--warning-light); color: var(--warning); }
        .stat-icon-wrap.secondary { background: var(--secondary-light); color: var(--secondary); }

        .stat-info-wrap .stat-num {
            font-family: var(--font-heading);
            font-size: 1.85rem;
            font-weight: 800;
            color: var(--text-main);
            line-height: 1.1;
        }

        .stat-info-wrap .stat-label {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 600;
            margin-top: 2px;
        }

        .chart-box {
            position: relative;
            height: 380px;
            width: 100%;
        }

        .chart-btn-group {
            display: flex;
            gap: 6px;
        }
    </style>
</head>
<body>

    <%- include('includes/navbar', { currentPage: 'progress' }) %>

    <main class="ls-page-wrap">
        <!-- Hero Header -->
        <header class="ls-hero">
            <div>
                <div class="ls-pill-tag"><i class="fas fa-chart-line"></i> Performance Analytics</div>
                <h1>Your Learning Progress Hub</h1>
                <p>Track test assessment trends, monitor score improvements, and visualize your mastery over time.</p>
            </div>
            <div style="display: flex; gap: 10px;">
                <a href="/quiz" class="btn btn-primary" style="background: white; color: var(--primary) !important;">
                    <i class="fas fa-bolt"></i> Take New Quiz
                </a>
                <a href="/dashboard" class="btn btn-outline" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.25); color: white;">
                    <i class="fas fa-gauge-high"></i> Dashboard
                </a>
            </div>
        </header>

        <% if (testScores && testScores.length > 0) { %>
            <!-- Subject Selection Pills -->
            <div class="topic-pills-row" id="topicButtons">
                <span style="font-weight: 700; color: var(--text-main); font-size: 0.92rem; margin-right: 4px;">
                    <i class="fas fa-book text-primary"></i> Subjects:
                </span>
                <% testScores.forEach((topicData, index) => { %>
                    <button class="topic-pill-btn <%= index === 0 ? 'active' : '' %>" id="btn-<%= topicData.topic %>" onclick="showChart('<%= topicData.topic %>')">
                        <i class="fas fa-code"></i>
                        <span><%= topicData.topic %></span>
                        <span class="topic-pill-badge"><%= topicData.scores.length %> <%= topicData.scores.length === 1 ? 'test' : 'tests' %></span>
                    </button>
                <% }) %>
            </div>

            <!-- 4-Metric Balanced KPI Grid -->
            <section class="stats-grid-4" id="statsContainer">
                <div class="stat-card-kpi">
                    <div class="stat-icon-wrap primary">
                        <i class="fas fa-list-check"></i>
                    </div>
                    <div class="stat-info-wrap">
                        <div class="stat-num" id="totalAttempts">0</div>
                        <div class="stat-label">Total Assessments</div>
                    </div>
                </div>

                <div class="stat-card-kpi">
                    <div class="stat-icon-wrap success">
                        <i class="fas fa-trophy"></i>
                    </div>
                    <div class="stat-info-wrap">
                        <div class="stat-num" id="bestScore">0</div>
                        <div class="stat-label">Highest Score</div>
                    </div>
                </div>

                <div class="stat-card-kpi">
                    <div class="stat-icon-wrap warning">
                        <i class="fas fa-calculator"></i>
                    </div>
                    <div class="stat-info-wrap">
                        <div class="stat-num" id="avgScore">0</div>
                        <div class="stat-label">Average Score</div>
                    </div>
                </div>

                <div class="stat-card-kpi">
                    <div class="stat-icon-wrap secondary">
                        <i class="fas fa-arrow-trend-up"></i>
                    </div>
                    <div class="stat-info-wrap">
                        <div class="stat-num" id="improvement">0</div>
                        <div class="stat-label">Net Score Trajectory</div>
                    </div>
                </div>
            </section>

            <!-- Chart Card -->
            <section class="ls-card mb-4" id="chartSection">
                <div class="ls-card-header">
                    <div>
                        <h2 class="ls-card-title" id="chartTitle">
                            <i class="fas fa-chart-area text-primary"></i> Assessment Score Trajectory
                        </h2>
                        <p style="margin: 4px 0 0 0; font-size: 0.88rem; color: var(--text-muted);">
                            Chronological history of your quiz performance
                        </p>
                    </div>

                    <div class="chart-btn-group">
                        <button class="btn btn-outline btn-sm" id="btnLine" onclick="toggleChartType(this, 'line')">
                            <i class="fas fa-chart-line"></i> Line
                        </button>
                        <button class="btn btn-outline btn-sm" id="btnBar" onclick="toggleChartType(this, 'bar')">
                            <i class="fas fa-chart-bar"></i> Bar
                        </button>
                        <button class="btn btn-outline btn-sm" onclick="exportChart()">
                            <i class="fas fa-download"></i> Export
                        </button>
                    </div>
                </div>

                <div class="chart-box">
                    <canvas id="scoreChart"></canvas>
                </div>
            </section>

            <!-- Multi-Subject Performance & Activity Grid -->
            <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
                <!-- Multi-Subject Bar Chart -->
                <div class="ls-card">
                    <div class="ls-card-header">
                        <h2 class="ls-card-title"><i class="fas fa-chart-column text-primary"></i> Subject-Wise Average Performance</h2>
                    </div>
                    <div style="height: 280px; position: relative;">
                        <canvas id="multiSubjectChart"></canvas>
                    </div>
                </div>

                <!-- Activity Timeline Chart -->
                <div class="ls-card">
                    <div class="ls-card-header">
                        <h2 class="ls-card-title"><i class="fas fa-calendar-check text-primary"></i> Quiz Activity Timeline</h2>
                    </div>
                    <div style="height: 280px; position: relative;">
                        <canvas id="progressActivityChart"></canvas>
                    </div>
                </div>
            </section>

        <% } else { %>
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-chart-simple"></i>
                </div>
                <h2 class="empty-state-title">No Assessment Progress Data Yet</h2>
                <p class="empty-state-desc">You haven't completed any quizzes yet. Complete your first practice assessment to track performance analytics, score growth, and customized learning insights.</p>
                <a href="/quiz" class="btn btn-primary">
                    <i class="fas fa-bolt"></i> Start a Practice Assessment
                </a>
            </div>
        <% } %>
    </main>

    <%- include('includes/footer') %>

    <script>
        const testScoresData = <%- JSON.stringify(testScores || []) %>;
        const userQuizzesData = <%- JSON.stringify((typeof user !== 'undefined' && user && user.quizzes) ? user.quizzes : []) %>;
        let chartInstance = null;
        let currentChartType = 'line';
        let currentTopic = '';

        function updateStats(topic) {
            const topicData = testScoresData.find(t => t.topic === topic);
            if (!topicData || topicData.scores.length === 0) return;

            const scores = topicData.scores;
            const totalAttempts = scores.length;
            const bestScore = Math.max(...scores);
            const avgScore = scores.reduce((sum, score) => sum + score, 0) / scores.length;
            const improvement = scores.length > 1 ? (scores[scores.length - 1] - scores[0]) : 0;
            
            document.getElementById('totalAttempts').textContent = totalAttempts;
            document.getElementById('bestScore').textContent = `${bestScore}`;
            document.getElementById('avgScore').textContent = `${avgScore.toFixed(1)}`;
            
            const improvementEl = document.getElementById('improvement');
            if (improvement > 0) {
                improvementEl.textContent = `+${improvement.toFixed(1)}`;
                improvementEl.style.color = 'var(--success)';
            } else if (improvement < 0) {
                improvementEl.textContent = `${improvement.toFixed(1)}`;
                improvementEl.style.color = 'var(--danger)';
            } else {
                improvementEl.textContent = '0';
                improvementEl.style.color = 'var(--text-muted)';
            }
        }

        function createChart(topic, type) {
            const topicData = testScoresData.find(t => t.topic === topic);
            if (!topicData) return;

            const scores = topicData.scores;
            const labels = scores.map((_, i) => `Attempt ${i + 1}`);
            const ctx = document.getElementById("scoreChart").getContext("2d");

            if (chartInstance) chartInstance.destroy();

            const gradient = ctx.createLinearGradient(0, 0, 0, 350);
            gradient.addColorStop(0, 'rgba(67, 97, 238, 0.28)');
            gradient.addColorStop(1, 'rgba(67, 97, 238, 0.01)');

            chartInstance = new Chart(ctx, {
                type: type,
                data: {
                    labels: labels,
                    datasets: [{
                        label: `${topic} Assessment Score`,
                        data: scores,
                        borderColor: '#4361ee',
                        backgroundColor: type === 'line' ? gradient : '#4361ee',
                        fill: type === 'line',
                        tension: 0.35,
                        pointRadius: 6,
                        pointHoverRadius: 8,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#4361ee',
                        pointBorderWidth: 2.5,
                        borderWidth: 3,
                        borderRadius: type === 'bar' ? 8 : 0,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { intersect: false, mode: 'index' },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleFont: { size: 13, family: 'Outfit', weight: '700' },
                            bodyFont: { size: 12, family: 'Inter' },
                            padding: 12,
                            cornerRadius: 8,
                            displayColors: false,
                            callbacks: {
                                label: (ctx) => `Score: ${ctx.parsed.y} points`
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: Math.max(10, Math.max(...scores) + 2),
                            grid: { color: '#f1f5f9' },
                            ticks: { 
                                color: '#64748b',
                                font: { family: 'Inter' }
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { 
                                color: '#64748b',
                                font: { family: 'Inter' }
                            }
                        }
                    }
                }
            });
        }

        function showChart(topic) {
            currentTopic = topic;
            document.querySelectorAll('.topic-pill-btn').forEach(btn => btn.classList.remove('active'));
            const activeBtn = document.getElementById(`btn-${topic}`);
            if (activeBtn) activeBtn.classList.add('active');
            
            updateStats(topic);
            const titleEl = document.getElementById('chartTitle');
            if (titleEl) {
                titleEl.innerHTML = `<i class="fas fa-chart-area text-primary"></i> ${topic} Score Progression`;
            }
            createChart(topic, currentChartType);
        }

        function toggleChartType(button, type) {
            currentChartType = type;
            document.querySelectorAll('.chart-btn-group .btn').forEach(btn => btn.classList.remove('btn-primary'));
            button.classList.add('btn-primary');
            if (currentTopic) {
                createChart(currentTopic, type);
            }
        }

        function exportChart() {
            if (chartInstance) {
                const link = document.createElement('a');
                const safeTopic = currentTopic.replace(/[^a-z0-9]/gi, '_').toLowerCase();
                link.download = `LearnSmart-Progress-${safeTopic}.png`;
                link.href = chartInstance.toBase64Image();
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }
        }

        // Initialize automatically on page load
        document.addEventListener('DOMContentLoaded', function() {
            if (testScoresData.length > 0) {
                showChart(testScoresData[0].topic);
            }

            // Multi-Subject Performance Comparison Bar Chart
            const multiCtx = document.getElementById('multiSubjectChart');
            if (multiCtx && testScoresData.length > 0) {
                const topics = testScoresData.map(t => t.topic);
                const averages = testScoresData.map(t => {
                    return t.scores.length > 0 ? (t.scores.reduce((a, b) => a + b, 0) / t.scores.length).toFixed(1) : 0;
                });
                const colors = ['#4361ee', '#7209b7', '#10b981', '#f59e0b', '#06b6d4', '#ec4899'];
                new Chart(multiCtx, {
                    type: 'bar',
                    data: {
                        labels: topics,
                        datasets: [{
                            label: 'Average Score',
                            data: averages,
                            backgroundColor: topics.map((_, i) => colors[i % colors.length]),
                            borderRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            // Activity Timeline Chart
            const actCtx = document.getElementById('progressActivityChart');
            if (actCtx) {
                const activityMap = {};
                userQuizzesData.forEach(q => {
                    const d = q.date ? new Date(q.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : 'Recent';
                    activityMap[d] = (activityMap[d] || 0) + 1;
                });
                const dates = Object.keys(activityMap);
                const counts = Object.values(activityMap);
                new Chart(actCtx, {
                    type: 'line',
                    data: {
                        labels: dates.length > 0 ? dates : ['Recent'],
                        datasets: [{
                            label: 'Quizzes Taken',
                            data: counts.length > 0 ? counts : [testScoresData.reduce((acc, t) => acc + t.scores.length, 0)],
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.1)',
                            fill: true,
                            tension: 0.35,
                            pointRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f1f5f9' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }
        });
    </script>
</body>
</html>