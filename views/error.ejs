<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head') %>
    <title><%= typeof title !== 'undefined' ? title : 'Notice' %> | LearnSmart</title>
</head>
<body>

    <%- include('includes/navbar') %>

    <main class="ls-page-wrap-narrow" style="display: flex; align-items: center; justify-content: center; min-height: 65vh; padding: 3rem 1.5rem;">
        <div class="ls-card" style="max-width: 580px; width: 100%; text-align: center; padding: 3rem 2.25rem;">
            <div style="width: 72px; height: 72px; border-radius: 50%; border: 2px solid var(--ls-black); background: var(--ls-yellow-light); color: var(--ls-black); display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 1.5rem auto;">
                <i class="fas fa-triangle-exclamation"></i>
            </div>
            
            <h1 style="font-family: var(--font-heading); font-size: 1.85rem; font-weight: 900; color: var(--ls-black); margin-bottom: 0.75rem;">
                <%= typeof title !== 'undefined' ? title : 'Platform Notice' %>
            </h1>
            
            <p style="color: var(--ls-muted); font-size: 1rem; line-height: 1.6; margin-bottom: 2rem;">
                <%= typeof message !== 'undefined' ? message : 'Something went wrong while processing your request. Please return to your learning dashboard.' %>
            </p>
            
            <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
                <a href="/dashboard" class="btn btn-purple">
                    <i class="fas fa-gauge-high"></i> Student Dashboard
                </a>
                <a href="/quiz" class="btn btn-outline">
                    <i class="fas fa-bolt"></i> Practice Quiz
                </a>
                <a href="/" class="btn btn-outline">
                    <i class="fas fa-house"></i> Home
                </a>
            </div>
        </div>
    </main>

    <%- include('includes/footer') %>

</body>
</html>
