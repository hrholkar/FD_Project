<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head') %>
    <title><%= typeof title !== 'undefined' ? title : 'Notice' %> | LearnSmart</title>
</head>
<body>

    <%- include('includes/navbar') %>

    <main class="ls-page-wrap-narrow" style="display: flex; align-items: center; justify-content: center; min-height: 60vh;">
        <div class="ls-card" style="max-width: 580px; width: 100%; text-align: center; padding: 3rem 2rem;">
            <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 1.5rem auto;">
                <i class="fas fa-circle-info"></i>
            </div>
            
            <h1 style="font-family: var(--font-heading); font-size: 1.75rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.75rem;">
                <%= typeof title !== 'undefined' ? title : 'Learning Engine Notice' %>
            </h1>
            
            <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6; margin-bottom: 2rem;">
                <%= typeof message !== 'undefined' ? message : 'Something went wrong while processing your request. Please try again or explore our other learning tools.' %>
            </p>
            
            <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
                <a href="/quiz" class="btn btn-primary">
                    <i class="fas fa-rotate-right"></i> Try Quiz Again
                </a>
                <a href="/dashboard" class="btn btn-outline">
                    <i class="fas fa-gauge-high"></i> Go to Dashboard
                </a>
                <a href="/" class="btn btn-outline">
                    <i class="fas fa-house"></i> Home
                </a>
            </div>
        </div>
    </main>

    <%- include('includes/footer') %>

</body>
</html>
