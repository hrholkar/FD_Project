<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head') %>
    <title>AI Interview Preparation | LearnSmart</title>
    <style>
        .interview-content-wrap {
            max-width: 1400px;
            margin: 0 auto;
            padding: 1.75rem 2rem 3.5rem 2rem;
        }

        @media (max-width: 850px) {
            .interview-content-wrap {
                padding: 1.25rem 1rem 2.5rem 1rem;
            }
        }

        .interview-grid {
            display: grid;
            grid-template-columns: 360px 1fr;
            gap: 1.75rem;
            align-items: start;
        }

        @media (max-width: 1024px) {
            .interview-grid {
                grid-template-columns: 1fr;
            }
        }

        .config-card {
            background: #FFFFFF;
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-md);
            padding: 1.75rem;
            box-shadow: none;
            position: sticky;
            top: 85px;
        }

        .config-title {
            font-family: var(--font-heading);
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--ls-black);
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 10px;
            padding-bottom: 0.75rem;
            border-bottom: 1.5px solid #EBEBEA;
        }

        .practice-arena {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .question-header-card {
            background: #FFFFFF;
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-md);
            padding: 1.75rem;
            box-shadow: none;
            position: relative;
        }

        .progress-bar-wrap {
            height: 8px;
            background: #EBEBEA;
            border: 1px solid var(--ls-black);
            border-radius: var(--radius-full);
            overflow: hidden;
            margin-bottom: 1.25rem;
        }

        .progress-bar-fill {
            height: 100%;
            background: var(--ls-purple);
            border-radius: var(--radius-full);
            transition: width 0.3s ease;
        }

        .q-meta-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
            flex-wrap: wrap;
            gap: 10px;
        }

        .q-badges-group {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        .q-text {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--ls-black);
            line-height: 1.45;
            margin-bottom: 1rem;
        }

        .q-context-hint {
            background: var(--ls-yellow-subtle);
            border: 1.5px solid var(--ls-black);
            border-radius: var(--radius-sm);
            padding: 10px 14px;
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--ls-black);
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 1.25rem;
        }

        .q-nav-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 1.25rem;
            border-top: 1.5px solid #EBEBEA;
            flex-wrap: wrap;
            gap: 10px;
        }

        .answer-workspace-card {
            background: #FFFFFF;
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-md);
            padding: 1.75rem;
            box-shadow: none;
        }

        .audio-recorder-bar {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            border-radius: var(--radius-sm);
            background: #F8F8F6;
            border: 1.5px solid var(--ls-black);
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }

        .record-btn {
            background: var(--ls-coral);
            color: white;
            border: 1.5px solid var(--ls-black);
            border-radius: var(--radius-full);
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: none;
            transition: var(--transition-fast);
        }

        .record-btn.recording {
            animation: pulse-coral 1s infinite;
        }

        @keyframes pulse-coral {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        .eval-result-card {
            background: #FFFFFF;
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-md);
            padding: 1.75rem;
            box-shadow: none;
            border-left: 8px solid var(--ls-purple);
        }

        .score-circle-badge {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            border: 2px solid var(--ls-black);
            background: var(--ls-purple);
            color: #FFFFFF;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-family: var(--font-heading);
            font-weight: 900;
            box-shadow: none;
            flex-shrink: 0;
        }

        .feedback-pill-card {
            border: 1.5px solid var(--ls-black);
            border-radius: var(--radius-sm);
            padding: 12px 14px;
            margin-bottom: 10px;
        }

        .feedback-pill-card.strengths {
            background: var(--ls-green-light);
            border-color: var(--ls-green);
        }

        .feedback-pill-card.weaknesses {
            background: var(--ls-coral-light);
            border-color: var(--ls-coral);
        }

        .feedback-pill-card.model-ans {
            background: var(--ls-blue-light);
            border-color: var(--ls-blue);
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(17, 17, 17, 0.75);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1050;
            padding: 1.5rem;
        }

        .modal-box {
            background: #FFFFFF;
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-lg);
            box-shadow: none;
            max-width: 650px;
            width: 100%;
            max-height: 85vh;
            overflow-y: auto;
            padding: 2rem;
        }

        .history-session-card {
            background: #FFFFFF;
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-sm);
            padding: 14px 16px;
            box-shadow: none;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }
    </style>
</head>
<body>

    <%- include('includes/navbar', { currentPage: 'interview' }) %>

    <main class="interview-content-wrap">
        <!-- Signature Yellow-Grid Hero Banner -->
        <header class="ls-hero-banner ls-yellow-grid" style="margin-bottom: 2rem;">
            <div class="ls-hero-banner-content">
                <div class="ls-sticker purple" style="font-size: 0.75rem; margin-bottom: 8px;">
                    CAREER SUITE &bull; AI MOCK ARENA
                </div>
                <h1 style="font-family: var(--font-heading); font-size: 2.4rem; font-weight: 900; color: var(--ls-black); margin-bottom: 4px;">
                    AI Interview Preparation &amp; Practice
                </h1>
                <p style="font-size: 1.05rem; font-weight: 600; color: #2B2B2B; margin-bottom: 1.25rem;">
                    Practice technical and behavioral interview questions with real-time AI scoring, feedback, and model answers.
                </p>
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <button type="button" onclick="showHistoryModal()" class="btn btn-outline btn-sm">
                        <i class="fas fa-clock-rotate-left"></i> Saved Sessions
                    </button>
                    <a href="/quiz" class="btn btn-purple btn-sm">
                        <i class="fas fa-bolt"></i> Quiz Hub
                    </a>
                </div>
            </div>

            <!-- Graphic Element with Microphone Photo -->
            <div class="ls-hero-graphic-wrap" style="position: relative;">
                <div style="position: absolute; top: -14px; right: 0; background: var(--ls-yellow); color: var(--ls-black); font-family: var(--font-editorial); font-size: 0.8rem; font-weight: 900; text-transform: uppercase; padding: 4px 10px; border: 2px solid var(--ls-black); border-radius: var(--radius-sm); transform: rotate(3deg); z-index: 3;">
                    CONFIDENCE &bull; CLARITY &bull; IMPACT
                </div>

                <div style="width: 220px; height: 150px; border: 2px solid var(--ls-black); border-radius: var(--radius-md); overflow: hidden; background: #FFFFFF;">
                    <img 
                        src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=400&q=80" 
                        alt="Professional candidate in mock interview" 
                        style="width: 100%; height: 100%; object-fit: cover;" 
                    />
                </div>
            </div>
        </header>

        <div class="interview-grid">
            <!-- Left Column: Generator Configuration Card -->
            <aside>
                <div class="config-card">
                    <h2 class="config-title">
                        <i class="fas fa-sliders" style="color: var(--ls-purple);"></i> Setup Interview
                    </h2>

                    <form id="interviewConfigForm" onsubmit="handleGenerate(event)">
                        <!-- Domain -->
                        <div class="form-group">
                            <label class="form-label" for="domainSelect">
                                <i class="fas fa-layer-group" style="color: var(--ls-purple); margin-right: 4px;"></i> Technical Domain
                            </label>
                            <select id="domainSelect" class="form-select" onchange="toggleCustomDomain(this.value)">
                                <option value="Frontend Development">Frontend Development</option>
                                <option value="Backend Development">Backend Development</option>
                                <option value="Full-Stack Development" selected>Full-Stack Development</option>
                                <option value="React JS">React JS</option>
                                <option value="Node.js and Express.js">Node.js &amp; Express.js</option>
                                <option value="MongoDB and SQL">MongoDB &amp; SQL Databases</option>
                                <option value="Java">Java (Core, Spring, JVM)</option>
                                <option value="Python">Python (Core, Django, OOP)</option>
                                <option value="Data Structures and Algorithms">Data Structures &amp; Algorithms</option>
                                <option value="AI and Machine Learning">AI &amp; Machine Learning</option>
                                <option value="HR and Behavioral Interviews">HR &amp; Behavioral Interviews</option>
                                <option value="custom">Custom Specialization...</option>
                            </select>
                        </div>

                        <!-- Custom Domain Input -->
                        <div class="form-group" id="customDomainGroup" style="display: none;">
                            <label class="form-label" for="customDomainInput">
                                Enter Custom Technology / Domain
                            </label>
                            <input type="text" id="customDomainInput" class="form-control" placeholder="e.g. DevOps &amp; Kubernetes, Golang">
                        </div>

                        <!-- Difficulty -->
                        <div class="form-group">
                            <label class="form-label" for="difficultySelect">
                                <i class="fas fa-signal" style="color: var(--ls-blue); margin-right: 4px;"></i> Difficulty Level
                            </label>
                            <select id="difficultySelect" class="form-select">
                                <option value="Beginner">Beginner (Entry / Junior)</option>
                                <option value="Intermediate" selected>Intermediate (Mid-Level)</option>
                                <option value="Advanced">Advanced (Senior / Staff)</option>
                            </select>
                        </div>

                        <!-- Interview Type -->
                        <div class="form-group">
                            <label class="form-label" for="typeSelect">
                                <i class="fas fa-briefcase" style="color: var(--ls-orange); margin-right: 4px;"></i> Interview Type
                            </label>
                            <select id="typeSelect" class="form-select">
                                <option value="Technical interview" selected>Technical interview</option>
                                <option value="Coding interview">Coding interview</option>
                                <option value="HR interview">HR &amp; Behavioral interview</option>
                                <option value="Project-based interview">Project-based interview</option>
                                <option value="Mixed interview">Mixed interview</option>
                            </select>
                        </div>

                        <!-- Question Count -->
                        <div class="form-group">
                            <label class="form-label" for="countSelect">
                                <i class="fas fa-list-ol" style="color: var(--ls-green); margin-right: 4px;"></i> Number of Questions
                            </label>
                            <select id="countSelect" class="form-select">
                                <option value="5" selected>5 Questions</option>
                                <option value="10">10 Questions</option>
                                <option value="15">15 Questions</option>
                            </select>
                        </div>

                        <!-- Optional Context -->
                        <div class="form-group">
                            <label class="form-label" for="contextInput">
                                Target Role / Context <span style="font-weight: 400; color: var(--ls-muted);">(Optional)</span>
                            </label>
                            <textarea id="contextInput" class="form-control" rows="3" placeholder="e.g. SDE-1 position at high-scale tech company, focus on system design and APIs"></textarea>
                        </div>

                        <button type="submit" id="btnGenerate" class="btn btn-purple" style="width: 100%; padding: 12px; font-size: 1rem;">
                            <i class="fas fa-wand-magic-sparkles"></i>
                            <span>Generate Questions</span>
                        </button>
                    </form>
                </div>
            </aside>

            <!-- Right Column: Interactive Practice Arena -->
            <section class="practice-arena">
                <!-- Initial Empty State -->
                <div id="arenaEmptyState" class="ls-card" style="text-align: center; padding: 4rem 2rem;">
                    <div style="width: 64px; height: 64px; border-radius: 50%; border: 2px solid var(--ls-black); background: var(--ls-yellow-light); color: var(--ls-black); display: flex; align-items: center; justify-content: center; font-size: 1.75rem; margin: 0 auto 1.25rem auto;">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--ls-black); margin-bottom: 0.5rem;">Ready for Your Mock Interview?</h2>
                    <p style="color: var(--ls-muted); font-size: 0.95rem; max-width: 480px; margin: 0 auto 1.5rem auto;">
                        Select your desired domain, difficulty, and question count on the left, then click <strong>Generate Questions</strong> to start practicing with instant AI evaluation.
                    </p>
                </div>

                <!-- Loading State -->
                <div id="arenaLoadingState" class="ls-card" style="display: none; text-align: center; padding: 4rem 2rem;">
                    <div style="font-size: 2.5rem; color: var(--ls-purple); margin-bottom: 1rem;">
                        <i class="fas fa-spinner fa-spin"></i>
                    </div>
                    <h3 style="font-family: var(--font-heading); font-size: 1.35rem; font-weight: 800; color: var(--ls-black);">Generating Tailored Interview Questions...</h3>
                    <p style="color: var(--ls-muted); font-size: 0.92rem; margin-top: 4px;">Analyzing domain competencies and building real-world evaluation benchmarks.</p>
                </div>

                <!-- Active Question Box -->
                <div id="arenaActiveCard" style="display: none;">
                    <div class="question-header-card">
                        <!-- Progress Bar -->
                        <div class="progress-bar-wrap">
                            <div class="progress-bar-fill" id="progressBarFill" style="width: 20%;"></div>
                        </div>

                        <div class="q-meta-row">
                            <div class="q-badges-group">
                                <span class="badge badge-purple" id="badgeQuestionNumber">Question 1 / 5</span>
                                <span class="badge badge-blue" id="badgeDifficulty">Intermediate</span>
                                <span class="badge badge-outline" id="badgeDomain">Full-Stack Development</span>
                            </div>
                            <button type="button" class="btn btn-outline btn-sm" onclick="saveInterviewSession()">
                                <i class="fas fa-bookmark"></i> Save Session
                            </button>
                        </div>

                        <div class="q-text" id="questionText">Loading question...</div>

                        <div class="q-context-hint" id="questionContextHint">
                            <i class="fas fa-lightbulb" style="color: var(--ls-yellow); font-size: 1.1rem; flex-shrink: 0;"></i>
                            <span id="questionTipText">Structure your response using the STAR method: Situation, Task, Action, Result.</span>
                        </div>

                        <div class="q-nav-actions">
                            <button type="button" class="btn btn-outline btn-sm" id="btnPrevQ" onclick="navigateQuestion(-1)">
                                <i class="fas fa-chevron-left"></i> Previous
                            </button>
                            <span style="font-size: 0.88rem; font-weight: 700; color: var(--ls-muted);" id="qIndicatorText">Question 1 of 5</span>
                            <button type="button" class="btn btn-outline btn-sm" id="btnNextQ" onclick="navigateQuestion(1)">
                                Next <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Answer Workspace Card -->
                    <div class="answer-workspace-card" style="margin-top: 1.5rem;">
                        <div class="ls-card-header">
                            <h3 class="ls-card-title">
                                <i class="fas fa-pen-to-square" style="color: var(--ls-purple);"></i> Your Response
                            </h3>
                            <span style="font-size: 0.82rem; font-weight: 700; color: var(--ls-muted);" id="wordCountLabel">0 words</span>
                        </div>

                        <!-- Audio Dictation Bar -->
                        <div class="audio-recorder-bar">
                            <button type="button" class="record-btn" id="btnRecordToggle" onclick="toggleAudioRecording()" title="Speak your answer">
                                <i class="fas fa-microphone" id="micIcon"></i>
                            </button>
                            <span style="font-size: 0.88rem; font-weight: 700; color: var(--ls-black);" id="speechStatusText">
                                Click mic to speak your answer, or type below.
                            </span>
                        </div>

                        <textarea 
                            id="answerTextarea" 
                            class="form-control" 
                            rows="6" 
                            placeholder="Type your structured answer here, addressing the technical concepts or real-world experience..."
                            oninput="handleAnswerInput(this.value)"
                        ></textarea>

                        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 1.25rem;">
                            <button type="button" class="btn btn-outline" onclick="clearAnswer()">Clear</button>
                            <button type="button" class="btn btn-purple" id="btnSubmitAnswer" onclick="evaluateCurrentAnswer()">
                                <i class="fas fa-brain"></i> Evaluate Answer with AI
                            </button>
                        </div>
                    </div>

                    <!-- AI Evaluation Feedback Card -->
                    <div class="eval-result-card" id="evalResultCard" style="display: none; margin-top: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 14px;">
                            <div>
                                <span class="badge badge-purple" style="margin-bottom: 6px;">AI PERFORMANCE DIAGNOSTIC</span>
                                <h3 style="font-size: 1.35rem; font-weight: 900; color: var(--ls-black);">Response Evaluation</h3>
                            </div>
                            <div class="score-circle-badge">
                                <span style="font-size: 1.5rem; line-height: 1;" id="evalScore">8.5</span>
                                <span style="font-size: 0.65rem; text-transform: uppercase;">out of 10</span>
                            </div>
                        </div>

                        <!-- Strengths -->
                        <div class="feedback-pill-card strengths">
                            <div style="font-weight: 800; font-size: 0.95rem; color: var(--ls-green); margin-bottom: 4px;">
                                <i class="fas fa-circle-check"></i> Key Strengths
                            </div>
                            <div id="evalStrengths" style="font-size: 0.92rem; color: var(--ls-black); line-height: 1.5;"></div>
                        </div>

                        <!-- Areas for Improvement -->
                        <div class="feedback-pill-card weaknesses">
                            <div style="font-weight: 800; font-size: 0.95rem; color: var(--ls-coral); margin-bottom: 4px;">
                                <i class="fas fa-triangle-exclamation"></i> Growth Areas
                            </div>
                            <div id="evalWeaknesses" style="font-size: 0.92rem; color: var(--ls-black); line-height: 1.5;"></div>
                        </div>

                        <!-- Model Benchmark Answer -->
                        <div class="feedback-pill-card model-ans">
                            <div style="font-weight: 800; font-size: 0.95rem; color: var(--ls-blue); margin-bottom: 4px;">
                                <i class="fas fa-lightbulb"></i> Recommended Benchmark Response
                            </div>
                            <div id="evalModelAnswer" style="font-size: 0.92rem; color: var(--ls-black); line-height: 1.5; white-space: pre-wrap;"></div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- History Sessions Modal -->
    <div class="modal-overlay" id="historyModal">
        <div class="modal-box">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 0.75rem; border-bottom: 2px solid var(--ls-black);">
                <h2 style="font-family: var(--font-heading); font-size: 1.4rem; font-weight: 900; color: var(--ls-black);">
                    <i class="fas fa-clock-rotate-left" style="color: var(--ls-purple);"></i> Saved Interview Sessions
                </h2>
                <button type="button" class="btn btn-outline btn-sm" onclick="closeHistoryModal()">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>
            <div id="historyListContainer">
                <p style="text-align: center; color: var(--ls-muted);">Loading saved sessions...</p>
            </div>
        </div>
    </div>

    <!-- Speech Recognition & State Scripts Preserved 100% -->
    <script>
        let generatedQuestions = [];
        let currentQuestionIndex = 0;
        let studentAnswers = {};
        let answerEvaluations = {};
        let currentSessionConfig = {};

        let recognition = null;
        let isRecording = false;

        if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
            const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SpeechRec();
            recognition.continuous = true;
            recognition.interimResults = true;
            recognition.lang = 'en-US';

            recognition.onresult = (event) => {
                let transcript = '';
                for (let i = event.resultIndex; i < event.results.length; ++i) {
                    transcript += event.results[i][0].transcript;
                }
                const textarea = document.getElementById('answerTextarea');
                textarea.value = (textarea.value + ' ' + transcript).trim();
                handleAnswerInput(textarea.value);
            };

            recognition.onerror = () => {
                isRecording = false;
                updateRecordBtnState();
            };

            recognition.onend = () => {
                isRecording = false;
                updateRecordBtnState();
            };
        }

        function toggleAudioRecording() {
            if (!recognition) {
                alert('Speech-to-text recognition is not supported in this browser. Please type your response.');
                return;
            }
            if (isRecording) {
                recognition.stop();
                isRecording = false;
            } else {
                recognition.start();
                isRecording = true;
            }
            updateRecordBtnState();
        }

        function updateRecordBtnState() {
            const btn = document.getElementById('btnRecordToggle');
            const icon = document.getElementById('micIcon');
            const status = document.getElementById('speechStatusText');
            if (isRecording) {
                btn.classList.add('recording');
                icon.className = 'fas fa-stop';
                status.textContent = 'Listening... Speak clearly into your microphone.';
            } else {
                btn.classList.remove('recording');
                icon.className = 'fas fa-microphone';
                status.textContent = 'Click mic to speak your answer, or type below.';
            }
        }

        function toggleCustomDomain(val) {
            document.getElementById('customDomainGroup').style.display = val === 'custom' ? 'block' : 'none';
        }

        function handleAnswerInput(val) {
            studentAnswers[currentQuestionIndex] = val;
            const words = val.trim().length > 0 ? val.trim().split(/\s+/).length : 0;
            document.getElementById('wordCountLabel').textContent = `${words} words`;
        }

        function clearAnswer() {
            document.getElementById('answerTextarea').value = '';
            studentAnswers[currentQuestionIndex] = '';
            document.getElementById('wordCountLabel').textContent = '0 words';
        }

        async function handleGenerate(e) {
            e.preventDefault();
            const domainSelect = document.getElementById('domainSelect').value;
            const domain = domainSelect === 'custom' ? document.getElementById('customDomainInput').value.trim() : domainSelect;
            const difficulty = document.getElementById('difficultySelect').value;
            const type = document.getElementById('typeSelect').value;
            const count = parseInt(document.getElementById('countSelect').value) || 5;
            const context = document.getElementById('contextInput').value.trim();

            currentSessionConfig = { domain, difficulty, interviewType: type, questionCount: count, context };

            document.getElementById('arenaEmptyState').style.display = 'none';
            document.getElementById('arenaActiveCard').style.display = 'none';
            document.getElementById('arenaLoadingState').style.display = 'block';

            try {
                const res = await fetch('/api/interviews/generate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(currentSessionConfig)
                });
                const result = await res.json();
                document.getElementById('arenaLoadingState').style.display = 'none';

                if (result.success && result.questions && result.questions.length > 0) {
                    generatedQuestions = result.questions;
                    currentQuestionIndex = 0;
                    studentAnswers = {};
                    answerEvaluations = {};
                    renderActiveQuestion();
                } else {
                    alert(result.error || 'Could not generate questions. Please try another domain.');
                    document.getElementById('arenaEmptyState').style.display = 'block';
                }
            } catch (err) {
                document.getElementById('arenaLoadingState').style.display = 'none';
                document.getElementById('arenaEmptyState').style.display = 'block';
                alert('Connection error while contacting interview generation service.');
            }
        }

        function renderActiveQuestion() {
            document.getElementById('arenaActiveCard').style.display = 'block';
            const q = generatedQuestions[currentQuestionIndex];
            const total = generatedQuestions.length;

            document.getElementById('badgeQuestionNumber').textContent = `Question ${currentQuestionIndex + 1} / ${total}`;
            document.getElementById('badgeDifficulty').textContent = currentSessionConfig.difficulty || 'Intermediate';
            document.getElementById('badgeDomain').textContent = currentSessionConfig.domain || 'Technical';
            document.getElementById('questionText').textContent = q.question || q;
            document.getElementById('qIndicatorText').textContent = `Question ${currentQuestionIndex + 1} of ${total}`;

            const pct = Math.round(((currentQuestionIndex + 1) / total) * 100);
            document.getElementById('progressBarFill').style.width = `${pct}%`;

            document.getElementById('btnPrevQ').disabled = currentQuestionIndex === 0;
            document.getElementById('btnNextQ').disabled = currentQuestionIndex === total - 1;

            const existingAnswer = studentAnswers[currentQuestionIndex] || '';
            document.getElementById('answerTextarea').value = existingAnswer;
            handleAnswerInput(existingAnswer);

            const existingEval = answerEvaluations[currentQuestionIndex];
            if (existingEval) {
                showEvaluationUI(existingEval);
            } else {
                document.getElementById('evalResultCard').style.display = 'none';
            }
        }

        function navigateQuestion(offset) {
            const nextIdx = currentQuestionIndex + offset;
            if (nextIdx >= 0 && nextIdx < generatedQuestions.length) {
                currentQuestionIndex = nextIdx;
                renderActiveQuestion();
            }
        }

        async function evaluateCurrentAnswer() {
            const currentQ = generatedQuestions[currentQuestionIndex];
            const answer = (studentAnswers[currentQuestionIndex] || '').trim();

            if (!answer) {
                alert('Please provide an answer before submitting for evaluation.');
                return;
            }

            const btn = document.getElementById('btnSubmitAnswer');
            btn.disabled = true;
            btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Analyzing...`;

            try {
                const res = await fetch('/api/interviews/evaluate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        question: currentQ.question || currentQ,
                        domain: currentSessionConfig.domain,
                        difficulty: currentSessionConfig.difficulty,
                        userAnswer: answer
                    })
                });
                const result = await res.json();
                btn.disabled = false;
                btn.innerHTML = `<i class="fas fa-brain"></i> Evaluate Answer with AI`;

                if (result.success && result.feedback) {
                    answerEvaluations[currentQuestionIndex] = result.feedback;
                    showEvaluationUI(result.feedback);
                } else {
                    alert('Evaluation error. Please try again.');
                }
            } catch (err) {
                btn.disabled = false;
                btn.innerHTML = `<i class="fas fa-brain"></i> Evaluate Answer with AI`;
                alert('Connection error while contacting evaluation service.');
            }
        }

        function showEvaluationUI(fb) {
            document.getElementById('evalResultCard').style.display = 'block';
            document.getElementById('evalScore').textContent = fb.score || '8.0';
            document.getElementById('evalStrengths').textContent = fb.strengths || 'Good conceptual grasp and direct response structure.';
            document.getElementById('evalWeaknesses').textContent = fb.weaknesses || 'Could elaborate more on scalability edge cases or performance metrics.';
            document.getElementById('evalModelAnswer').textContent = fb.modelAnswer || 'A structured architectural response.';
        }

        async function saveInterviewSession() {
            if (!generatedQuestions || generatedQuestions.length === 0) return;
            const payload = {
                domain: currentSessionConfig.domain,
                difficulty: currentSessionConfig.difficulty,
                interviewType: currentSessionConfig.interviewType,
                questionCount: generatedQuestions.length,
                context: currentSessionConfig.context,
                questions: generatedQuestions,
                userResponses: Object.keys(studentAnswers).map(idx => ({
                    questionIndex: parseInt(idx),
                    answer: studentAnswers[idx],
                    feedback: answerEvaluations[idx] || null
                }))
            };

            try {
                const res = await fetch('/api/interviews', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                if (result.success) {
                    alert('Interview session saved to your LearnSmart account.');
                }
            } catch (err) {
                alert('Connection error while saving interview session.');
            }
        }

        function showHistoryModal() {
            document.getElementById('historyModal').style.display = 'flex';
            loadHistorySessions();
        }

        function closeHistoryModal() {
            document.getElementById('historyModal').style.display = 'none';
        }

        async function loadHistorySessions() {
            const container = document.getElementById('historyListContainer');
            container.innerHTML = '<p style="text-align: center; color: var(--ls-muted);"><i class="fas fa-spinner fa-spin"></i> Loading saved sessions...</p>';

            try {
                const res = await fetch('/api/interviews');
                const result = await res.json();
                if (result.success && result.data && result.data.length > 0) {
                    container.innerHTML = result.data.map(s => {
                        const dateStr = new Date(s.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                        return `
                            <div class="history-session-card">
                                <div>
                                    <div style="font-weight: 800; color: var(--ls-black); font-size: 1.05rem;">
                                        ${s.domain}
                                    </div>
                                    <div style="font-size: 0.82rem; color: var(--ls-muted); margin-top: 4px; font-weight: 600;">
                                        <span><i class="fas fa-calendar" style="margin-right: 4px;"></i> ${dateStr}</span> &bull;
                                        <span><i class="fas fa-signal" style="margin-right: 4px;"></i> ${s.difficulty}</span> &bull;
                                        <span><i class="fas fa-list" style="margin-right: 4px;"></i> ${s.questionCount} Questions</span>
                                    </div>
                                </div>
                                <div>
                                    <button class="btn btn-purple btn-sm" onclick="loadSessionDetail('${s._id}')">
                                        <i class="fas fa-folder-open"></i> Open
                                    </button>
                                </div>
                            </div>
                        `;
                    }).join('');
                } else {
                    container.innerHTML = '<div style="text-align: center; padding: 2rem;"><i class="fas fa-folder-open" style="font-size: 2rem; color: var(--ls-muted);"></i><p style="margin-top: 8px; color: var(--ls-muted); font-weight: 600;">No saved interview sessions yet.</p></div>';
                }
            } catch (err) {
                container.innerHTML = '<p style="color: var(--ls-coral); text-align: center;">Failed to load saved sessions.</p>';
            }
        }

        async function loadSessionDetail(sessionId) {
            try {
                const res = await fetch(`/api/interviews/${sessionId}`);
                const result = await res.json();
                if (result.success && result.data) {
                    const session = result.data;
                    generatedQuestions = session.questions;
                    currentQuestionIndex = 0;
                    currentSessionConfig = {
                        domain: session.domain,
                        difficulty: session.difficulty,
                        interviewType: session.interviewType,
                        questionCount: session.questionCount,
                        context: session.context
                    };
                    studentAnswers = {};
                    answerEvaluations = {};
                    (session.userResponses || []).forEach(ur => {
                        if (ur.answer) studentAnswers[ur.questionIndex] = ur.answer;
                        if (ur.feedback && ur.feedback.score) answerEvaluations[ur.questionIndex] = ur.feedback;
                    });
                    closeHistoryModal();
                    document.getElementById('arenaEmptyState').style.display = 'none';
                    renderActiveQuestion();
                }
            } catch (err) {
                alert('Failed to load session details.');
            }
        }
    </script>

    <%- include('includes/footer') %>
</body>
</html>
