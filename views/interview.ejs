<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head') %>
    <title>AI Interview Preparation | LearnSmart</title>
    <style>
        .interview-grid {
            display: grid;
            grid-template-columns: 360px 1fr;
            gap: 1.75rem;
            align-items: start;
        }

        @media (max-width: 992px) {
            .interview-grid {
                grid-template-columns: 1fr;
            }
        }

        .config-card {
            background: white;
            border-radius: var(--radius-md);
            padding: 1.75rem;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            position: sticky;
            top: 90px;
        }

        .config-title {
            font-family: var(--font-heading);
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-group-custom {
            margin-bottom: 1.25rem;
        }

        .form-label-custom {
            display: block;
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 6px;
        }

        .form-select-custom, .form-input-custom, .form-textarea-custom {
            width: 100%;
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
            font-family: var(--font-body);
            font-size: 0.92rem;
            color: var(--text-main);
            background: #f8fafc;
            transition: var(--transition-fast);
            outline: none;
        }

        .form-select-custom:focus, .form-input-custom:focus, .form-textarea-custom:focus {
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.15);
        }

        .practice-arena {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .question-header-card {
            background: white;
            border-radius: var(--radius-md);
            padding: 1.75rem;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            position: relative;
        }

        .q-meta-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
            flex-wrap: wrap;
            gap: 10px;
        }

        .q-badges-group {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        .badge-pill-tech {
            background: var(--primary-light);
            color: var(--primary);
            padding: 4px 12px;
            border-radius: var(--radius-full);
            font-size: 0.78rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .badge-pill-diff {
            padding: 4px 12px;
            border-radius: var(--radius-full);
            font-size: 0.78rem;
            font-weight: 700;
        }
        .badge-diff-beginner { background: #ecfdf5; color: #059669; }
        .badge-diff-intermediate { background: #fef3c7; color: #d97706; }
        .badge-diff-advanced { background: #fee2e2; color: #dc2626; }

        .progress-bar-wrap {
            height: 6px;
            background: #e2e8f0;
            border-radius: var(--radius-full);
            overflow: hidden;
            margin-bottom: 1.5rem;
        }

        .progress-bar-fill {
            height: 100%;
            background: var(--gradient-primary);
            border-radius: var(--radius-full);
            transition: width 0.3s ease;
        }

        .question-text-box {
            font-family: var(--font-heading);
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--text-main);
            line-height: 1.45;
            margin-bottom: 1.25rem;
        }

        .coding-details-box {
            background: #0f172a;
            color: #f8fafc;
            padding: 1.25rem;
            border-radius: var(--radius-sm);
            margin-bottom: 1.25rem;
            font-family: 'Consolas', monospace;
            font-size: 0.88rem;
        }

        .coding-details-title {
            color: #38bdf8;
            font-weight: 700;
            margin-bottom: 6px;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .answer-input-area {
            width: 100%;
            min-height: 160px;
            padding: 14px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
            font-family: var(--font-body);
            font-size: 0.95rem;
            line-height: 1.6;
            background: white;
            color: var(--text-main);
            resize: vertical;
            outline: none;
            transition: var(--transition-fast);
        }

        .answer-input-area:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.15);
        }

        .actions-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 1rem;
            flex-wrap: wrap;
            gap: 10px;
        }

        .eval-card {
            background: white;
            border-radius: var(--radius-md);
            padding: 1.75rem;
            border: 1px solid #cbd5e1;
            box-shadow: var(--shadow-md);
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .eval-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.25rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border-color);
        }

        .eval-score-badge {
            font-family: var(--font-heading);
            font-size: 1.4rem;
            font-weight: 800;
            padding: 6px 16px;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .score-excellent { background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; }
        .score-proficient { background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd; }
        .score-developing { background: #fef3c7; color: #d97706; border: 1px solid #fde68a; }
        .score-review { background: #fee2e2; color: #dc2626; border: 1px solid #fecaca; }

        .eval-section {
            margin-bottom: 1.25rem;
        }

        .eval-section-title {
            font-size: 0.9rem;
            font-weight: 700;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .suggested-answer-box {
            background: #f8fafc;
            border-left: 4px solid var(--primary);
            padding: 1.25rem;
            border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
            margin-top: 1rem;
        }

        .nav-questions-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 0;
            flex-wrap: wrap;
            gap: 10px;
        }

        .q-pills-selector {
            display: flex;
            gap: 6px;
            align-items: center;
            flex-wrap: wrap;
        }

        .q-pill-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: white;
            border: 1px solid var(--border-color);
            color: var(--text-main);
            font-weight: 700;
            font-size: 0.88rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition-fast);
        }

        .q-pill-btn.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
            box-shadow: 0 4px 10px rgba(67, 97, 238, 0.3);
        }

        .q-pill-btn.completed {
            border-color: #10b981;
            color: #10b981;
        }

        .history-session-card {
            background: white;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            padding: 1.25rem;
            margin-bottom: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: var(--transition-fast);
        }

        .history-session-card:hover {
            box-shadow: var(--shadow-md);
            border-color: var(--primary);
        }
    </style>
</head>
<body>

    <%- include('includes/navbar', { currentPage: 'interview' }) %>

    <main class="ls-page-wrap">
        <!-- Hero Banner -->
        <header class="ls-hero">
            <div>
                <div class="ls-pill-tag"><i class="fas fa-wand-magic-sparkles"></i> AI Career Suite</div>
                <h1>AI Interview Preparation & Practice</h1>
                <p>Generate targeted interview questions across domains, practice your responses in real time, and receive instant, constructive AI evaluations.</p>
            </div>
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <button onclick="showHistoryModal()" class="btn btn-outline" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.25); color: white;">
                    <i class="fas fa-clock-rotate-left"></i> Saved Sessions
                </button>
                <a href="/quiz" class="btn btn-primary" style="background: white; color: var(--primary) !important;">
                    <i class="fas fa-bolt"></i> Quiz Hub
                </a>
            </div>
        </header>

        <div class="interview-grid">
            <!-- Left Column: Generator Configuration Card -->
            <aside>
                <div class="config-card">
                    <h2 class="config-title">
                        <i class="fas fa-sliders text-primary"></i> Setup Interview
                    </h2>

                    <form id="interviewConfigForm" onsubmit="handleGenerate(event)">
                        <!-- Domain -->
                        <div class="form-group-custom">
                            <label class="form-label-custom" for="domainSelect">
                                <i class="fas fa-layer-group text-primary"></i> Technical Domain
                            </label>
                            <select id="domainSelect" class="form-select-custom" onchange="toggleCustomDomain(this.value)">
                                <option value="Frontend Development">Frontend Development</option>
                                <option value="Backend Development">Backend Development</option>
                                <option value="Full-Stack Development" selected>Full-Stack Development</option>
                                <option value="React JS">React JS</option>
                                <option value="Node.js and Express.js">Node.js & Express.js</option>
                                <option value="MongoDB and SQL">MongoDB & SQL Databases</option>
                                <option value="Java">Java (Core, Spring, JVM)</option>
                                <option value="Python">Python (Core, Django, OOP)</option>
                                <option value="Data Structures and Algorithms">Data Structures & Algorithms</option>
                                <option value="AI and Machine Learning">AI & Machine Learning</option>
                                <option value="HR and Behavioral Interviews">HR & Behavioral Interviews</option>
                                <option value="custom">Custom Specialization...</option>
                            </select>
                        </div>

                        <!-- Custom Domain Input -->
                        <div class="form-group-custom" id="customDomainGroup" style="display: none;">
                            <label class="form-label-custom" for="customDomainInput">
                                Enter Custom Domain / Technology
                            </label>
                            <input type="text" id="customDomainInput" class="form-input-custom" placeholder="e.g. DevOps & Kubernetes, GraphQL, Golang">
                        </div>

                        <!-- Difficulty -->
                        <div class="form-group-custom">
                            <label class="form-label-custom" for="difficultySelect">
                                <i class="fas fa-signal text-primary"></i> Difficulty Level
                            </label>
                            <select id="difficultySelect" class="form-select-custom">
                                <option value="Beginner">Beginner (Entry / Junior)</option>
                                <option value="Intermediate" selected>Intermediate (Mid-Level)</option>
                                <option value="Advanced">Advanced (Senior / Staff)</option>
                            </select>
                        </div>

                        <!-- Interview Type -->
                        <div class="form-group-custom">
                            <label class="form-label-custom" for="typeSelect">
                                <i class="fas fa-briefcase text-primary"></i> Interview Type
                            </label>
                            <select id="typeSelect" class="form-select-custom">
                                <option value="Technical interview" selected>Technical interview</option>
                                <option value="Coding interview">Coding interview</option>
                                <option value="HR interview">HR & Behavioral interview</option>
                                <option value="Project-based interview">Project-based interview</option>
                                <option value="Mixed interview">Mixed interview</option>
                            </select>
                        </div>

                        <!-- Question Count -->
                        <div class="form-group-custom">
                            <label class="form-label-custom" for="countSelect">
                                <i class="fas fa-list-ol text-primary"></i> Number of Questions
                            </label>
                            <select id="countSelect" class="form-select-custom">
                                <option value="5" selected>5 Questions</option>
                                <option value="10">10 Questions</option>
                                <option value="15">15 Questions</option>
                                <option value="20">20 Questions</option>
                            </select>
                        </div>

                        <!-- Optional Context -->
                        <div class="form-group-custom">
                            <label class="form-label-custom" for="contextInput">
                                <i class="fas fa-pen-to-square text-primary"></i> Target Role / Context <span style="font-weight: 400; color: var(--text-muted);">(Optional)</span>
                            </label>
                            <textarea id="contextInput" class="form-textarea-custom" rows="3" placeholder="e.g. SDE-1 position at fintech company, focus on system design, microservices, and concurrency"></textarea>
                        </div>

                        <button type="submit" id="btnGenerate" class="btn btn-primary" style="width: 100%; justify-content: center;">
                            <i class="fas fa-wand-magic-sparkles"></i>
                            <span>Generate Questions</span>
                        </button>
                    </form>
                </div>
            </aside>

            <!-- Right Column: Interactive Practice Arena -->
            <section class="practice-arena">
                <!-- Initial Empty State -->
                <div id="arenaEmptyState" class="empty-state" style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-md);">
                    <div class="empty-state-icon">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <h2 class="empty-state-title">Ready for Your Mock Interview?</h2>
                    <p class="empty-state-desc">Select your desired domain, difficulty, and question count on the left, then click <strong>Generate Questions</strong> to start practicing with instant AI evaluation.</p>
                </div>

                <!-- Loading State -->
                <div id="arenaLoadingState" style="display: none; text-align: center; padding: 4rem 2rem; background: white; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                    <div style="font-size: 2.5rem; color: var(--primary); margin-bottom: 1rem;">
                        <i class="fas fa-spinner fa-spin"></i>
                    </div>
                    <h3 style="font-family: var(--font-heading); color: var(--text-main);">Generating Tailored Interview Questions...</h3>
                    <p style="color: var(--text-muted); font-size: 0.92rem; margin-top: 4px;">Analyzing domain competencies, architecting real-world scenarios, and preparing benchmarks.</p>
                </div>

                <!-- Active Question Box -->
                <div id="arenaActiveCard" style="display: none;">
                    <!-- Question Header & Badges -->
                    <div class="question-header-card">
                        <!-- Progress Bar -->
                        <div class="progress-bar-wrap">
                            <div class="progress-bar-fill" id="progressBarFill" style="width: 20%;"></div>
                        </div>

                        <div class="q-meta-row">
                            <div class="q-badges-group">
                                <span class="badge-pill-tech" id="qDomainBadge">Full-Stack Development</span>
                                <span class="badge-pill-diff badge-diff-intermediate" id="qDiffBadge">Intermediate</span>
                                <span class="badge-pill-tech" id="qTypeBadge" style="background: var(--secondary-light); color: var(--secondary);">Technical</span>
                            </div>
                            <span style="font-weight: 700; color: var(--text-muted); font-size: 0.92rem;" id="qCounterText">
                                Question 1 of 5
                            </span>
                        </div>

                        <h3 class="question-text-box" id="questionText">
                            How does the browser rendering pipeline work?
                        </h3>

                        <!-- Coding Details (if coding question) -->
                        <div id="codingDetailsWrap" class="coding-details-box" style="display: none;">
                            <div class="coding-details-title"><i class="fas fa-code"></i> Constraints & Test Cases</div>
                            <div id="codingConstraintsText" style="margin-bottom: 6px;"></div>
                            <div id="codingTestCasesText"></div>
                        </div>

                        <!-- Practice Answer Input -->
                        <div style="margin-top: 1.25rem;">
                            <label class="form-label-custom" for="studentAnswerInput">
                                <i class="fas fa-keyboard text-primary"></i> Your Answer / Solution
                            </label>
                            <textarea id="studentAnswerInput" class="answer-input-area" placeholder="Type or paste your answer here. Provide your reasoning, architectural explanation, code, or STAR framework..."></textarea>
                        </div>

                        <!-- Action Toolbar -->
                        <div class="actions-toolbar">
                            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                                <button type="button" id="btnEvaluate" class="btn btn-primary" onclick="handleEvaluate()">
                                    <i class="fas fa-brain"></i> Evaluate My Answer
                                </button>
                                <button type="button" id="btnToggleSuggested" class="btn btn-outline" onclick="toggleSuggestedAnswer()">
                                    <i class="fas fa-eye"></i> Suggested Answer
                                </button>
                            </div>
                            <div style="display: flex; gap: 8px;">
                                <button type="button" class="btn btn-outline" onclick="saveCurrentSession()">
                                    <i class="fas fa-bookmark"></i> Save Session
                                </button>
                            </div>
                        </div>

                        <!-- Suggested Answer Accordion Box -->
                        <div id="suggestedAnswerBox" class="suggested-answer-box" style="display: none;">
                            <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--primary); margin-bottom: 6px;">
                                <i class="fas fa-lightbulb"></i> Recommended Answer & Conceptual Breakdown
                            </h4>
                            <p id="suggestedAnswerContent" style="font-size: 0.92rem; line-height: 1.6; margin-bottom: 10px;"></p>
                            
                            <div style="margin-top: 8px;">
                                <strong style="font-size: 0.82rem; color: var(--text-muted); text-transform: uppercase;">Key Concepts Looked For:</strong>
                                <p id="keyConceptsContent" style="font-size: 0.88rem; color: var(--text-main); font-weight: 600; margin-top: 2px;"></p>
                            </div>

                            <div id="followUpsWrap" style="margin-top: 8px; display: none;">
                                <strong style="font-size: 0.82rem; color: var(--text-muted); text-transform: uppercase;">Probable Follow-Up Questions:</strong>
                                <ul id="followUpsList" style="margin: 4px 0 0 1.25rem; font-size: 0.88rem; color: var(--text-main);"></ul>
                            </div>
                        </div>
                    </div>

                    <!-- AI Evaluation Feedback Card -->
                    <div id="evalResultCard" class="eval-card" style="display: none; margin-top: 1.5rem;">
                        <div class="eval-header">
                            <div>
                                <span style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">
                                    AI Evaluator Feedback
                                </span>
                                <h3 style="font-family: var(--font-heading); margin-top: 2px; font-size: 1.25rem;" id="evalRatingText">
                                    Strong Candidate Response
                                </h3>
                            </div>
                            <div class="eval-score-badge score-proficient" id="evalScoreBadge">
                                <i class="fas fa-award"></i> <span id="evalScoreValue">85</span>/100
                            </div>
                        </div>

                        <div class="eval-section">
                            <div class="eval-section-title" style="color: #059669;">
                                <i class="fas fa-circle-check"></i> Key Strengths Demonstrated
                            </div>
                            <p id="evalStrengthsText" style="font-size: 0.92rem; line-height: 1.6; color: var(--text-main);"></p>
                        </div>

                        <div class="eval-section">
                            <div class="eval-section-title" style="color: #d97706;">
                                <i class="fas fa-triangle-exclamation"></i> Concepts Omitted or Areas to Deepen
                            </div>
                            <p id="evalMissingText" style="font-size: 0.92rem; line-height: 1.6; color: var(--text-main);"></p>
                        </div>

                        <div class="eval-section">
                            <div class="eval-section-title" style="color: var(--primary);">
                                <i class="fas fa-arrow-trend-up"></i> Actionable Suggestions for Senior Level
                            </div>
                            <p id="evalSuggestionsText" style="font-size: 0.92rem; line-height: 1.6; color: var(--text-main);"></p>
                        </div>

                        <div style="font-size: 0.78rem; color: var(--text-muted); text-align: right; margin-top: 8px;">
                            * Simulated AI evaluation based on industry benchmarks. Not a hiring guarantee.
                        </div>
                    </div>

                    <!-- Question Navigation Footer -->
                    <div class="nav-questions-row">
                        <button type="button" id="btnPrev" class="btn btn-outline" onclick="goToQuestion(currentQuestionIndex - 1)">
                            <i class="fas fa-arrow-left"></i> Previous
                        </button>

                        <div class="q-pills-selector" id="qPillsSelector">
                            <!-- Injected dynamically -->
                        </div>

                        <button type="button" id="btnNext" class="btn btn-primary" onclick="goToQuestion(currentQuestionIndex + 1)">
                            Next <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- Past Sessions Modal -->
    <div id="historyModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 2000; align-items: center; justify-content: center; padding: 20px;">
        <div style="background: white; border-radius: var(--radius-md); max-width: 680px; width: 100%; max-height: 85vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: var(--shadow-xl);">
            <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                <h3 style="font-family: var(--font-heading); margin: 0; font-size: 1.25rem;">
                    <i class="fas fa-clock-rotate-left text-primary"></i> Saved Interview Sessions
                </h3>
                <button onclick="closeHistoryModal()" style="background: none; border: none; font-size: 1.25rem; cursor: pointer; color: var(--text-muted);">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>
            <div style="padding: 1.5rem; overflow-y: auto; flex: 1;" id="historyListContainer">
                <p style="text-align: center; color: var(--text-muted);">Loading past sessions...</p>
            </div>
        </div>
    </div>

    <%- include('includes/footer') %>

    <script>
        // State management
        let generatedQuestions = [];
        let currentQuestionIndex = 0;
        let studentAnswers = {};
        let answerEvaluations = {};
        let currentSessionConfig = {};

        function toggleCustomDomain(val) {
            const group = document.getElementById('customDomainGroup');
            group.style.display = val === 'custom' ? 'block' : 'none';
        }

        async function handleGenerate(e) {
            e.preventDefault();
            const domainSelect = document.getElementById('domainSelect').value;
            const customInput = document.getElementById('customDomainInput').value.trim();
            const domain = domainSelect === 'custom' ? (customInput || 'Software Engineering') : domainSelect;

            const difficulty = document.getElementById('difficultySelect').value;
            const interviewType = document.getElementById('typeSelect').value;
            const questionCount = document.getElementById('countSelect').value;
            const context = document.getElementById('contextInput').value.trim();

            currentSessionConfig = { domain, difficulty, interviewType, questionCount, context };

            // UI state
            document.getElementById('arenaEmptyState').style.display = 'none';
            document.getElementById('arenaActiveCard').style.display = 'none';
            document.getElementById('arenaLoadingState').style.display = 'block';
            document.getElementById('btnGenerate').disabled = true;

            try {
                const res = await fetch('/api/interviews/generate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(currentSessionConfig)
                });
                const data = await res.json();

                if (data.success && Array.isArray(data.data) && data.data.length > 0) {
                    generatedQuestions = data.data;
                    currentQuestionIndex = 0;
                    studentAnswers = {};
                    answerEvaluations = {};
                    renderActiveQuestion();
                } else {
                    alert(data.error || 'Failed to generate questions. Please try again.');
                    document.getElementById('arenaEmptyState').style.display = 'block';
                }
            } catch (err) {
                console.error('Generation error:', err);
                alert('Connection error while generating interview questions.');
                document.getElementById('arenaEmptyState').style.display = 'block';
            } finally {
                document.getElementById('arenaLoadingState').style.display = 'none';
                document.getElementById('btnGenerate').disabled = false;
            }
        }

        function renderActiveQuestion() {
            if (generatedQuestions.length === 0) return;

            const q = generatedQuestions[currentQuestionIndex];
            document.getElementById('arenaActiveCard').style.display = 'block';

            // Meta badges
            document.getElementById('qDomainBadge').textContent = currentSessionConfig.domain || q.topic;
            const diffEl = document.getElementById('qDiffBadge');
            diffEl.textContent = q.difficulty;
            diffEl.className = `badge-pill-diff badge-diff-${q.difficulty.toLowerCase()}`;
            document.getElementById('qTypeBadge').textContent = currentSessionConfig.interviewType || 'Technical';

            // Counter & progress bar
            document.getElementById('qCounterText').textContent = `Question ${currentQuestionIndex + 1} of ${generatedQuestions.length}`;
            const pct = Math.round(((currentQuestionIndex + 1) / generatedQuestions.length) * 100);
            document.getElementById('progressBarFill').style.width = `${pct}%`;

            // Question text
            document.getElementById('questionText').textContent = q.question;

            // Coding details
            const codingWrap = document.getElementById('codingDetailsWrap');
            if (q.codingDetails && ((q.codingDetails.constraints && q.codingDetails.constraints.length > 0) || (q.codingDetails.testCases && q.codingDetails.testCases.length > 0))) {
                codingWrap.style.display = 'block';
                const constraintsEl = document.getElementById('codingConstraintsText');
                if (q.codingDetails.constraints && q.codingDetails.constraints.length > 0) {
                    constraintsEl.innerHTML = `<strong>Constraints:</strong> ${q.codingDetails.constraints.join(' &bull; ')}`;
                } else {
                    constraintsEl.innerHTML = '';
                }
                const testCasesEl = document.getElementById('codingTestCasesText');
                if (q.codingDetails.testCases && q.codingDetails.testCases.length > 0) {
                    testCasesEl.innerHTML = `<strong>Examples:</strong> ` + q.codingDetails.testCases.map(tc => `Input: <code>${tc.input}</code> &rarr; Output: <code>${tc.output}</code>`).join(' | ');
                } else {
                    testCasesEl.innerHTML = '';
                }
            } else {
                codingWrap.style.display = 'none';
            }

            // Student answer input
            const inputEl = document.getElementById('studentAnswerInput');
            inputEl.value = studentAnswers[currentQuestionIndex] || '';

            // Reset evaluation card or load existing evaluation
            const evalCard = document.getElementById('evalResultCard');
            const evalData = answerEvaluations[currentQuestionIndex];
            if (evalData) {
                renderEvaluation(evalData);
            } else {
                evalCard.style.display = 'none';
            }

            // Hide suggested answer initially
            document.getElementById('suggestedAnswerBox').style.display = 'none';
            document.getElementById('suggestedAnswerContent').textContent = q.suggestedAnswer || '';
            document.getElementById('keyConceptsContent').textContent = q.keyConcepts || 'Key architectural principles and practical trade-offs.';

            const followUpsWrap = document.getElementById('followUpsWrap');
            const followUpsList = document.getElementById('followUpsList');
            if (q.followUpQuestions && q.followUpQuestions.length > 0) {
                followUpsWrap.style.display = 'block';
                followUpsList.innerHTML = q.followUpQuestions.map(f => `<li>${f}</li>`).join('');
            } else {
                followUpsWrap.style.display = 'none';
            }

            // Navigation buttons
            document.getElementById('btnPrev').disabled = currentQuestionIndex === 0;
            document.getElementById('btnNext').textContent = currentQuestionIndex === generatedQuestions.length - 1 ? 'Finish & Review' : 'Next';

            renderPills();
        }

        function renderPills() {
            const selector = document.getElementById('qPillsSelector');
            selector.innerHTML = '';
            generatedQuestions.forEach((_, idx) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `q-pill-btn ${idx === currentQuestionIndex ? 'active' : ''} ${studentAnswers[idx] ? 'completed' : ''}`;
                btn.textContent = idx + 1;
                btn.onclick = () => goToQuestion(idx);
                selector.appendChild(btn);
            });
        }

        function goToQuestion(idx) {
            // Save current typed answer first
            const currentVal = document.getElementById('studentAnswerInput').value;
            studentAnswers[currentQuestionIndex] = currentVal;

            if (idx >= 0 && idx < generatedQuestions.length) {
                currentQuestionIndex = idx;
                renderActiveQuestion();
            } else if (idx >= generatedQuestions.length) {
                showToast('Great practice! Review your answers or click Save Session.', 'success');
            }
        }

        // Live input save
        document.getElementById('studentAnswerInput').addEventListener('input', function() {
            studentAnswers[currentQuestionIndex] = this.value;
            renderPills();
        });

        function toggleSuggestedAnswer() {
            const box = document.getElementById('suggestedAnswerBox');
            box.style.display = box.style.display === 'none' ? 'block' : 'none';
        }

        async function handleEvaluate() {
            const answer = document.getElementById('studentAnswerInput').value.trim();
            if (!answer) {
                alert('Please type your answer or thought process before requesting evaluation.');
                return;
            }

            studentAnswers[currentQuestionIndex] = answer;
            const q = generatedQuestions[currentQuestionIndex];
            const btn = document.getElementById('btnEvaluate');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Evaluating...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/interviews/evaluate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        question: q.question,
                        studentAnswer: answer,
                        domain: currentSessionConfig.domain,
                        difficulty: q.difficulty,
                        interviewType: currentSessionConfig.interviewType,
                        suggestedAnswer: q.suggestedAnswer,
                        keyConcepts: q.keyConcepts
                    })
                });
                const result = await res.json();
                if (result.success && result.data) {
                    answerEvaluations[currentQuestionIndex] = result.data;
                    renderEvaluation(result.data);
                } else {
                    alert(result.error || 'Evaluation failed.');
                }
            } catch (err) {
                console.error('Evaluation error:', err);
                alert('Could not connect to evaluation service.');
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        function renderEvaluation(data) {
            const card = document.getElementById('evalResultCard');
            card.style.display = 'block';

            document.getElementById('evalRatingText').textContent = data.rating || 'Constructive Evaluation';
            document.getElementById('evalScoreValue').textContent = data.score;

            const badge = document.getElementById('evalScoreBadge');
            badge.className = 'eval-score-badge ' + (
                data.score >= 80 ? 'score-excellent' :
                data.score >= 65 ? 'score-proficient' :
                data.score >= 50 ? 'score-developing' : 'score-review'
            );

            document.getElementById('evalStrengthsText').textContent = data.strengths || 'Accurate points covered.';
            document.getElementById('evalMissingText').textContent = data.missingConcepts || 'None identified.';
            document.getElementById('evalSuggestionsText').textContent = data.suggestions || 'Keep practicing!';

            card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        async function saveCurrentSession() {
            if (generatedQuestions.length === 0) return;

            // Save active question answer
            studentAnswers[currentQuestionIndex] = document.getElementById('studentAnswerInput').value;

            const userResponses = generatedQuestions.map((_, idx) => ({
                questionIndex: idx,
                answer: studentAnswers[idx] || '',
                feedback: answerEvaluations[idx] || {}
            }));

            try {
                const res = await fetch('/api/interviews', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        domain: currentSessionConfig.domain,
                        difficulty: currentSessionConfig.difficulty,
                        interviewType: currentSessionConfig.interviewType,
                        questionCount: generatedQuestions.length,
                        context: currentSessionConfig.context,
                        questions: generatedQuestions,
                        userResponses: userResponses
                    })
                });
                const result = await res.json();
                if (result.success) {
                    alert('Interview session saved to your profile successfully!');
                } else {
                    alert(result.error || 'Failed to save session.');
                }
            } catch (err) {
                console.error('Save session error:', err);
                alert('Connection error while saving interview session.');
            }
        }

        function showHistoryModal() {
            const modal = document.getElementById('historyModal');
            modal.style.display = 'flex';
            loadHistorySessions();
        }

        function closeHistoryModal() {
            document.getElementById('historyModal').style.display = 'none';
        }

        async function loadHistorySessions() {
            const container = document.getElementById('historyListContainer');
            container.innerHTML = '<p style="text-align: center; color: var(--text-muted);"><i class="fas fa-spinner fa-spin"></i> Loading saved sessions...</p>';

            try {
                const res = await fetch('/api/interviews');
                const result = await res.json();
                if (result.success && result.data && result.data.length > 0) {
                    container.innerHTML = result.data.map(s => {
                        const dateStr = new Date(s.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                        return `
                            <div class="history-session-card">
                                <div>
                                    <div style="font-weight: 700; color: var(--text-main); font-size: 1.05rem;">
                                        ${s.domain}
                                    </div>
                                    <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">
                                        <span><i class="fas fa-calendar"></i> ${dateStr}</span> &bull;
                                        <span><i class="fas fa-signal"></i> ${s.difficulty}</span> &bull;
                                        <span><i class="fas fa-list"></i> ${s.questionCount} Questions</span>
                                    </div>
                                </div>
                                <div>
                                    <button class="btn btn-primary btn-sm" onclick="loadSessionDetail('${s._id}')">
                                        <i class="fas fa-folder-open"></i> Open
                                    </button>
                                </div>
                            </div>
                        `;
                    }).join('');
                } else {
                    container.innerHTML = '<div style="text-align: center; padding: 2rem;"><i class="fas fa-folder-open" style="font-size: 2rem; color: var(--gray-400);"></i><p style="margin-top: 8px; color: var(--text-muted);">No saved interview sessions yet. Start a session and click "Save Session" to track your progress.</p></div>';
                }
            } catch (err) {
                container.innerHTML = '<p style="color: var(--danger); text-align: center;">Failed to load saved sessions.</p>';
            }
        }

        async function loadSessionDetail(sessionId) {
            try {
                const res = await fetch(`/api/interviews/${sessionId}`);
                const result = await res.json();
                if (result.success && result.data) {
                    const session = result.data;
                    generatedQuestions = session.questions;
                    currentQuestionIndex = 0;
                    currentSessionConfig = {
                        domain: session.domain,
                        difficulty: session.difficulty,
                        interviewType: session.interviewType,
                        questionCount: session.questionCount,
                        context: session.context
                    };

                    studentAnswers = {};
                    answerEvaluations = {};
                    (session.userResponses || []).forEach(ur => {
                        if (ur.answer) studentAnswers[ur.questionIndex] = ur.answer;
                        if (ur.feedback && ur.feedback.score) answerEvaluations[ur.questionIndex] = ur.feedback;
                    });

                    closeHistoryModal();
                    document.getElementById('arenaEmptyState').style.display = 'none';
                    renderActiveQuestion();
                }
            } catch (err) {
                alert('Failed to load session details.');
            }
        }
    </script>
</body>
</html>
