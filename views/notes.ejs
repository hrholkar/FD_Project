<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('includes/head') %>
  <title>Your Notes | LearnSmart</title>
</head>
<body>

  <%- include('includes/navbar', { currentPage: 'notes' }) %>

  <main class="ls-page-wrap-narrow">
    <!-- Header Hero Banner -->
    <div class="ls-hero">
      <div>
        <div class="ls-pill-tag"><i class="fas fa-book-bookmark"></i> Study Workspace</div>
        <h1>Personal Study Notes</h1>
        <p>Capture key insights, formulas, code snippets, and revision summaries as you learn.</p>
      </div>
      <div>
        <a href="#newNoteCard" class="btn btn-primary" style="background: white; color: var(--primary) !important;">
          <i class="fas fa-plus"></i> New Note
        </a>
      </div>
    </div>

    <!-- Create Note Card -->
    <div class="ls-card mb-4" id="newNoteCard">
      <div class="ls-card-header">
        <h2 class="ls-card-title">
          <i class="fas fa-pen-fancy text-primary"></i> Create a New Note
        </h2>
        <span class="badge badge-primary"><i class="fas fa-sparkles"></i> Auto-saved to account</span>
      </div>

      <form action="/notes" method="POST">
        <div class="form-group">
          <label class="form-label" for="noteTitle">Note Title</label>
          <input 
            type="text" 
            id="noteTitle"
            name="title" 
            placeholder="e.g. C++ Pointers & Memory Management Key Notes" 
            required 
            class="form-control" 
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="noteContent">Note Content</label>
          <textarea 
            id="noteContent"
            name="content" 
            placeholder="Type your notes, code examples, concepts, or formulas here..." 
            required 
            class="form-control"
            rows="4"
          ></textarea>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 10px;">
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-plus-circle"></i> Save Note
          </button>
        </div>
      </form>
    </div>

    <!-- Notes List Section -->
    <div class="mt-4">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
        <h3 style="font-family: var(--font-heading); font-size: 1.35rem; font-weight: 700; color: var(--text-main);">
          Saved Notes (<%= user.notes ? user.notes.length : 0 %>)
        </h3>
      </div>

      <% if (!user.notes || user.notes.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon">
            <i class="fas fa-book-open"></i>
          </div>
          <h3 class="empty-state-title">No Notes Yet</h3>
          <p class="empty-state-desc">You haven't written any study notes yet. Use the quick form above to jot down key revision takeaways or study summaries.</p>
        </div>
      <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <% user.notes.forEach((note, index) => { %>
            <div class="ls-card" style="padding: 1.5rem;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.75rem;">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <div style="width: 36px; height: 36px; border-radius: 8px; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0;">
                    <i class="fas fa-file-lines"></i>
                  </div>
                  <h4 style="font-family: var(--font-heading); font-size: 1.15rem; font-weight: 700; color: var(--text-main); margin: 0;">
                    <%= note.title %>
                  </h4>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <a href="/notes/edit/<%= index %>" class="btn btn-outline btn-sm" title="Edit Note">
                    <i class="fas fa-pen-to-square"></i> Edit
                  </a>
                  <form action="/notes/delete/<%= index %>" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this note?');">
                    <button type="submit" class="btn btn-outline btn-sm" style="color: var(--danger) !important; border-color: #fecaca;" title="Delete Note">
                      <i class="fas fa-trash-can"></i> Delete
                    </button>
                  </form>
                </div>
              </div>

              <div style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.65; white-space: pre-wrap; padding-left: 46px;">
                <%= note.content %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('includes/footer') %>

</body>
</html>
