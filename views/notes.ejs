<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('includes/head') %>
  <title>My Study Lab: Notes | LearnSmart</title>

  <style>
    .studylab-wrap {
      max-width: 1400px;
      margin: 0 auto;
      padding: 1.75rem 2rem 3.5rem 2rem;
    }

    @media (max-width: 850px) {
      .studylab-wrap {
        padding: 1.25rem 1rem 2.5rem 1rem;
      }
    }

    /* Switcher Pills [Notes] [To-Do] */
    .studylab-tabs {
      display: inline-flex;
      gap: 6px;
      background: #FFFFFF;
      border: 2px solid var(--ls-black);
      border-radius: var(--radius-full);
      padding: 4px;
      box-shadow: none;
      margin-bottom: 1.5rem;
    }

    .studylab-tab {
      padding: 6px 18px;
      font-size: 0.9rem;
      font-weight: 800;
      border-radius: var(--radius-full);
      text-decoration: none;
      color: var(--ls-black);
      transition: var(--transition-fast);
    }

    .studylab-tab.active {
      background: var(--ls-purple);
      color: #FFFFFF;
      box-shadow: none;
    }

    /* Filter Chips */
    .filter-chips-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .filter-chip {
      padding: 6px 14px;
      background: #FFFFFF;
      border: 1.5px solid var(--ls-black);
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--ls-black);
      cursor: pointer;
      box-shadow: none;
      transition: var(--transition-fast);
    }

    .filter-chip:hover {
      border-color: var(--ls-purple);
    }

    .filter-chip.active {
      background: var(--ls-purple);
      color: #FFFFFF;
    }

    /* Note Cards Grid (Matching Reference Image 1) */
    .notes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.5rem;
    }

    .note-card-item {
      background: #FFFFFF;
      border: 2px solid var(--ls-black);
      border-radius: var(--radius-md);
      box-shadow: none;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 220px;
      position: relative;
      transition: var(--transition-fast);
    }

    .note-card-item:hover {
      border-color: var(--ls-purple);
    }

    .bookmark-ribbon {
      position: absolute;
      top: 14px;
      right: 16px;
      font-size: 1.15rem;
    }

    .bookmark-ribbon.purple { color: var(--ls-purple); }
    .bookmark-ribbon.orange { color: var(--ls-orange); }
    .bookmark-ribbon.blue { color: var(--ls-blue); }
    .bookmark-ribbon.green { color: var(--ls-green); }
  </style>
</head>
<body>

  <%- include('includes/navbar', { currentPage: 'notes' }) %>

  <main class="studylab-wrap">
    <!-- Signature Yellow-Grid Hero Banner (Exact Match to Image 1 Bottom-Left: "My Study Lab") -->
    <header class="ls-hero-banner ls-yellow-grid" style="margin-bottom: 2rem;">
      <div class="ls-hero-banner-content">
        <h1 style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 900; color: var(--ls-black); margin-bottom: 4px;">
          My Study Lab
        </h1>
        <p style="font-size: 1.05rem; font-weight: 600; color: #2B2B2B; margin-bottom: 1.25rem;">
          Organize your notes, track your tasks, and keep your learning on point.
        </p>

        <!-- Pill Switcher [Notes] [To-Do] -->
        <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
          <div class="studylab-tabs" style="margin-bottom: 0;">
            <a href="/notes" class="studylab-tab active">Notes</a>
            <a href="/todos" class="studylab-tab">To-Do</a>
          </div>

          <a href="#createNoteCard" class="btn btn-purple btn-sm">
            <i class="fas fa-plus"></i> New Note
          </a>
        </div>
      </div>

      <!-- Graphic Element with Notebook Photo & Purple Sticker (Matching Image 1) -->
      <div class="ls-hero-graphic-wrap" style="position: relative;">
        <!-- Sticker -->
        <div style="position: absolute; top: -14px; right: 0; background: var(--ls-purple); color: #FFFFFF; font-family: var(--font-editorial); font-size: 0.8rem; font-weight: 900; text-transform: uppercase; padding: 4px 10px; border: 2px solid var(--ls-black); border-radius: var(--radius-sm); transform: rotate(3deg); z-index: 3;">
          GOOD IDEAS BETTER RESULTS
        </div>

        <div style="width: 220px; height: 150px; border: 2px solid var(--ls-black); border-radius: var(--radius-md); overflow: hidden; background: #FFFFFF;">
          <img 
            src="https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=400&q=80" 
            alt="Hand writing notes in textbook" 
            style="width: 100%; height: 100%; object-fit: cover;" 
          />
        </div>
      </div>
    </header>

    <!-- Create Note Form Card -->
    <div class="ls-card" id="createNoteCard" style="margin-bottom: 2rem;">
      <div class="ls-card-header">
        <h2 class="ls-card-title">
          <i class="fas fa-pen-fancy" style="color: var(--ls-purple);"></i> Create a New Note
        </h2>
        <span class="badge badge-purple"><i class="fas fa-cloud-arrow-up"></i> Auto-saved to MongoDB</span>
      </div>

      <form action="/notes" method="POST">
        <div class="form-group">
          <label class="form-label" for="noteTitle">Subject or Title</label>
          <input 
            type="text" 
            id="noteTitle" 
            name="title" 
            placeholder="e.g. Data Structures, Operating Systems, Web Development" 
            required 
            class="form-control" 
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="noteContent">Note Content & Key Takeaways</label>
          <textarea 
            id="noteContent" 
            name="content" 
            placeholder="Write revision summaries, formulas, complexity notation, or code bullet points..." 
            required 
            class="form-control" 
            rows="4"
          ></textarea>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 10px;">
          <button type="submit" class="btn btn-purple">
            <i class="fas fa-floppy-disk"></i> Save Note
          </button>
        </div>
      </form>
    </div>

    <!-- Filter Chips & Search Bar Row (Matching Reference Image 1) -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; margin-bottom: 1.5rem;">
      <div class="filter-chips-row" style="margin-bottom: 0;">
        <button class="filter-chip active" onclick="filterNoteCategory('all', this)">All Notes</button>
        <button class="filter-chip" onclick="filterNoteCategory('important', this)">Important</button>
        <button class="filter-chip" onclick="filterNoteCategory('revision', this)">Revision</button>
        <button class="filter-chip" onclick="filterNoteCategory('subjects', this)">Subjects</button>
      </div>

      <div style="width: 280px;">
        <input 
          type="text" 
          id="searchNotesInput" 
          class="form-control" 
          placeholder="Search notes..." 
          style="padding: 6px 12px; font-size: 0.88rem;" 
          onkeyup="filterNotesLive(this.value)" 
        />
      </div>
    </div>

    <!-- Notes Grid (Matching Reference Image 1) -->
    <% if (!user.notes || user.notes.length === 0) { %>
      <div class="ls-card" style="text-align: center; padding: 3.5rem 1.5rem;">
        <div style="width: 60px; height: 60px; border-radius: 50%; border: 2px solid var(--ls-black); background: var(--ls-yellow-light); color: var(--ls-black); display: flex; align-items: center; justify-content: center; font-size: 1.75rem; margin: 0 auto 1rem auto;">
          <i class="fas fa-book-open"></i>
        </div>
        <h3 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.4rem;">No Notes Created Yet</h3>
        <p style="font-size: 0.95rem; color: var(--ls-muted); max-width: 440px; margin: 0 auto 1.5rem auto;">
          Use the form above to jot down key revision takeaways, algorithms, code snippets, or interview formulas.
        </p>
      </div>
    <% } else { %>
      <div class="notes-grid" id="notesGridContainer">
        <% 
          const ribbonColors = ['purple', 'orange', 'blue', 'green'];
          const sampleTags = ['Computer Science', 'Revision', 'Web Dev', 'DBMS', 'Career'];
          user.notes.forEach((note, index) => { 
            const ribbon = ribbonColors[index % ribbonColors.length];
            const tag = sampleTags[index % sampleTags.length];
        %>
          <div class="note-card-item" data-title="<%= note.title.toLowerCase() %>" data-content="<%= note.content.toLowerCase() %>">
            <!-- Bookmark Ribbon Icon -->
            <i class="fas fa-bookmark bookmark-ribbon <%= ribbon %>"></i>

            <div>
              <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--ls-black); margin-bottom: 4px; padding-right: 28px;">
                <%= note.title %>
              </h3>
              <div style="font-size: 0.78rem; font-weight: 700; color: var(--ls-muted); margin-bottom: 1rem;">
                <i class="fas fa-calendar-day" style="margin-right: 4px;"></i> Oct <%= 10 + (index * 3) % 20 %>, 2026
              </div>

              <!-- Note Content (Bullet or text) -->
              <div style="font-size: 0.92rem; color: #333333; line-height: 1.6; white-space: pre-wrap; margin-bottom: 1.25rem;">
                <%= note.content %>
              </div>
            </div>

            <!-- Footer: Tag Pill & Actions -->
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1.5px solid #EBEBEA; padding-top: 10px; margin-top: auto;">
              <span class="badge badge-outline" style="font-size: 0.75rem;">
                <%= tag %>
              </span>

              <div style="display: flex; gap: 6px;">
                <a href="/notes/edit/<%= index %>" class="btn btn-outline btn-sm" title="Edit Note">
                  <i class="fas fa-pen"></i>
                </a>
                <form action="/notes/delete/<%= index %>" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this note?');">
                  <button type="submit" class="btn btn-outline btn-sm" style="color: var(--ls-coral) !important;" title="Delete Note">
                    <i class="fas fa-trash-can"></i>
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>

  <script>
    function filterNotesLive(query) {
      const clean = query.trim().toLowerCase();
      const cards = document.querySelectorAll('.note-card-item');
      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const content = card.getAttribute('data-content') || '';
        card.style.display = (title.includes(clean) || content.includes(clean)) ? 'flex' : 'none';
      });
    }

    function filterNoteCategory(cat, btn) {
      document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
    }
  </script>

  <%- include('includes/footer') %>
</body>
</html>
