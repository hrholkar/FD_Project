<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../includes/head') %>
  <title>Create Free Account | LearnSmart</title>
  <style>
    .signup-page-wrap {
      min-height: calc(100vh - 140px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 1.5rem;
      background-color: var(--ls-bg);
      background-image: 
        linear-gradient(rgba(17, 17, 17, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(17, 17, 17, 0.04) 1px, transparent 1px);
      background-size: 30px 30px;
    }

    .signup-card {
      max-width: 540px;
      width: 100%;
      background: #FFFFFF;
      border: 2px solid var(--ls-black);
      border-radius: var(--radius-lg);
      box-shadow: none;
      padding: 2.5rem 2.25rem;
    }
  </style>
</head>
<body>

  <%- include('../includes/navbar', { currentPage: 'signup' }) %>

  <main class="signup-page-wrap">
    <div class="signup-card">
      <!-- Brand & Header -->
      <div style="text-align: center; margin-bottom: 2rem;">
        <div class="ls-sidebar-brand-mark" style="width: 48px; height: 48px; font-size: 1.45rem; margin: 0 auto 0.85rem auto;">
          <i class="fas fa-brain"></i>
        </div>
        <div class="ls-sticker yellow" style="font-size: 0.75rem; margin-bottom: 8px;">GET STARTED IN MINUTES</div>
        <h1 style="font-size: 1.85rem; font-weight: 900; color: var(--ls-black); margin-bottom: 0.35rem;">
          Join LearnSmart Today
        </h1>
        <p style="font-size: 0.92rem; color: var(--ls-muted); margin: 0;">
          Create your free account to unlock adaptive learning paths and AI quizzes
        </p>
      </div>

      <!-- Signup Form -->
      <form action="/signup" method="post" id="signupForm">
        <div class="form-group">
          <label class="form-label" for="username">
            <i class="fas fa-at" style="color: var(--ls-purple); margin-right: 4px;"></i> Choose Username
          </label>
          <input 
            type="text" 
            name="username" 
            id="username" 
            class="form-control" 
            placeholder="e.g. rohansharma" 
            required 
            autocomplete="username"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="email">
            <i class="fas fa-envelope" style="color: var(--ls-blue); margin-right: 4px;"></i> Email Address
          </label>
          <input 
            type="email" 
            name="email" 
            id="email" 
            class="form-control" 
            placeholder="e.g. rohan.sharma@learnsmart.edu" 
            required 
            autocomplete="email"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="password">
            <i class="fas fa-lock" style="color: var(--ls-coral); margin-right: 4px;"></i> Create Password
          </label>
          <div style="position: relative;">
            <input 
              type="password" 
              name="password" 
              id="password" 
              class="form-control" 
              placeholder="Minimum 6 characters" 
              required 
              autocomplete="new-password"
              style="padding-right: 44px;"
            />
            <button 
              type="button" 
              id="togglePassword" 
              style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--ls-muted); cursor: pointer; font-size: 0.95rem; padding: 4px;"
              aria-label="Toggle password visibility"
            >
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="educationLevel">
            <i class="fas fa-graduation-cap" style="color: var(--ls-green); margin-right: 4px;"></i> Academic Level
          </label>
          <select name="educationLevel" id="educationLevel" class="form-select" required>
            <option value="" disabled selected>Select your current year or class</option>
            <optgroup label="School / Pre-University">
              <option value="Primary (Classes 1-5)">Primary (Classes 1-5)</option>
              <option value="Middle (Classes 6-8)">Middle (Classes 6-8)</option>
              <option value="Secondary (Classes 9-10)">Secondary (Classes 9-10)</option>
              <option value="Higher Secondary (Classes 11-12)">Higher Secondary (Classes 11-12)</option>
            </optgroup>
            <optgroup label="College / University">
              <option value="1st Year">1st Year Undergraduate</option>
              <option value="2nd Year">2nd Year Undergraduate</option>
              <option value="3rd Year • CSE" selected>3rd Year Undergraduate (CSE / IT)</option>
              <option value="4th Year">4th Year Undergraduate</option>
              <option value="Postgraduate">Postgraduate / Masters</option>
            </optgroup>
          </select>
        </div>

        <div style="margin-bottom: 1.5rem; font-size: 0.88rem;">
          <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer; color: var(--ls-muted);">
            <input type="checkbox" id="termsCheck" required style="margin-top: 3px; width: 16px; height: 16px; accent-color: var(--ls-purple);" />
            <span>I agree to the LearnSmart platform guidelines, academic honor code, and privacy policy.</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; font-size: 1.05rem;">
          <i class="fas fa-user-plus"></i>
          <span>Create Free Account</span>
        </button>
      </form>

      <div style="text-align: center; margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid #EBEBEA; font-size: 0.92rem; color: var(--ls-muted); font-weight: 600;">
        Already have an account? 
        <a href="/login" style="font-weight: 800; color: var(--ls-purple);">Sign in here</a>
      </div>
    </div>
  </main>

  <%- include('../includes/footer', { currentPage: 'signup' }) %>

  <script>
    const toggleBtn = document.getElementById('togglePassword');
    const pwdInput = document.getElementById('password');
    if (toggleBtn && pwdInput) {
      toggleBtn.addEventListener('click', function() {
        const isPassword = pwdInput.type === 'password';
        pwdInput.type = isPassword ? 'text' : 'password';
        const icon = toggleBtn.querySelector('i');
        if (icon) {
          icon.className = isPassword ? 'fas fa-eye-slash' : 'fas fa-eye';
        }
      });
    }
  </script>

</body>
</html>
