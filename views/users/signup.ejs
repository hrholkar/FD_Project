<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../includes/head') %>
  <title>Sign Up | LearnSmart</title>
</head>
<body>

  <%- include('../includes/navbar', { currentPage: 'signup' }) %>

  <main class="ls-page-wrap-form">
    <div class="ls-card" style="padding: 2.5rem 2.25rem;">
      <div style="text-align: center; margin-bottom: 2rem;">
        <div class="ls-brand-icon" style="width: 48px; height: 48px; font-size: 1.4rem; margin: 0 auto 1rem auto;">
          <i class="fas fa-brain"></i>
        </div>
        <h1 style="font-family: var(--font-heading); font-size: 1.75rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.35rem;">
          Join LearnSmart Today
        </h1>
        <p style="font-size: 0.92rem; color: var(--text-muted); margin: 0;">
          Create your account to unlock adaptive learning paths and assessments
        </p>
      </div>

      <!-- Signup Form -->
      <form action="/signup" method="post" id="signupForm">
        <div class="form-group">
          <label class="form-label" for="username">
            <i class="fas fa-at text-primary" style="margin-right: 4px;"></i> Choose Username
          </label>
          <input 
            type="text" 
            name="username" 
            id="username" 
            class="form-control" 
            placeholder="e.g. rohansharma" 
            required 
            autocomplete="username"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="email">
            <i class="fas fa-envelope text-primary" style="margin-right: 4px;"></i> Email Address
          </label>
          <input 
            type="email" 
            name="email" 
            id="email" 
            class="form-control" 
            placeholder="e.g. rohan.sharma@learnsmart.edu" 
            required 
            autocomplete="email"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="password">
            <i class="fas fa-lock text-primary" style="margin-right: 4px;"></i> Create Password
          </label>
          <div style="position: relative;">
            <input 
              type="password" 
              name="password" 
              id="password" 
              class="form-control" 
              placeholder="Minimum 6 characters" 
              required 
              autocomplete="new-password"
              style="padding-right: 42px;"
            />
            <button 
              type="button" 
              id="togglePassword" 
              style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 0.95rem; padding: 4px;"
              aria-label="Toggle password visibility"
            >
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="educationLevel">
            <i class="fas fa-graduation-cap text-primary" style="margin-right: 4px;"></i> Academic Level
          </label>
          <select name="educationLevel" id="educationLevel" class="form-select" required>
            <option value="" disabled selected>Select your current year or class</option>
            <optgroup label="School / Pre-University">
              <option value="Primary (Classes 1-5)">Primary (Classes 1-5)</option>
              <option value="Middle (Classes 6-8)">Middle (Classes 6-8)</option>
              <option value="Secondary (Classes 9-10)">Secondary (Classes 9-10)</option>
              <option value="Higher Secondary (Classes 11-12)">Higher Secondary (Classes 11-12)</option>
            </optgroup>
            <optgroup label="College / University">
              <option value="1st Year">1st Year Undergraduate</option>
              <option value="2nd Year">2nd Year Undergraduate</option>
              <option value="3rd Year">3rd Year Undergraduate</option>
              <option value="4th Year">4th Year Undergraduate</option>
              <option value="Postgraduate">Postgraduate / Masters</option>
            </optgroup>
          </select>
        </div>

        <div style="margin-bottom: 1.5rem; font-size: 0.88rem;">
          <label style="display: flex; align-items: flex-start; gap: 8px; cursor: pointer; color: var(--text-muted);">
            <input type="checkbox" id="termsCheck" required style="margin-top: 3px; accent-color: var(--primary);" />
            <span>I agree to the LearnSmart platform guidelines, terms of service, and privacy policy.</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 11px; font-size: 1rem;">
          <i class="fas fa-user-plus"></i> Create Free Account
        </button>
      </form>

      <div style="text-align: center; margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color); font-size: 0.92rem; color: var(--text-muted);">
        Already have an account? 
        <a href="/login" style="font-weight: 700; color: var(--primary);">Login here</a>
      </div>
    </div>
  </main>

  <%- include('../includes/footer') %>

  <script>
    const toggleBtn = document.getElementById('togglePassword');
    const pwdInput = document.getElementById('password');
    if (toggleBtn && pwdInput) {
      toggleBtn.addEventListener('click', function() {
        const isPassword = pwdInput.type === 'password';
        pwdInput.type = isPassword ? 'text' : 'password';
        const icon = toggleBtn.querySelector('i');
        if (icon) {
          icon.className = isPassword ? 'fas fa-eye-slash' : 'fas fa-eye';
        }
      });
    }
  </script>

</body>
</html>