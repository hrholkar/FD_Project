<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head') %>
    <title>Quiz Results | LearnSmart</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        .results-wrap {
            max-width: 960px;
            margin: 0 auto;
            padding: 2rem 1.5rem 4rem 1.5rem;
        }

        .result-card-item {
            background: #FFFFFF;
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-md);
            box-shadow: none;
            padding: 1.25rem 1.5rem;
            margin-bottom: 1rem;
            transition: var(--transition-fast);
        }

        .result-card-item:hover {
            border-color: var(--ls-purple);
        }

        .result-card-item.correct {
            border-left: 6px solid var(--ls-green);
        }

        .result-card-item.incorrect {
            border-left: 6px solid var(--ls-coral);
        }
    </style>
</head>
<body>

    <%- include('includes/navbar', { currentPage: 'quiz' }) %>

    <main class="results-wrap">
        <!-- Signature Yellow-Grid Hero Banner -->
        <header class="ls-hero-banner ls-yellow-grid" style="margin-bottom: 2rem;">
            <div>
                <div class="ls-sticker green" style="font-size: 0.75rem; margin-bottom: 8px;"><%= (typeof isAdminView !== 'undefined' && isAdminView) ? 'ADMINISTRATIVE ATTEMPT REVIEW' : 'ASSESSMENT EVALUATION' %></div>
                <h1 style="font-size: 2.25rem; font-weight: 900; color: var(--ls-black); margin-bottom: 4px;">
                    Quiz Complete: <%= topic %>
                </h1>
                <p style="font-size: 1.05rem; font-weight: 600; color: #2B2B2B;">
                    <% if (typeof isAdminView !== 'undefined' && isAdminView && typeof learner !== 'undefined') { %>
                        Learner <strong><%= learner.username %></strong> scored <strong><%= score %></strong> out of <strong><%= total %></strong> questions on this assessment.
                    <% } else { %>
                        You scored <strong><%= score %></strong> out of <strong><%= total %></strong> questions on this assessment.
                    <% } %>
                </p>
            </div>

            <!-- Visual Donut Chart Score Badge -->
            <div style="position: relative; width: 130px; height: 130px; flex-shrink: 0;">
                <canvas id="scoreChart"></canvas>
                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-family: var(--font-heading); font-size: 1.6rem; font-weight: 900; color: var(--ls-black);">
                    <%= (typeof percentage === 'number' ? percentage : (total > 0 ? Math.round((score / total) * 100) : 0)) %>%
                </div>
            </div>
        </header>

        <!-- 3 KPI Result Metrics Grid -->
        <div class="ls-metric-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 2rem;">
            <div class="ls-metric-card">
                <div class="ls-metric-icon green">
                    <i class="fas fa-check"></i>
                </div>
                <div>
                    <div class="ls-metric-value"><%= score %></div>
                    <div class="ls-metric-label">Correct Answers</div>
                </div>
            </div>

            <div class="ls-metric-card">
                <div class="ls-metric-icon coral">
                    <i class="fas fa-xmark"></i>
                </div>
                <div>
                    <div class="ls-metric-value"><%= total - score %></div>
                    <div class="ls-metric-label">Incorrect Answers</div>
                </div>
            </div>

            <div class="ls-metric-card">
                <div class="ls-metric-icon purple">
                    <i class="fas fa-bullseye"></i>
                </div>
                <div>
                    <div class="ls-metric-value"><%= (typeof percentage === 'number' ? percentage : (total > 0 ? Math.round((score / total) * 100) : 0)) %>%</div>
                    <div class="ls-metric-label">Overall Accuracy</div>
                </div>
            </div>
        </div>

        <!-- Question By Question Diagnostics -->
        <div class="ls-card" style="margin-bottom: 2rem;">
            <div class="ls-card-header">
                <h2 class="ls-card-title">
                    <i class="fas fa-list-check" style="color: var(--ls-purple);"></i> Question Diagnostics
                </h2>
                <span class="badge badge-outline"><%= results.length %> Total Questions</span>
            </div>

            <div style="display: flex; flex-direction: column;">
                <% results.forEach(r => { %>
                    <div class="result-card-item <%= r.isCorrect ? 'correct' : 'incorrect' %>">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 8px;">
                            <div style="font-weight: 800; font-size: 1rem; color: var(--ls-black);">
                                <span style="color: var(--ls-muted); margin-right: 4px;">Q<%= r.questionNumber %>:</span>
                                <%= r.question %>
                            </div>
                            <span class="badge <%= r.isCorrect ? 'badge-green' : 'badge-coral' %>" style="flex-shrink: 0;">
                                <i class="fas <%= r.isCorrect ? 'fa-check' : 'fa-xmark' %>"></i>
                                <%= r.isCorrect ? 'Correct' : 'Incorrect' %>
                            </span>
                        </div>

                        <div style="font-size: 0.9rem; margin-bottom: 4px;">
                            <span style="font-weight: 700; color: var(--ls-black);">Your Answer:</span>
                            <span style="color: <%= r.isCorrect ? 'var(--ls-green)' : 'var(--ls-coral)' %>; font-weight: 700;">
                                <%= r.yourAnswer || 'Unanswered' %>
                            </span>
                        </div>

                        <% if (!r.isCorrect) { %>
                            <div style="font-size: 0.9rem; color: var(--ls-green); font-weight: 700;">
                                <span>Correct Answer:</span> <%= r.correctAnswer %>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        </div>

        <% if (typeof isAdminView !== 'undefined' && isAdminView) { %>
            <!-- Administrative Attempt Review Navigation -->
            <div class="ls-card" style="text-align: center; padding: 2.25rem 2rem; background: var(--ls-yellow-subtle);">
                <div class="ls-sticker purple" style="margin-bottom: 12px;">ADMINISTRATOR REVIEW</div>
                <h2 style="font-size: 1.85rem; font-weight: 900; color: var(--ls-black); margin-bottom: 0.5rem;">
                    Completed Diagnostic Review
                </h2>
                <p style="font-size: 1rem; color: #2B2B2B; font-weight: 500; max-width: 600px; margin: 0 auto 1.5rem auto;">
                    You are reviewing this assessment attempt in administrative mode. All question diagnostics and recorded student choices are displayed above.
                </p>
                <div style="display: inline-flex; gap: 12px; flex-wrap: wrap; justify-content: center;">
                    <a href="<%= (typeof returnUrl !== 'undefined' && returnUrl) ? returnUrl : '/admin/dashboard' %>" class="btn btn-purple btn-lg">
                        <i class="fas fa-arrow-left"></i> Return to Learner Profile
                    </a>
                    <a href="/admin/dashboard" class="btn btn-outline btn-lg">
                        <i class="fas fa-gauge"></i> Admin Dashboard
                    </a>
                </div>
            </div>
        <% } else { %>
            <!-- Next Steps / AI Resource Generation Card -->
            <div class="ls-card" style="text-align: center; padding: 2.5rem 2rem; background: var(--ls-yellow-subtle);">
                <div class="ls-sticker orange" style="margin-bottom: 12px;">CONTINUE LEARNING</div>
                <h2 style="font-size: 1.85rem; font-weight: 900; color: var(--ls-black); margin-bottom: 0.5rem;">
                    Ready for Your Personalized Learning Roadmap?
                </h2>
                <p style="font-size: 1rem; color: #2B2B2B; font-weight: 500; max-width: 600px; margin: 0 auto 1.5rem auto;">
                    Let our AI analyze the concepts you struggled with and generate tailored revision guides, code examples, and study notes.
                </p>

                <form action="/generate-resource" method="POST" id="resourceForm" style="display: inline-flex; gap: 12px; flex-wrap: wrap; justify-content: center;">
                    <input type="hidden" name="topic" value="<%= topic %>">
                    <input type="hidden" name="quizResults" value='<%= JSON.stringify(results) %>'>
                    <button type="submit" class="btn btn-purple btn-lg" id="generateBtn">
                        <i class="fas fa-compass"></i>
                        <span>Generate Learning Roadmap</span>
                    </button>
                    <a href="/quiz" class="btn btn-outline btn-lg">
                        <i class="fas fa-rotate-right"></i> Try Another Quiz
                    </a>
                </form>
            </div>
        <% } %>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const scoreVal = <%= score %>;
            const totalVal = <%= total %>;
            const scorePct = Math.round((scoreVal / totalVal) * 100);
            const remainingPct = 100 - scorePct;

            const ctx = document.getElementById('scoreChart');
            if (ctx) {
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        datasets: [{
                            data: [scorePct, remainingPct],
                            backgroundColor: ['#5B20FF', '#EBEBEA'],
                            borderWidth: 2,
                            borderColor: '#111111'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '75%',
                        plugins: {
                            tooltip: { enabled: false }
                        }
                    }
                });
            }

            const resourceForm = document.getElementById('resourceForm');
            const generateBtn = document.getElementById('generateBtn');
            if (resourceForm && generateBtn) {
                resourceForm.addEventListener('submit', () => {
                    generateBtn.disabled = true;
                    generateBtn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> <span>Analyzing &amp; Generating Roadmap...</span>`;
                });
            }
        });
    </script>

    <%- include('includes/footer') %>
</body>
</html>
