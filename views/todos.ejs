<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('includes/head') %>
  <title>Study To-Do List | LearnSmart</title>
</head>
<body>

  <%- include('includes/navbar', { currentPage: 'todo' }) %>

  <main class="ls-page-wrap-narrow">
    <!-- Hero Banner -->
    <div class="ls-hero">
      <div>
        <div class="ls-pill-tag"><i class="fas fa-list-check"></i> Task Tracker</div>
        <h1>Study Tasks & Milestones</h1>
        <p>Keep track of revision goals, assignment deadlines, and quiz prep milestones.</p>
      </div>
      <div>
        <span class="badge" style="background: rgba(255,255,255,0.15); color: white; padding: 8px 16px; font-size: 0.9rem;">
          <i class="fas fa-check-double"></i> <%= todos.filter(t => t.completed).length %> of <%= todos.length %> Completed
        </span>
      </div>
    </div>

    <!-- Main To-Do Card -->
    <div class="ls-card">
      <div class="ls-card-header">
        <h2 class="ls-card-title">
          <i class="fas fa-calendar-check text-primary"></i> Daily Task List
        </h2>
        <span class="badge badge-primary"><i class="fas fa-clock"></i> In Progress</span>
      </div>

      <!-- Add Task Form -->
      <form action="/todo/add" method="GET" style="display: flex; gap: 10px; margin-bottom: 2rem;">
        <input 
          type="text" 
          name="task" 
          placeholder="What do you need to study or complete next?" 
          required
          class="form-control"
          style="flex: 1;"
        />
        <button type="submit" class="btn btn-primary" style="flex-shrink: 0;">
          <i class="fas fa-plus"></i> Add Task
        </button>
      </form>

      <!-- Task List -->
      <% if (!todos || todos.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon">
            <i class="fas fa-clipboard-check"></i>
          </div>
          <h3 class="empty-state-title">All Caught Up!</h3>
          <p class="empty-state-desc">You don't have any study tasks queued right now. Add a task above to schedule your revision.</p>
        </div>
      <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <% todos.forEach((todo, index) => { %>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem; background: <%= todo.completed ? '#f8fafc' : 'white' %>; border: 1px solid <%= todo.completed ? '#e2e8f0' : '#cbd5e1' %>; border-radius: var(--radius-sm); transition: var(--transition-fast); box-shadow: var(--shadow-xs);">
              <div style="display: flex; align-items: center; gap: 12px; flex: 1;">
                <div style="width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: <%= todo.completed ? 'var(--success-light)' : 'var(--primary-light)' %>; color: <%= todo.completed ? 'var(--success)' : 'var(--primary)' %>; font-size: 0.85rem; flex-shrink: 0;">
                  <i class="fas <%= todo.completed ? 'fa-check' : 'fa-circle-dot' %>"></i>
                </div>
                <span style="font-size: 0.98rem; font-weight: <%= todo.completed ? '400' : '600' %>; color: <%= todo.completed ? 'var(--text-light)' : 'var(--text-main)' %>; text-decoration: <%= todo.completed ? 'line-through' : 'none' %>; word-break: break-word;">
                  <%= todo.task %>
                </span>
              </div>

              <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
                <% if (!todo.completed) { %>
                  <a href="/todo/complete?index=<%= index %>" class="btn btn-outline btn-sm" style="color: var(--success) !important; border-color: #a7f3d0;" title="Mark Complete">
                    <i class="fas fa-check"></i> Done
                  </a>
                <% } else { %>
                  <span class="badge badge-success"><i class="fas fa-check"></i> Completed</span>
                <% } %>
                <a href="/todo/delete?index=<%= index %>" class="btn btn-outline btn-sm" style="color: var(--danger) !important; border-color: #fecaca;" title="Delete Task" onclick="return confirm('Delete this task?');">
                  <i class="fas fa-trash-can"></i>
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>

      <!-- Back Navigation -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
        <a href="/dashboard" class="btn btn-outline btn-sm">
          <i class="fas fa-arrow-left"></i> Return to Dashboard
        </a>
        <a href="/quiz" class="btn btn-primary btn-sm">
          <i class="fas fa-bolt"></i> Practice Quiz
        </a>
      </div>
    </div>
  </main>

  <%- include('includes/footer') %>

</body>
</html>
