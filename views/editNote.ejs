<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('includes/head') %>
  <title>Edit Note | LearnSmart</title>
</head>
<body>

  <%- include('includes/navbar', { currentPage: 'notes' }) %>

  <main class="ls-page-wrap-narrow">
    <div style="margin-bottom: 1.5rem;">
      <a href="/notes" class="btn btn-outline btn-sm">
        <i class="fas fa-arrow-left"></i> Back to Notes
      </a>
    </div>

    <div class="ls-card">
      <div class="ls-card-header">
        <h2 class="ls-card-title">
          <i class="fas fa-pen-to-square text-primary"></i> Edit Study Note
        </h2>
        <span class="badge badge-primary"><i class="fas fa-sync"></i> Editing note #<%= index + 1 %></span>
      </div>

      <form action="/notes/edit/<%= index %>" method="POST">
        <div class="form-group">
          <label class="form-label" for="editNoteTitle">Note Title</label>
          <input 
            type="text" 
            id="editNoteTitle"
            name="title" 
            value="<%= note.title %>" 
            required 
            class="form-control" 
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="editNoteContent">Note Content</label>
          <textarea 
            id="editNoteContent"
            name="content" 
            required 
            class="form-control"
            rows="6"
          ><%= note.content %></textarea>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 1.5rem;">
          <a href="/notes" class="btn btn-outline">Cancel</a>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-floppy-disk"></i> Save Changes
          </button>
        </div>
      </form>
    </div>
  </main>

  <%- include('includes/footer') %>

</body>
</html>
