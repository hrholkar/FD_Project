<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Academic Dashboard | LearnSmart</title>

    <!-- PDF & Rendering Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    
    <!-- Google Fonts & Font Awesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/learnsmart-theme.css">

    <style>
        :root {
            --primary: #4361ee;
            --primary-light: #eef2ff;
            --primary-dark: #3144c9;
            --secondary: #7209b7;
            --secondary-light: #f5f3ff;
            --success: #10b981;
            --success-light: #ecfdf5;
            --warning: #f59e0b;
            --warning-light: #fef3c7;
            --danger: #ef4444;
            --danger-light: #fee2e2;
            --dark: #0f172a;
            --slate-800: #1e293b;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-400: #94a3b8;
            --gray-600: #475569;
            --gray-800: #1e293b;
            --gray-900: #0f172a;
            
            --gradient-primary: linear-gradient(135deg, #4361ee 0%, #7209b7 100%);
            --gradient-success: linear-gradient(135deg, #10b981 0%, #059669 100%);
            --gradient-warning: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            --gradient-danger: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            --gradient-bg: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            
            --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.06);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.05);
            --shadow-lg: 0 12px 24px -4px rgb(0 0 0 / 0.09);
            --shadow-xl: 0 20px 35px -5px rgb(67 97 238 / 0.12);
            
            --radius-sm: 8px;
            --radius-md: 14px;
            --radius-lg: 20px;
            --radius-full: 9999px;
            --font-body: 'Inter', -apple-system, sans-serif;
            --font-heading: 'Outfit', sans-serif;
            --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-body);
            background: var(--gradient-bg);
            color: var(--gray-800);
            line-height: 1.65;
            min-height: 100vh;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
        }

        /* Modern Executive Navbar */
        .navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--gray-200);
            padding: 0.85rem 1.75rem;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: var(--shadow-sm);
        }
        .nav-container {
            max-width: 1240px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--primary);
            font-family: var(--font-heading);
            font-size: 1.35rem;
            font-weight: 800;
        }
        .logo-badge {
            width: 36px;
            height: 36px;
            background: var(--gradient-primary);
            color: white;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            box-shadow: 0 4px 10px rgba(67, 97, 238, 0.3);
        }
        .nav-links {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .nav-link-item {
            text-decoration: none;
            color: var(--gray-600);
            font-weight: 500;
            font-size: 0.92rem;
            padding: 8px 14px;
            border-radius: var(--radius-sm);
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 7px;
        }
        .nav-link-item:hover {
            color: var(--primary);
            background: var(--primary-light);
        }
        .nav-link-item.active {
            color: var(--primary);
            background: var(--primary-light);
            font-weight: 700;
        }
        .nav-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 18px;
            font-size: 0.9rem;
            font-weight: 600;
            border-radius: var(--radius-sm);
            text-decoration: none;
            transition: var(--transition);
            cursor: pointer;
            border: 1px solid transparent;
        }
        .btn-primary {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.25);
        }
        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
        }
        .btn-outline {
            border-color: var(--gray-300);
            color: var(--gray-800);
            background: white;
        }
        .btn-outline:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: var(--primary-light);
        }
        .mobile-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 1.3rem;
            color: var(--gray-800);
            cursor: pointer;
        }

        /* Dashboard Container */
        .dashboard-wrap {
            max-width: 1240px;
            margin: 2rem auto 4rem auto;
            padding: 0 1.5rem;
            width: 100%;
        }

        /* Executive Hero Banner */
        .dashboard-hero {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: white;
            border-radius: var(--radius-lg);
            padding: 2.5rem;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-xl);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.5rem;
        }
        .dashboard-hero::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 260px;
            height: 260px;
            background: radial-gradient(circle, rgba(114, 9, 183, 0.35) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }
        .hero-left {
            position: relative;
            z-index: 2;
            max-width: 700px;
        }
        .hero-user-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.12);
            padding: 5px 14px;
            border-radius: var(--radius-full);
            font-size: 0.82rem;
            font-weight: 600;
            color: #93c5fd;
            margin-bottom: 0.75rem;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }
        .hero-title {
            font-family: var(--font-heading);
            font-size: 2.2rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            line-height: 1.2;
        }
        .hero-subtitle {
            font-size: 1.05rem;
            color: #cbd5e1;
        }
        .hero-actions {
            position: relative;
            z-index: 2;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        /* Real-Time Search & Quick Filter Bar */
        .search-filter-card {
            background: white;
            border-radius: var(--radius-md);
            padding: 1rem 1.5rem;
            border: 1px solid var(--gray-200);
            box-shadow: var(--shadow-sm);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }
        .search-input-wrap {
            position: relative;
            flex: 1;
            min-width: 240px;
        }
        .search-input-wrap i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-400);
        }
        .search-input {
            width: 100%;
            padding: 10px 14px 10px 40px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--gray-300);
            font-size: 0.92rem;
            outline: none;
            transition: var(--transition);
        }
        .search-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.15);
        }
        .quick-topic-pills {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }
        .quick-topic-pills span {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--gray-600);
        }
        .topic-filter-btn {
            background: var(--gray-100);
            border: 1px solid var(--gray-200);
            padding: 6px 14px;
            border-radius: var(--radius-full);
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--gray-800);
            cursor: pointer;
            transition: var(--transition);
        }
        .topic-filter-btn:hover, .topic-filter-btn.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        /* 4-Column Balanced KPI Metrics Grid */
        .stats-grid-4 {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        @media (max-width: 1024px) {
            .stats-grid-4 {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        @media (max-width: 600px) {
            .stats-grid-4 {
                grid-template-columns: 1fr;
            }
        }
        .kpi-card {
            background: white;
            border-radius: var(--radius-md);
            padding: 1.75rem;
            border: 1px solid var(--gray-200);
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: center;
            gap: 1.25rem;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }
        .kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
            border-color: #cbd5e1;
        }
        .kpi-icon-wrap {
            width: 58px;
            height: 58px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            flex-shrink: 0;
        }
        .kpi-blue { background: #eff6ff; color: #3b82f6; }
        .kpi-purple { background: #faf5ff; color: #8b5cf6; }
        .kpi-green { background: #ecfdf5; color: #10b981; }
        .kpi-amber { background: #fffbeb; color: #f59e0b; }

        .kpi-details {
            flex: 1;
        }
        .kpi-value {
            font-family: var(--font-heading);
            font-size: 2rem;
            font-weight: 800;
            color: var(--gray-900);
            line-height: 1.1;
            margin-bottom: 4px;
        }
        .kpi-label {
            font-size: 0.86rem;
            font-weight: 600;
            color: var(--gray-600);
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        /* Analytics Visual Charts Grid */
        .analytics-row {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 1.5rem;
            margin-bottom: 2.5rem;
        }
        @media (max-width: 960px) {
            .analytics-row {
                grid-template-columns: 1fr;
            }
        }
        .chart-box {
            background: white;
            border-radius: var(--radius-md);
            padding: 1.75rem;
            border: 1px solid var(--gray-200);
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
        }
        .box-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.25rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid var(--gray-100);
        }
        .box-title {
            font-family: var(--font-heading);
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--gray-900);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .box-title i {
            color: var(--primary);
        }
        .chart-canvas-wrap {
            position: relative;
            flex: 1;
            min-height: 250px;
        }

        /* Section Heading */
        .section-header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }
        .section-title {
            font-family: var(--font-heading);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--gray-900);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Assessment Cards Feed */
        .quizzes-feed {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.5rem;
            margin-bottom: 3rem;
        }
        .quiz-card {
            background: white;
            border-radius: var(--radius-md);
            border: 1px solid var(--gray-200);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            transition: var(--transition);
        }
        .quiz-card:hover {
            box-shadow: var(--shadow-md);
            border-color: #cbd5e1;
        }
        .quiz-card-head {
            padding: 1.5rem 1.75rem;
            background: #ffffff;
            border-bottom: 1px solid var(--gray-100);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }
        .quiz-subject-wrap {
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .subject-badge-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: var(--primary-light);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }
        .quiz-topic-title {
            font-family: var(--font-heading);
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--gray-900);
            margin-bottom: 4px;
        }
        .quiz-meta-row {
            display: flex;
            align-items: center;
            gap: 16px;
            font-size: 0.85rem;
            color: var(--gray-600);
            flex-wrap: wrap;
        }
        .quiz-meta-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .quiz-score-badge {
            font-family: var(--font-heading);
            font-weight: 800;
            font-size: 1.1rem;
            padding: 6px 16px;
            border-radius: var(--radius-full);
            color: white;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .badge-green { background: var(--gradient-success); }
        .badge-amber { background: var(--gradient-warning); }
        .badge-rose { background: var(--gradient-danger); }

        .quiz-card-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Collapsible Section Toggles */
        .collapsible-bar {
            padding: 1rem 1.75rem;
            background: #f8fafc;
            border-top: 1px solid var(--gray-100);
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            user-select: none;
            transition: background 0.2s;
            font-weight: 600;
            font-size: 0.92rem;
            color: var(--gray-800);
        }
        .collapsible-bar:hover {
            background: #f1f5f9;
        }
        .collapsible-bar i.chevron {
            transition: transform 0.3s ease;
        }
        .collapsible-bar.expanded i.chevron {
            transform: rotate(180deg);
        }

        .collapsible-body {
            display: none;
            padding: 1.5rem 1.75rem;
            background: white;
            border-top: 1px solid var(--gray-200);
        }
        .collapsible-body.show {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        /* Question Review Items */
        .q-review-item {
            padding: 1rem;
            border-radius: var(--radius-sm);
            background: #fafafa;
            border: 1px solid var(--gray-200);
            margin-bottom: 0.75rem;
        }
        .q-review-item:last-child {
            margin-bottom: 0;
        }
        .q-text {
            font-weight: 600;
            margin-bottom: 6px;
            color: var(--gray-900);
        }
        .q-ans-flex {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            font-size: 0.88rem;
        }
        .ans-user.correct { color: #16a34a; font-weight: 600; }
        .ans-user.incorrect { color: #dc2626; font-weight: 600; }
        .ans-correct { color: #15803d; font-weight: 600; }

        /* AI Roadmap Content Box */
        .ai-roadmap-box {
            padding: 1.5rem;
            background: #f8faff;
            border: 1px solid #e0e7ff;
            border-radius: var(--radius-sm);
            line-height: 1.7;
            font-size: 0.93rem;
            color: #334155;
        }
        .ai-roadmap-box h3 {
            font-size: 1.15rem;
            font-weight: 700;
            margin: 1rem 0 0.5rem 0;
            color: var(--gray-900);
        }
        .ai-roadmap-box h3:first-child {
            margin-top: 0;
        }
        .ai-roadmap-box ul {
            padding-left: 1.25rem;
            margin-bottom: 1rem;
        }
        .ai-roadmap-box li {
            margin-bottom: 0.35rem;
        }

        /* Empty State */
        .empty-dashboard-card {
            background: white;
            border-radius: var(--radius-md);
            padding: 4rem 2rem;
            text-align: center;
            border: 1px solid var(--gray-200);
            box-shadow: var(--shadow-sm);
        }
        .empty-icon {
            font-size: 3.5rem;
            color: var(--primary);
            margin-bottom: 1.25rem;
        }
        .empty-title {
            font-family: var(--font-heading);
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        .empty-desc {
            color: var(--gray-600);
            max-width: 540px;
            margin: 0 auto 1.5rem auto;
            font-size: 1rem;
        }

        /* Toast Notification */
        .toast-bubble {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: #1e293b;
            color: white;
            padding: 12px 20px;
            border-radius: var(--radius-sm);
            box-shadow: var(--shadow-xl);
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.9rem;
            font-weight: 500;
            z-index: 9999;
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .toast-bubble.visible {
            transform: translateY(0);
            opacity: 1;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Responsive Mobile Drawer */
        @media (max-width: 860px) {
            .mobile-toggle {
                display: block;
            }
            .nav-links {
                position: absolute;
                top: 100%;
                left: 0;
                width: 100%;
                background: white;
                flex-direction: column;
                padding: 1rem;
                box-shadow: var(--shadow-lg);
                display: none;
                border-bottom: 1px solid var(--gray-200);
            }
            .nav-links.show {
                display: flex;
            }
            .nav-link-item {
                width: 100%;
            }
            .hero-title {
                font-size: 1.75rem;
            }
        }
    </style>
</head>
<body>

    <%- include('includes/navbar', { currentPage: 'dashboard' }) %>

    <!-- Main Dashboard Container -->
    <main class="dashboard-wrap">

        <!-- Executive Hero Welcome Header -->
        <header class="dashboard-hero">
            <div class="hero-left">
                <div class="hero-user-tag">
                    <i class="fas fa-graduation-cap"></i> <%= user.educationLevel || 'Undergraduate Level' %>
                </div>
                <h1 class="hero-title">Welcome back, <%= user.username %> 👋</h1>
                <p class="hero-subtitle">
                    Here is your real-time academic progression, assessment history, and tailored AI learning diagnostics.
                </p>
            </div>
            <div class="hero-actions">
                <a href="/quiz" class="btn btn-primary" style="background: white; color: var(--primary) !important;">
                    <i class="fas fa-bolt"></i> Start Quiz
                </a>
                <button onclick="refreshDashboard()" class="btn btn-outline" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.25); color: white;">
                    <i class="fas fa-arrows-rotate"></i> Refresh
                </button>
            </div>
        </header>

        <% 
            const hasQuizzes = user && user.quizzes && user.quizzes.length > 0;
            let totalQuestions = 0;
            let totalCorrect = 0;
            let maxScore = 0;
            let uniqueTopics = [];

            if (hasQuizzes) {
                user.quizzes.forEach(quiz => {
                    totalQuestions += quiz.results.length;
                    const correctCount = quiz.results.filter(q => q.isCorrect).length;
                    totalCorrect += correctCount;
                    const score = Math.round((correctCount / quiz.results.length) * 100);
                    if (score > maxScore) maxScore = score;
                });
                uniqueTopics = [...new Set(user.quizzes.map(q => q.topic))];
            }
            const overallAccuracy = totalQuestions > 0 ? Math.round((totalCorrect / totalQuestions) * 100) : 0;
        %>

        <% if (hasQuizzes) { %>
            <!-- 4-Column Balanced KPI Metric Cards Grid -->
            <section class="stats-grid-4">
                <!-- Card 1: Overall Accuracy -->
                <div class="kpi-card">
                    <div class="kpi-icon-wrap kpi-blue">
                        <i class="fas fa-bullseye"></i>
                    </div>
                    <div class="kpi-details">
                        <div class="kpi-value"><%= overallAccuracy %>%</div>
                        <div class="kpi-label">Overall Accuracy</div>
                    </div>
                </div>

                <!-- Card 2: Topics Explored -->
                <div class="kpi-card">
                    <div class="kpi-icon-wrap kpi-purple">
                        <i class="fas fa-book"></i>
                    </div>
                    <div class="kpi-details">
                        <div class="kpi-value"><%= uniqueTopics.length %></div>
                        <div class="kpi-label">Topics Explored</div>
                    </div>
                </div>

                <!-- Card 3: Assessments Completed -->
                <div class="kpi-card">
                    <div class="kpi-icon-wrap kpi-green">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div class="kpi-details">
                        <div class="kpi-value"><%= user.quizzes.length %></div>
                        <div class="kpi-label">Quizzes Completed</div>
                    </div>
                </div>

                <!-- Card 4: Top Score -->
                <div class="kpi-card">
                    <div class="kpi-icon-wrap kpi-amber">
                        <i class="fas fa-trophy"></i>
                    </div>
                    <div class="kpi-details">
                        <div class="kpi-value"><%= maxScore %>%</div>
                        <div class="kpi-label">Peak Score Record</div>
                    </div>
                </div>
            </section>

            <!-- Visual Performance Analytics Row (Chart.js) -->
            <section class="analytics-row">
                <!-- Performance Trendline -->
                <div class="chart-box">
                    <div class="box-header">
                        <div class="box-title"><i class="fas fa-wave-square"></i> Score Progression Trajectory</div>
                        <span style="font-size: 0.82rem; color: var(--gray-400); font-weight: 500;">Chronological curve</span>
                    </div>
                    <div class="chart-canvas-wrap">
                        <canvas id="progressionChart"></canvas>
                    </div>
                </div>

                <!-- Topic Mastery Distribution -->
                <div class="chart-box">
                    <div class="box-header">
                        <div class="box-title"><i class="fas fa-pie-chart"></i> Subject Distribution</div>
                    </div>
                    <div class="chart-canvas-wrap">
                        <canvas id="distributionChart"></canvas>
                    </div>
                </div>
            </section>

            <!-- Topic Search & Filter Bar -->
            <div class="search-filter-card">
                <div class="search-input-wrap">
                    <i class="fas fa-search"></i>
                    <input type="text" id="topicSearch" class="search-input" placeholder="Search assessments by topic (e.g., C++, Python)..." onkeyup="filterAssessments(this.value)">
                </div>
                <div class="quick-topic-pills">
                    <span>Quick filter:</span>
                    <button class="topic-filter-btn active" onclick="applyTopicFilter('all', this)">All</button>
                    <% uniqueTopics.forEach(t => { %>
                        <button class="topic-filter-btn" onclick="applyTopicFilter('<%= t %>', this)"><%= t %></button>
                    <% }) %>
                </div>
            </div>

            <!-- Recent Assessments & Diagnostic Feed -->
            <div class="section-header-row">
                <h2 class="section-title"><i class="fas fa-clock-rotate-left"></i> Assessment History & Diagnostics</h2>
                <span style="font-size: 0.88rem; color: var(--gray-600);"><%= user.quizzes.length %> Total Records</span>
            </div>

            <div class="quizzes-feed" id="quizzesFeed">
                <% user.quizzes.slice().reverse().forEach((quiz, index) => { 
                    const reversedIndex = user.quizzes.length - 1 - index;
                    const matchingResource = user.resources.find(r => r.topic === quiz.topic); 
                    
                    const correctCount = quiz.results.filter(q => q.isCorrect).length;
                    const score = Math.round((correctCount / quiz.results.length) * 100);
                    
                    let badgeClass = 'badge-green';
                    if (score < 50) badgeClass = 'badge-rose';
                    else if (score < 75) badgeClass = 'badge-amber';
                %>
                    <article class="quiz-card" id="quiz-card-<%= reversedIndex %>" data-topic="<%= quiz.topic.toLowerCase() %>">
                        <!-- Head -->
                        <div class="quiz-card-head">
                            <div class="quiz-subject-wrap">
                                <div class="subject-badge-icon">
                                    <i class="fas fa-laptop-code"></i>
                                </div>
                                <div>
                                    <h3 class="quiz-topic-title"><%= quiz.topic %></h3>
                                    <div class="quiz-meta-row">
                                        <div class="quiz-meta-item">
                                            <i class="fas fa-calendar"></i>
                                            <span><%= new Date(quiz.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                                        </div>
                                        <div class="quiz-meta-item">
                                            <i class="fas fa-list-check"></i>
                                            <span><%= quiz.results.length %> Questions</span>
                                        </div>
                                        <div class="quiz-meta-item">
                                            <i class="fas fa-circle-check"></i>
                                            <span><%= correctCount %> Correct</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                                <div class="quiz-score-badge <%= badgeClass %>">
                                    <%= score %>%
                                </div>
                                <div class="quiz-card-actions">
                                    <!-- Direct Link to Learning Roadmap -->
                                    <form action="/generate-resource" method="POST" style="margin: 0; display: inline;">
                                        <input type="hidden" name="topic" value="<%= quiz.topic %>">
                                        <input type="hidden" name="quizResults" value='<%= JSON.stringify(quiz.results) %>'>
                                        <button type="submit" class="btn btn-outline" style="font-size: 0.85rem; padding: 6px 12px;">
                                            <i class="fas fa-compass"></i> Study Plan
                                        </button>
                                    </form>

                                    <!-- PDF Export -->
                                    <button class="btn btn-outline export-btn" onclick="exportQuizPDF('<%= reversedIndex %>')" style="font-size: 0.85rem; padding: 6px 12px;">
                                        <i class="fas fa-file-pdf"></i> PDF
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Collapsible 1: Question Breakdown -->
                        <div class="collapsible-bar" onclick="toggleSection('<%= reversedIndex %>', 'questions')">
                            <span><i class="fas fa-list-ol"></i> Question Breakdown (<%= correctCount %>/<%= quiz.results.length %> Correct)</span>
                            <i class="fas fa-chevron-down chevron" id="chev-questions-<%= reversedIndex %>"></i>
                        </div>
                        <div class="collapsible-body" id="body-questions-<%= reversedIndex %>">
                            <% quiz.results.forEach((q, qIndex) => { %>
                                <div class="q-review-item">
                                    <div class="q-text">
                                        <span style="color: var(--primary); margin-right: 6px;">Q<%= qIndex + 1 %>:</span>
                                        <%= q.question || "Diagnostic Question" %>
                                    </div>
                                    <div class="q-ans-flex">
                                        <div class="ans-user <%= q.isCorrect ? 'correct' : 'incorrect' %>">
                                            <i class="fas <%= q.isCorrect ? 'fa-check-circle' : 'fa-times-circle' %>"></i>
                                            Your Answer: <span><%= q.yourAnswer || 'N/A' %></span>
                                        </div>
                                        <% if (!q.isCorrect) { %>
                                            <div class="ans-correct">
                                                <i class="fas fa-check-double"></i>
                                                Correct Answer: <span><%= q.correctAnswer || 'N/A' %></span>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <!-- Collapsible 2: Study Guide Preview -->
                        <% if (matchingResource && matchingResource.content) { %>
                            <div class="collapsible-bar" onclick="toggleSection('<%= reversedIndex %>', 'ai')">
                                <span><i class="fas fa-robot" style="color: var(--primary);"></i> AI Diagnostic Roadmap & Study Recommendations</span>
                                <i class="fas fa-chevron-down chevron" id="chev-ai-<%= reversedIndex %>"></i>
                            </div>
                            <div class="collapsible-body" id="body-ai-<%= reversedIndex %>">
                                <div class="ai-roadmap-box" id="ai-box-<%= reversedIndex %>"></div>
                                <div style="display: none;" id="raw-ai-<%= reversedIndex %>"><%= matchingResource.content %></div>
                            </div>
                        <% } %>
                    </article>
                <% }) %>
            </div>

        <% } else { %>
            <!-- Premium Empty State -->
            <div class="empty-dashboard-card">
                <div class="empty-icon"><i class="fas fa-graduation-cap"></i></div>
                <h2 class="empty-title">Your Learning Journey Starts Here</h2>
                <p class="empty-desc">
                    Complete your first quiz to unlock performance curves, subject mastery analytics, and tailored AI study guides.
                </p>
                <a href="/quiz" class="btn btn-primary" style="padding: 12px 28px; font-size: 1rem;">
                    <i class="fas fa-bolt"></i> Take Your First Quiz
                </a>
            </div>
        <% } %>

    </main>

    <!-- Toast Notification Bubble -->
    <div id="toastBubble" class="toast-bubble">
        <i class="fas fa-info-circle"></i>
        <span id="toastText">Notification</span>
    </div>

    <script>
        // Data payload for charts
        <% if (hasQuizzes) { %>
            const quizLabels = <%- JSON.stringify(user.quizzes.map((q, i) => `${q.topic} (#${i + 1})`)) %>;
            const quizScores = <%- JSON.stringify(user.quizzes.map(q => {
                const correct = q.results.filter(r => r.isCorrect).length;
                return Math.round((correct / q.results.length) * 100);
            })) %>;

            const topicCounts = {};
            <%- JSON.stringify(user.quizzes.map(q => q.topic)) %>.forEach(t => {
                topicCounts[t] = (topicCounts[t] || 0) + 1;
            });
            const topicLabels = Object.keys(topicCounts);
            const topicData = Object.values(topicCounts);
        <% } else { %>
            const quizLabels = [];
            const quizScores = [];
            const topicLabels = [];
            const topicData = [];
        <% } %>

        // Collapsible Accordion Logic
        function toggleSection(index, type) {
            const body = document.getElementById(`body-${type}-${index}`);
            const chev = document.getElementById(`chev-${type}-${index}`);
            if (body && chev) {
                const isOpen = body.classList.contains('show');
                body.classList.toggle('show');
                chev.parentElement.classList.toggle('expanded');
                
                // Parse markdown when expanded
                if (!isOpen && type === 'ai') {
                    const raw = document.getElementById(`raw-ai-${index}`);
                    const target = document.getElementById(`ai-box-${index}`);
                    if (raw && target && window.marked && !target.dataset.parsed) {
                        target.innerHTML = marked.parse(raw.textContent.trim());
                        target.dataset.parsed = 'true';
                    }
                }
            }
        }

        // Live Topic Search Filter
        function filterAssessments(query) {
            const term = (query || '').toLowerCase().trim();
            const cards = document.querySelectorAll('#quizzesFeed .quiz-card');
            cards.forEach(card => {
                const topic = card.getAttribute('data-topic') || '';
                card.style.display = (term === '' || topic.includes(term)) ? '' : 'none';
            });
        }

        function applyTopicFilter(topic, btn) {
            document.querySelectorAll('.topic-filter-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            
            const term = topic === 'all' ? '' : topic.toLowerCase();
            document.getElementById('topicSearch').value = term;
            filterAssessments(term);
        }

        // PDF Exporter
        function exportQuizPDF(quizIndex) {
            showToast('Generating comprehensive PDF report...', 'info');
            const card = document.getElementById(`quiz-card-${quizIndex}`);
            if (!card) return;

            const exportBtn = card.querySelector('.export-btn');
            const originalText = exportBtn.innerHTML;
            exportBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving';
            exportBtn.disabled = true;

            // Temporarily expand all bodies for export
            const bodies = card.querySelectorAll('.collapsible-body');
            bodies.forEach(b => b.classList.add('show'));

            setTimeout(() => {
                html2canvas(card, {
                    scale: 2,
                    useCORS: true,
                    backgroundColor: '#ffffff'
                }).then(canvas => {
                    const { jsPDF } = window.jspdf;
                    const imgData = canvas.toDataURL('image/png');
                    const pdf = new jsPDF('p', 'mm', 'a4');
                    const imgWidth = 210;
                    const pageHeight = 297;
                    const imgHeight = (canvas.height * imgWidth) / canvas.width;
                    
                    pdf.addImage(imgData, 'PNG', 0, 0, imgWidth, imgHeight);
                    pdf.save(`LearnSmart_Report_${quizIndex}.pdf`);

                    exportBtn.innerHTML = originalText;
                    exportBtn.disabled = false;
                    bodies.forEach(b => b.classList.remove('show'));
                    showToast('PDF exported successfully!', 'success');
                }).catch(err => {
                    console.error('PDF error:', err);
                    exportBtn.innerHTML = originalText;
                    exportBtn.disabled = false;
                    bodies.forEach(b => b.classList.remove('show'));
                    showToast('Failed to export PDF.', 'error');
                });
            }, 300);
        }

        function showToast(msg) {
            const toast = document.getElementById('toastBubble');
            const text = document.getElementById('toastText');
            if (toast && text) {
                text.textContent = msg;
                toast.classList.add('visible');
                setTimeout(() => toast.classList.remove('visible'), 3000);
            }
        }

        function refreshDashboard() {
            showToast('Refreshing learning analytics...');
            setTimeout(() => window.location.reload(), 800);
        }

        // Initialize Interactive Analytics Charts
        document.addEventListener('DOMContentLoaded', () => {
            // Mobile Menu Toggle
            const toggle = document.getElementById('mobileToggle');
            const links = document.getElementById('navLinks');
            if (toggle && links) {
                toggle.addEventListener('click', () => links.classList.toggle('show'));
            }

            // Progression Spline Chart
            const progressionCtx = document.getElementById('progressionChart');
            if (progressionCtx && quizScores.length > 0) {
                new Chart(progressionCtx, {
                    type: 'line',
                    data: {
                        labels: quizLabels,
                        datasets: [{
                            label: 'Assessment Score (%)',
                            data: quizScores,
                            borderColor: '#4361ee',
                            backgroundColor: 'rgba(67, 97, 238, 0.08)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.35,
                            pointBackgroundColor: '#ffffff',
                            pointBorderColor: '#4361ee',
                            pointBorderWidth: 3,
                            pointRadius: 6,
                            pointHoverRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#0f172a',
                                titleFont: { family: 'Outfit', size: 13 },
                                bodyFont: { family: 'Inter', size: 12 },
                                padding: 10,
                                cornerRadius: 8,
                                callbacks: {
                                    label: (ctx) => `Score: ${ctx.parsed.y}%`
                                }
                            }
                        },
                        scales: {
                            y: {
                                min: 0,
                                max: 100,
                                ticks: {
                                    stepSize: 20,
                                    callback: (val) => val + '%'
                                },
                                grid: { color: '#f1f5f9' }
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                });
            }

            // Subject Distribution Doughnut Chart
            const distributionCtx = document.getElementById('distributionChart');
            if (distributionCtx && topicLabels.length > 0) {
                new Chart(distributionCtx, {
                    type: 'doughnut',
                    data: {
                        labels: topicLabels,
                        datasets: [{
                            data: topicData,
                            backgroundColor: ['#4361ee', '#7209b7', '#10b981', '#f59e0b', '#06b6d4'],
                            borderWidth: 0,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 12,
                                    font: { family: 'Inter', size: 12 }
                                }
                            }
                        },
                        cutout: '72%'
                    }
                });
            }
        });
    </script>
    <%- include('includes/footer') %>
</body>
</html>