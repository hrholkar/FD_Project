<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head') %>
    <title>Academic Dashboard | LearnSmart</title>

    <!-- PDF & Rendering Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>

    <style>
        .dashboard-content-wrap {
            max-width: 1400px;
            margin: 0 auto;
            padding: 1.75rem 2rem 3.5rem 2rem;
        }

        /* 3-Column Analytics Grid (Matching Reference Image 1) */
        .dash-analytics-grid {
            display: grid;
            grid-template-columns: 1.15fr 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        @media (max-width: 1200px) {
            .dash-analytics-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 850px) {
            .dash-analytics-grid {
                grid-template-columns: 1fr;
            }
            .dashboard-content-wrap {
                padding: 1.25rem 1rem 2.5rem 1rem;
            }
        }

        /* Subject Progress Bar Row */
        .subject-progress-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 1rem;
        }

        .subject-progress-bar-wrap {
            flex: 1;
            height: 10px;
            background: #EBEBEA;
            border: 1.5px solid var(--ls-black);
            border-radius: var(--radius-full);
            overflow: hidden;
        }

        .subject-progress-fill {
            height: 100%;
            border-radius: var(--radius-full);
            transition: width 0.6s ease;
        }

        /* Recent Activity List */
        .activity-list-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid #EFEFEA;
        }

        .activity-list-item:last-child {
            border-bottom: none;
        }

        .activity-icon {
            width: 34px;
            height: 34px;
            border-radius: var(--radius-sm);
            border: 1.5px solid var(--ls-black);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        /* Assessment History Feed Cards */
        .quiz-card {
            background: #FFFFFF;
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-md);
            box-shadow: none;
            padding: 1.35rem 1.5rem;
            margin-bottom: 1.25rem;
            transition: var(--transition-fast);
        }

        .quiz-card:hover {
            border-color: var(--ls-purple);
        }

        .collapsible-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #F8F8F6;
            border: 1.5px solid var(--ls-black);
            border-radius: var(--radius-sm);
            padding: 10px 14px;
            margin-top: 10px;
            cursor: pointer;
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--ls-black);
            transition: var(--transition-fast);
        }

        .collapsible-bar:hover {
            background: #FFFDF0;
        }

        .collapsible-content {
            display: none;
            padding: 1rem 0;
            border-top: 1px dashed #D5D5D0;
            margin-top: 10px;
        }

        .collapsible-content.active {
            display: block;
        }
    </style>
</head>
<body>

    <%- include('includes/navbar', { currentPage: 'dashboard' }) %>

    <main class="dashboard-content-wrap">
        <% 
            const hasQuizzes = user && user.quizzes && user.quizzes.length > 0;
            let totalQuestions = 0;
            let totalCorrect = 0;
            let maxScore = 0;
            let uniqueTopics = [];

            if (hasQuizzes) {
                user.quizzes.forEach(quiz => {
                    totalQuestions += quiz.results.length;
                    const correctCount = quiz.results.filter(q => q.isCorrect).length;
                    totalCorrect += correctCount;
                    const score = Math.round((correctCount / quiz.results.length) * 100);
                    if (score > maxScore) maxScore = score;
                });
                uniqueTopics = [...new Set(user.quizzes.map(q => q.topic))];
            }
            const overallAccuracy = totalQuestions > 0 ? Math.round((totalCorrect / totalQuestions) * 100) : 78;
            const streakCount = user.streak || 12;
            const totalQuizzes = hasQuizzes ? user.quizzes.length : 24;
        %>

        <!-- Signature Yellow-Grid Hero Banner (Exact Match to Reference Image 1 Top-Left) -->
        <header class="ls-hero-banner ls-yellow-grid">
            <div class="ls-hero-banner-content">
                <div class="ls-hero-banner-title">
                    Good Morning, <%= user.username %>!
                    <span style="font-size: 1.75rem; vertical-align: middle;">👋</span>
                </div>
                <p class="ls-hero-banner-sub">
                    Small steps today, big achievements tomorrow.
                </p>
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <span class="ls-hero-doodle-text">
                        <i class="fas fa-chevron-right" style="color: var(--ls-orange);"></i>
                        LEARN &bull; PRACTICE &bull; IMPROVE &bull; GROW
                    </span>
                    <a href="/quiz" class="btn btn-purple btn-sm">
                        <i class="fas fa-plus"></i> New Quiz
                    </a>
                </div>
            </div>

            <!-- Hero Graphic Element with Doodles -->
            <div class="ls-hero-graphic-wrap" style="position: relative;">
                <!-- Mathematical Doodle Stickers -->
                <div style="position: absolute; top: -14px; left: -30px; font-family: var(--font-editorial); font-size: 1.8rem; font-weight: 900; color: var(--ls-black); transform: rotate(-15deg); user-select: none;">
                    &sum;
                </div>
                <div style="position: absolute; top: 12px; left: 10px; font-family: var(--font-editorial); font-size: 1.6rem; font-weight: 900; color: var(--ls-orange); transform: rotate(18deg); user-select: none;">
                    Z
                </div>

                <!-- Smiling Student Photo Cutout (Matching Image 1) -->
                <div style="width: 220px; height: 160px; border: 2px solid var(--ls-black); border-radius: var(--radius-md); overflow: hidden; background: #FFFFFF;">
                    <img 
                        src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80" 
                        alt="Harshada smiling student" 
                        style="width: 100%; height: 100%; object-fit: cover; object-position: top center;" 
                    />
                </div>
            </div>
        </header>

        <!-- 3 Signature Metric Cards (Matching Image 1: Flame, Target, Book) -->
        <section class="ls-metric-grid">
            <!-- Metric 1: Streak -->
            <div class="ls-metric-card">
                <div class="ls-metric-icon orange">
                    <i class="fas fa-fire-flame-curved"></i>
                </div>
                <div>
                    <div class="ls-metric-value"><%= streakCount %></div>
                    <div class="ls-metric-label">Day Streak</div>
                </div>
            </div>

            <!-- Metric 2: Quiz Accuracy -->
            <div class="ls-metric-card">
                <div class="ls-metric-icon green">
                    <i class="fas fa-bullseye"></i>
                </div>
                <div>
                    <div class="ls-metric-value"><%= overallAccuracy %>%</div>
                    <div class="ls-metric-label">Quiz Accuracy</div>
                </div>
            </div>

            <!-- Metric 3: Quizzes Completed -->
            <div class="ls-metric-card">
                <div class="ls-metric-icon purple">
                    <i class="fas fa-book-open"></i>
                </div>
                <div>
                    <div class="ls-metric-value"><%= totalQuizzes %></div>
                    <div class="ls-metric-label">Quizzes Completed</div>
                </div>
            </div>
        </section>

        <!-- 3-Column Visual Analytics Row (Matching Reference Image 1) -->
        <section class="dash-analytics-grid">
            <!-- Column 1: Study Progress Line Chart -->
            <div class="ls-card">
                <div class="ls-card-header">
                    <div class="ls-card-title">
                        <i class="fas fa-chart-line" style="color: var(--ls-blue);"></i> Study Progress
                    </div>
                    <select class="form-select" style="width: auto; padding: 4px 10px; font-size: 0.82rem; font-weight: 700;">
                        <option>This Week</option>
                        <option>This Month</option>
                        <option>All Time</option>
                    </select>
                </div>
                <div style="display: flex; gap: 16px; margin-bottom: 12px; font-size: 0.8rem; font-weight: 700;">
                    <span style="color: var(--ls-purple);"><i class="fas fa-circle" style="font-size: 0.65rem;"></i> Study Time (hrs)</span>
                    <span style="color: var(--ls-orange);"><i class="fas fa-circle" style="font-size: 0.65rem;"></i> Quiz Score (%)</span>
                </div>
                <div style="height: 220px; position: relative;">
                    <canvas id="progressionChart"></canvas>
                </div>
            </div>

            <!-- Column 2: Subject Performance Progress Bars -->
            <div class="ls-card">
                <div class="ls-card-header">
                    <div class="ls-card-title">
                        <i class="fas fa-bars-progress" style="color: var(--ls-purple);"></i> Subject Performance
                    </div>
                    <select class="form-select" style="width: auto; padding: 4px 10px; font-size: 0.82rem; font-weight: 700;">
                        <option>All Subjects</option>
                        <option>Computer Science</option>
                        <option>Core Subjects</option>
                    </select>
                </div>

                <div style="display: flex; flex-direction: column; gap: 12px; padding-top: 4px;">
                    <!-- Data Structures -->
                    <div>
                        <div class="subject-progress-item" style="margin-bottom: 4px;">
                            <span style="font-size: 0.88rem; font-weight: 700; color: var(--ls-black);">
                                <i class="fas fa-code" style="color: var(--ls-purple); margin-right: 6px;"></i> Data Structures
                            </span>
                            <span class="badge badge-purple">92%</span>
                        </div>
                        <div class="subject-progress-bar-wrap">
                            <div class="subject-progress-fill" style="width: 92%; background-color: var(--ls-purple);"></div>
                        </div>
                    </div>

                    <!-- Web Development -->
                    <div>
                        <div class="subject-progress-item" style="margin-bottom: 4px;">
                            <span style="font-size: 0.88rem; font-weight: 700; color: var(--ls-black);">
                                <i class="fas fa-globe" style="color: var(--ls-blue); margin-right: 6px;"></i> Web Development
                            </span>
                            <span class="badge badge-blue">78%</span>
                        </div>
                        <div class="subject-progress-bar-wrap">
                            <div class="subject-progress-fill" style="width: 78%; background-color: var(--ls-blue);"></div>
                        </div>
                    </div>

                    <!-- DBMS -->
                    <div>
                        <div class="subject-progress-item" style="margin-bottom: 4px;">
                            <span style="font-size: 0.88rem; font-weight: 700; color: var(--ls-black);">
                                <i class="fas fa-database" style="color: var(--ls-green); margin-right: 6px;"></i> DBMS
                            </span>
                            <span class="badge badge-green">70%</span>
                        </div>
                        <div class="subject-progress-bar-wrap">
                            <div class="subject-progress-fill" style="width: 70%; background-color: var(--ls-green);"></div>
                        </div>
                    </div>

                    <!-- Operating Systems -->
                    <div>
                        <div class="subject-progress-item" style="margin-bottom: 4px;">
                            <span style="font-size: 0.88rem; font-weight: 700; color: var(--ls-black);">
                                <i class="fas fa-microchip" style="color: var(--ls-orange); margin-right: 6px;"></i> Operating Systems
                            </span>
                            <span class="badge badge-warning">65%</span>
                        </div>
                        <div class="subject-progress-bar-wrap">
                            <div class="subject-progress-fill" style="width: 65%; background-color: var(--ls-orange);"></div>
                        </div>
                    </div>

                    <!-- Computer Networks -->
                    <div>
                        <div class="subject-progress-item" style="margin-bottom: 4px;">
                            <span style="font-size: 0.88rem; font-weight: 700; color: var(--ls-black);">
                                <i class="fas fa-network-wired" style="color: var(--ls-coral); margin-right: 6px;"></i> Computer Networks
                            </span>
                            <span class="badge badge-danger">88%</span>
                        </div>
                        <div class="subject-progress-bar-wrap">
                            <div class="subject-progress-fill" style="width: 88%; background-color: var(--ls-coral);"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Column 3: Recent Activity + Motivational Sticker (Matching Image 1) -->
            <div class="ls-card" style="display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div class="ls-card-header">
                        <div class="ls-card-title">
                            <i class="fas fa-clock-rotate-left" style="color: var(--ls-green);"></i> Recent Activity
                        </div>
                        <a href="/progress" style="font-size: 0.82rem; font-weight: 700; color: var(--ls-purple);">View All</a>
                    </div>

                    <div style="display: flex; flex-direction: column;">
                        <div class="activity-list-item">
                            <div class="activity-icon" style="background: var(--ls-green-light); color: var(--ls-green);">
                                <i class="fas fa-check"></i>
                            </div>
                            <div>
                                <div style="font-size: 0.88rem; font-weight: 700; color: var(--ls-black);">Completed a quiz on Data Structures</div>
                                <div style="font-size: 0.75rem; color: var(--ls-muted); font-weight: 600;">2 hours ago</div>
                            </div>
                        </div>

                        <div class="activity-list-item">
                            <div class="activity-icon" style="background: var(--ls-purple-light); color: var(--ls-purple);">
                                <i class="fas fa-file-lines"></i>
                            </div>
                            <div>
                                <div style="font-size: 0.88rem; font-weight: 700; color: var(--ls-black);">Added a new note on Operating Systems</div>
                                <div style="font-size: 0.75rem; color: var(--ls-muted); font-weight: 600;">5 hours ago</div>
                            </div>
                        </div>

                        <div class="activity-list-item">
                            <div class="activity-icon" style="background: var(--ls-orange-light); color: var(--ls-orange);">
                                <i class="fas fa-user-tie"></i>
                            </div>
                            <div>
                                <div style="font-size: 0.88rem; font-weight: 700; color: var(--ls-black);">Practiced 5 interview questions</div>
                                <div style="font-size: 0.75rem; color: var(--ls-muted); font-weight: 600;">1 day ago</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Green Motivational Quote Sticker (Matching Image 1) -->
                <div class="ls-quote-card" style="margin-top: 1.25rem;">
                    <i class="fas fa-seedling" style="color: var(--ls-green); font-size: 1.5rem; flex-shrink: 0;"></i>
                    <p>
                        &ldquo;Consistent learning today creates a brighter tomorrow.&rdquo;
                    </p>
                </div>
            </div>
        </section>

        <!-- Topic Search & Assessment History -->
        <div class="ls-card" style="margin-bottom: 2rem;">
            <div class="ls-card-header" style="flex-wrap: wrap; gap: 12px;">
                <div>
                    <h2 class="ls-card-title">
                        <i class="fas fa-clock-rotate-left"></i> Assessment History & Diagnostics
                    </h2>
                    <span style="font-size: 0.82rem; color: var(--ls-muted); font-weight: 600;">
                        <%= hasQuizzes ? user.quizzes.length : 0 %> Completed Quizzes Recorded
                    </span>
                </div>

                <!-- Search Input -->
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <input 
                        type="text" 
                        id="topicSearch" 
                        class="form-control" 
                        placeholder="Search assessments by topic (e.g., C++, Python)..." 
                        style="width: 280px; padding: 6px 12px; font-size: 0.85rem;" 
                        onkeyup="filterAssessments(this.value)" 
                    />
                    <a href="/quiz" class="btn btn-purple btn-sm">
                        <i class="fas fa-plus"></i> Practice New Topic
                    </a>
                </div>
            </div>

            <% if (!hasQuizzes) { %>
                <div style="text-align: center; padding: 3rem 1.5rem;">
                    <div style="width: 60px; height: 60px; border-radius: 50%; border: 2px solid var(--ls-black); background: var(--ls-yellow-light); color: var(--ls-black); display: flex; align-items: center; justify-content: center; font-size: 1.75rem; margin: 0 auto 1rem auto;">
                        <i class="fas fa-wand-magic-sparkles"></i>
                    </div>
                    <h3 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.4rem;">No Quizzes Taken Yet</h3>
                    <p style="font-size: 0.95rem; color: var(--ls-muted); max-width: 460px; margin: 0 auto 1.5rem auto;">
                        Select any subject from your syllabus to generate an AI-tailored quiz with instant grading and explanations.
                    </p>
                    <a href="/quiz" class="btn btn-purple">
                        <i class="fas fa-bolt"></i> Generate First Quiz
                    </a>
                </div>
            <% } else { %>
                <div id="quizzesFeed">
                    <% user.quizzes.slice().reverse().forEach((quiz, index) => { 
                        const reversedIndex = user.quizzes.length - 1 - index;
                        const correctCount = quiz.results.filter(q => q.isCorrect).length;
                        const score = Math.round((correctCount / quiz.results.length) * 100);
                        
                        let badgeColorClass = 'badge-green';
                        if (score < 50) badgeColorClass = 'badge-coral';
                        else if (score < 75) badgeColorClass = 'badge-yellow';
                    %>
                        <article class="quiz-card" id="quiz-card-<%= reversedIndex %>" data-topic="<%= quiz.topic.toLowerCase() %>">
                            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
                                <div style="display: flex; align-items: center; gap: 14px;">
                                    <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); border: 1.5px solid var(--ls-black); background: var(--ls-purple-light); color: var(--ls-purple); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
                                        <i class="fas fa-laptop-code"></i>
                                    </div>
                                    <div>
                                        <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--ls-black); margin-bottom: 3px;">
                                            <%= quiz.topic %>
                                        </h3>
                                        <div style="display: flex; gap: 12px; font-size: 0.8rem; color: var(--ls-muted); font-weight: 600; flex-wrap: wrap;">
                                            <span><i class="fas fa-calendar" style="margin-right: 4px;"></i> <%= new Date(quiz.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                                            <span><i class="fas fa-list-check" style="margin-right: 4px;"></i> <%= quiz.results.length %> Questions</span>
                                            <span><i class="fas fa-circle-check" style="color: var(--ls-green); margin-right: 4px;"></i> <%= correctCount %> Correct</span>
                                        </div>
                                    </div>
                                </div>

                                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                                    <span class="badge <%= badgeColorClass %>" style="font-size: 0.95rem; padding: 6px 12px;">
                                        <%= score %>%
                                    </span>
                                    <form action="/generate-resource" method="POST" style="margin: 0; display: inline;">
                                        <input type="hidden" name="topic" value="<%= quiz.topic %>">
                                        <input type="hidden" name="quizResults" value='<%= JSON.stringify(quiz.results) %>'>
                                        <button type="submit" class="btn btn-outline btn-sm">
                                            <i class="fas fa-compass"></i> Study Plan
                                        </button>
                                    </form>
                                    <button class="btn btn-outline btn-sm" onclick="exportQuizPDF('<%= reversedIndex %>')">
                                        <i class="fas fa-file-pdf"></i> PDF
                                    </button>
                                </div>
                            </div>

                            <!-- Question Breakdown Collapsible -->
                            <div class="collapsible-bar" onclick="toggleSection('<%= reversedIndex %>', 'questions')">
                                <span><i class="fas fa-list-ol"></i> Question Breakdown (<%= correctCount %>/<%= quiz.results.length %> Correct)</span>
                                <i class="fas fa-chevron-down" id="arrow-<%= reversedIndex %>-questions"></i>
                            </div>

                            <div class="collapsible-content" id="content-<%= reversedIndex %>-questions">
                                <% quiz.results.forEach((q, qIdx) => { %>
                                    <div style="background: <%= q.isCorrect ? '#FAFFF8' : '#FFF9F8' %>; border: 1.5px solid <%= q.isCorrect ? 'var(--ls-green)' : 'var(--ls-coral)' %>; border-radius: var(--radius-sm); padding: 12px 14px; margin-bottom: 10px;">
                                        <div style="font-weight: 700; font-size: 0.9rem; color: var(--ls-black); margin-bottom: 6px;">
                                            Question <%= qIdx + 1 %>: <%= q.question %>
                                        </div>
                                        <div style="font-size: 0.82rem; margin-bottom: 4px;">
                                            <span style="font-weight: 700;">Your Answer:</span> 
                                            <span style="color: <%= q.isCorrect ? 'var(--ls-green)' : 'var(--ls-coral)' %>; font-weight: 700;">
                                                <%= q.userAnswer || 'None' %>
                                            </span>
                                        </div>
                                        <% if (!q.isCorrect) { %>
                                            <div style="font-size: 0.82rem; color: var(--ls-green); font-weight: 700; margin-bottom: 4px;">
                                                Correct Answer: <%= q.correctAnswer %>
                                            </div>
                                        <% } %>
                                        <% if (q.explanation) { %>
                                            <div style="font-size: 0.8rem; color: var(--ls-muted); margin-top: 6px; padding-top: 6px; border-top: 1px solid #EBEBEA;">
                                                <i class="fas fa-lightbulb" style="color: var(--ls-yellow); margin-right: 4px;"></i> <%= q.explanation %>
                                            </div>
                                        <% } %>
                                    </div>
                                <% }) %>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </main>

    <script>
        // Collapsible sections toggle
        function toggleSection(idx, section) {
            const content = document.getElementById(`content-${idx}-${section}`);
            const arrow = document.getElementById(`arrow-${idx}-${section}`);
            if (content) {
                const isActive = content.classList.toggle('active');
                if (arrow) {
                    arrow.className = isActive ? 'fas fa-chevron-up' : 'fas fa-chevron-down';
                }
            }
        }

        // Live assessment topic search filter
        function filterAssessments(query) {
            const clean = query.trim().toLowerCase();
            const cards = document.querySelectorAll('.quiz-card');
            cards.forEach(card => {
                const topic = card.getAttribute('data-topic') || '';
                card.style.display = topic.includes(clean) ? 'block' : 'none';
            });
        }

        // Export Assessment as PDF
        function exportQuizPDF(index) {
            const card = document.getElementById(`quiz-card-${index}`);
            if (!card) return;
            const originalShadow = card.style.boxShadow;
            card.style.boxShadow = 'none';

            html2canvas(card, { scale: 2 }).then(canvas => {
                const imgData = canvas.toDataURL('image/png');
                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('p', 'mm', 'a4');
                const imgWidth = 190;
                const pageHeight = 295;
                const imgHeight = (canvas.height * imgWidth) / canvas.width;
                let heightLeft = imgHeight;
                let position = 10;

                pdf.addImage(imgData, 'PNG', 10, position, imgWidth, imgHeight);
                pdf.save(`LearnSmart-Quiz-Report-${index + 1}.pdf`);
                card.style.boxShadow = originalShadow;
            });
        }

        // Initialize Study Progress Chart (Vivid Purple & Tangerine Orange Matching Design System)
        document.addEventListener('DOMContentLoaded', () => {
            const canvas = document.getElementById('progressionChart');
            if (!canvas) return;

            const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
            const studyHours = [2.5, 3.8, 3.2, 4.5, 4.0, 5.5, 6.2];
            const quizAccuracy = [65, 72, 70, 84, 78, 88, 92];

            new Chart(canvas, {
                type: 'line',
                data: {
                    labels: days,
                    datasets: [
                        {
                            label: 'Study Time (hrs)',
                            data: studyHours.map(h => h * 15), // Normalized for visual chart
                            borderColor: '#5B20FF',
                            backgroundColor: 'rgba(91, 32, 255, 0.08)',
                            borderWidth: 2.5,
                            tension: 0.35,
                            fill: true,
                            pointBackgroundColor: '#FFFFFF',
                            pointBorderColor: '#5B20FF',
                            pointBorderWidth: 2,
                            pointRadius: 4
                        },
                        {
                            label: 'Quiz Score (%)',
                            data: quizAccuracy,
                            borderColor: '#FF7628',
                            backgroundColor: 'transparent',
                            borderWidth: 2.5,
                            borderDash: [4, 4],
                            tension: 0.35,
                            pointBackgroundColor: '#FFFFFF',
                            pointBorderColor: '#FF7628',
                            pointBorderWidth: 2,
                            pointRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#111111',
                            titleFont: { family: 'Outfit', size: 12 },
                            bodyFont: { family: 'Inter', size: 12 },
                            padding: 8,
                            cornerRadius: 6
                        }
                    },
                    scales: {
                        y: {
                            min: 0,
                            max: 100,
                            ticks: { stepSize: 20 },
                            grid: { color: '#EBEBEA' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        });
    </script>

