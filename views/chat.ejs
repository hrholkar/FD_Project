<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head') %>
    <title>LearnSmart AI Chat Assistant</title>
    <style>
        .chat-wrap {
            max-width: 900px;
            margin: 2rem auto 4rem auto;
            padding: 0 1.5rem;
        }

        .chat-card-panel {
            background: #FFFFFF;
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-lg);
            box-shadow: none;
            padding: 2rem;
            min-height: 480px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .chat-msg {
            display: flex;
            gap: 12px;
            margin-bottom: 1.25rem;
        }

        .chat-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1.5px solid var(--ls-black);
            background: var(--ls-purple);
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        .chat-bubble {
            background: #F8F8F6;
            border: 1.5px solid var(--ls-black);
            border-radius: var(--radius-md);
            padding: 12px 16px;
            font-size: 0.95rem;
            line-height: 1.5;
            color: var(--ls-black);
            max-width: 75%;
            box-shadow: none;
        }

        .chat-msg.user {
            flex-direction: row-reverse;
        }

        .chat-msg.user .chat-avatar {
            background: var(--ls-blue);
        }

        .chat-msg.user .chat-bubble {
            background: var(--ls-purple-light);
            border-color: var(--ls-purple);
        }
    </style>
</head>
<body>

    <%- include('includes/navbar') %>

    <main class="chat-wrap">
        <header class="ls-hero-banner ls-yellow-grid" style="margin-bottom: 2rem;">
            <div>
                <div class="ls-sticker purple" style="font-size: 0.75rem; margin-bottom: 8px;">AI TUTOR</div>
                <h1 style="font-family: var(--font-heading); font-size: 2.25rem; font-weight: 900; color: var(--ls-black); margin-bottom: 4px;">
                    AI Learning Assistant
                </h1>
                <p style="font-size: 1.05rem; font-weight: 600; color: #2B2B2B;">
                    Ask anything about your coursework, debug code, or request concept explanations.
                </p>
            </div>
            <div>
                <a href="/dashboard" class="btn btn-purple">
                    <i class="fas fa-gauge-high"></i> Dashboard
                </a>
            </div>
        </header>

        <div class="chat-card-panel">
            <div id="chatMessages">
                <div class="chat-msg">
                    <div class="chat-avatar"><i class="fas fa-robot"></i></div>
                    <div class="chat-bubble">
                        Hello! I am your LearnSmart AI study tutor. How can I help your learning today? Ask me any conceptual question or paste code you want to debug.
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 10px; margin-top: 1.5rem; border-top: 1.5px solid #EBEBEA; padding-top: 1.25rem;">
                <input 
                    type="text" 
                    id="chatInput" 
                    placeholder="Ask a question about your syllabus..." 
                    class="form-control" 
                    style="flex: 1;"
                    onkeydown="if(event.key === 'Enter') sendChatMessage()"
                />
                <button type="button" class="btn btn-purple" onclick="sendChatMessage()">
                    <i class="fas fa-paper-plane"></i>
                    <span>Send</span>
                </button>
            </div>
        </div>
    </main>

    <%- include('includes/footer') %>

    <script>
        function sendChatMessage() {
            const input = document.getElementById('chatInput');
            const msg = input.value.trim();
            if (!msg) return;

            const container = document.getElementById('chatMessages');
            container.innerHTML += `
                <div class="chat-msg user">
                    <div class="chat-avatar"><i class="fas fa-user"></i></div>
                    <div class="chat-bubble">${msg}</div>
                </div>
            `;
            input.value = '';

            setTimeout(() => {
                container.innerHTML += `
                    <div class="chat-msg">
                        <div class="chat-avatar"><i class="fas fa-robot"></i></div>
                        <div class="chat-bubble">That's an excellent question on ${msg}. Let's break it down into core principles: understand the base data model, identify the time complexity, and implement an idiomatic solution. Practice quizzes on this topic are available under the AI Quiz tab!</div>
                    </div>
                `;
                container.scrollTop = container.scrollHeight;
            }, 600);
        }
    </script>
</body>
</html>
