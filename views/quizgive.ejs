<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head') %>
    <title><%= topic %> Quiz | LearnSmart</title>

    <style>
        .quiz-take-wrap {
            max-width: 900px;
            margin: 0 auto;
            padding: 2rem 1.5rem 4rem 1.5rem;
        }

        /* Progress Stepper */
        .quiz-stepper {
            display: flex;
            gap: 6px;
            margin-bottom: 2rem;
        }

        .quiz-step-bar {
            flex: 1;
            height: 8px;
            background-color: #E2E2DF;
            border: 1px solid var(--ls-black);
            border-radius: var(--radius-full);
            transition: var(--transition-fast);
        }

        .quiz-step-bar.active {
            background-color: var(--ls-purple);
        }

        /* Question Block Card */
        .question-card-block {
            background: #FFFFFF;
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-md);
            box-shadow: none;
            padding: 2rem 2.25rem;
            margin-bottom: 2rem;
            transition: var(--transition-fast);
            position: relative;
        }

        .question-card-block:hover {
            border-color: var(--ls-purple);
        }

        .quiz-option-radio {
            display: none;
        }

        .quiz-option-label {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 18px;
            border: 2px solid var(--ls-black);
            border-radius: var(--radius-sm);
            background: #FFFFFF;
            cursor: pointer;
            box-shadow: none;
            transition: var(--transition-fast);
            margin-bottom: 12px;
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--ls-black);
        }

        .quiz-option-label:hover {
            border-color: var(--ls-purple);
            background-color: #FAFAFA;
        }

        .quiz-option-letter {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1.5px solid var(--ls-black);
            background: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.88rem;
            color: var(--ls-black);
            flex-shrink: 0;
            transition: var(--transition-fast);
        }

        .quiz-option-radio:checked + .quiz-option-label {
            background-color: var(--ls-purple-light);
            border-color: var(--ls-purple);
            box-shadow: none;
        }

        .quiz-option-radio:checked + .quiz-option-label .quiz-option-letter {
            background-color: var(--ls-purple);
            color: #FFFFFF;
            border-color: var(--ls-purple);
        }
    </style>
</head>
<body>

    <%- include('includes/navbar', { currentPage: 'quiz' }) %>

    <main class="quiz-take-wrap">
        <!-- Header Banner with Topic -->
        <header class="ls-hero-banner ls-yellow-grid" style="padding: 1.5rem 2rem; margin-bottom: 1.75rem;">
            <div>
                <div style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: #444444;">
                    Active Assessment
                </div>
                <h1 style="font-size: 2.2rem; font-weight: 900; color: var(--ls-black); margin-bottom: 4px;">
                    <%= topic %>
                </h1>
                <div style="font-size: 0.95rem; font-weight: 700; color: #2B2B2B;">
                    <i class="fas fa-list-check" style="color: var(--ls-purple); margin-right: 6px;"></i>
                    <%= quiz.length %> AI-Curated Questions
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 10px;">
                <span class="badge badge-coral" style="font-size: 0.95rem; padding: 6px 14px;">
                    <i class="fas fa-clock"></i> <span id="timerText">10:00</span>
                </span>
            </div>
        </header>

        <!-- Stepper -->
        <div class="quiz-stepper">
            <% quiz.forEach((q, index) => { %>
                <div class="quiz-step-bar" id="stepBar-<%= index %>"></div>
            <% }) %>
        </div>

        <!-- Quiz Form -->
        <form action="/submit-quiz" method="POST" id="activeQuizForm">
            <% quiz.forEach((qItem, index) => { %>
                <div class="question-card-block" id="questionCard-<%= index %>">
                    <!-- Card Header -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1.5px solid #EBEBEA;">
                        <span style="font-family: var(--font-heading); font-size: 1.15rem; font-weight: 800; color: var(--ls-black);">
                            Question <%= index + 1 %> of <%= quiz.length %>
                        </span>
                        <span class="badge badge-purple" style="font-size: 0.78rem;">Single Choice</span>
                    </div>

                    <!-- Question Text -->
                    <h3 style="font-size: 1.2rem; font-weight: 800; color: var(--ls-black); line-height: 1.45; margin-bottom: 1.5rem;">
                        <%= qItem.question %>
                    </h3>

                    <!-- Option Group -->
                    <div style="display: flex; flex-direction: column;">
                        <% qItem.options.forEach((opt, optIdx) => { %>
                            <div>
                                <input 
                                    type="radio" 
                                    id="q<%= index %>_<%= optIdx %>" 
                                    name="q<%= index %>" 
                                    value="<%= opt %>" 
                                    class="quiz-option-radio" 
                                    required 
                                    onchange="markStepAnswered(<%= index %>)"
                                />
                                <label class="quiz-option-label" for="q<%= index %>_<%= optIdx %>">
                                    <span class="quiz-option-letter"><%= String.fromCharCode(65 + optIdx) %></span>
                                    <span><%= opt %></span>
                                </label>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% }) %>

            <!-- Secure Server-Linked Quiz Attempt Identifier -->
            <input type="hidden" name="attemptId" value="<%= attemptId %>" />

            <!-- Submit Button Card -->
            <div style="text-align: center; margin-top: 2rem;">
                <button type="submit" class="btn btn-purple btn-lg" id="submitQuizBtn" style="padding: 14px 40px; font-size: 1.15rem;">
                    <i class="fas fa-paper-plane"></i>
                    <span>Submit &amp; View Results</span>
                </button>
            </div>
        </form>
    </main>

    <script>
        function markStepAnswered(idx) {
            const bar = document.getElementById(`stepBar-${idx}`);
            if (bar) bar.classList.add('active');
        }

        // Timer Countdown
        let secondsLeft = 600;
        const timerEl = document.getElementById('timerText');
        const interval = setInterval(() => {
            secondsLeft--;
            if (secondsLeft <= 0) {
                clearInterval(interval);
                alert("Time's up! Submitting your answers automatically.");
                document.getElementById('activeQuizForm').submit();
            } else {
                const mins = String(Math.floor(secondsLeft / 60)).padStart(2, '0');
                const secs = String(secondsLeft % 60).padStart(2, '0');
                if (timerEl) timerEl.textContent = `${mins}:${secs}`;
            }
        }, 1000);
    </script>

    <%- include('includes/footer') %>
</body>
</html>
