# Port for the Node.js / Express server (default: 3000)
PORT=3000

# MongoDB Connection String (Atlas or local MongoDB)
# Example Local: mongodb://127.0.0.1:27017/learnsmart
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/learnsmart?retryWrites=true&w=majority
ATLAS_URL=mongodb://127.0.0.1:27017/learnsmart

# Google Gemini Generative AI API Key
# Obtain from: https://aistudio.google.com/app/apikey
api_Key=your_gemini_api_key_here

# Express Session Secret
SESSION_SECRET=learnsmart_super_secret_session_key_2026
